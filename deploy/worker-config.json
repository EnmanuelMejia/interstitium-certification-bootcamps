{
  "_notes": [
    "Pure static-assets deploy (no custom worker module). Asset tree already carries the /bootcamps prefix, so routes <host>/bootcamps/* map directly."
  ],
  "_routes_for_parent": [
    "enmanueldmejia.com/bootcamps/*",
    "interstitiumlabs.dev/bootcamps/*",
    "learn.interstitiumlabs.dev/bootcamps/*"
  ],
  "assets_config": {
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "assets_dir": "site/",
  "compatibility_date": "2026-09-25",
  "worker": "cert-bootcamps"
}