  "simulations": [
    {
      "brief": "A student claims the Emerald Tablet says 'as above, so below' justifies any analogy. Work through the misreading.",
      "debrief": "Correspondence is a disciplined claim about structural analogy, not a license for free association. The principle demands you show the structure, not just assert the likeness.",
      "difficulty": 2,
      "domain_id": "hermetic-principles",
      "id": "her-sim-correspondence",
      "kind": "troubleshoot",
      "points": 14,
      "steps": [
        {
          "correct": 0,
          "evidence": [
            [
              "tablet.txt",
              "As above, so below \u2014 the macrocosm reflected in the microcosm."
            ],
            [
              "essay.txt",
              "Student: 'My coffee cup is like the cosmos, therefore astrology works.'"
            ]
          ],
          "explain": "The student asserts likeness without showing shared structure. Correspondence requires demonstrating the same pattern operating at both scales.",
          "options": [
            "The analogy needs demonstrated shared structure, not bare assertion",
            "Any analogy counts as correspondence",
            "The tablet is about coffee",
            "Reject the principle entirely"
          ],
          "symptom": "'As above, so below' used to justify any analogy."
        },
        {
          "correct": 0,
          "evidence": [
            [
              "commentary.txt",
              "Classical commentators map specific patterns: cycles, polarities, rhythms."
            ]
          ],
          "explain": "The tradition maps concrete patterns \u2014 cycles, polarity, rhythm \u2014 across scales. That specificity is what separates principle from poetry.",
          "options": [
            "Map a specific pattern (cycles, polarity) across the two scales",
            "Keep the analogy vague and mystical",
            "Quote more tablet lines",
            "Change the subject"
          ],
          "symptom": "How should the analogy be disciplened?"
        },
        {
          "correct": 0,
          "evidence": [
            [
              "grade.txt",
              "Revised essay traces feedback loops in ecosystems and markets. Pass."
            ]
          ],
          "explain": "Feedback loops genuinely operate in both ecosystems and markets \u2014 the structure is shared, so the correspondence holds. Precision is the method.",
          "options": [
            "The revised essay demonstrates real shared structure \u2014 that is correspondence done right",
            "The student should have picked an easier topic",
            "Correspondence cannot be graded",
            "All analogies are equal"
          ],
          "symptom": "The revision succeeds. What made it work?"
        }
      ],
      "title": "The undisciplined analogy"
    },
    {
      "brief": "A reader approaches the Corpus Hermeticum with no method. Put the study order in place.",
      "debrief": "Context, then text, then commentary, then synthesis. Reading primary sources without historical context is how anachronism happens.",
      "difficulty": 1,
      "domain_id": "critical-reading",
      "id": "her-sim-study-order",
      "kind": "ordering",
      "points": 10,
      "steps": {
        "context": "Drag the study method into the correct order.",
        "correct_order": [
          0,
          1,
          2,
          3
        ],
        "items": [
          "Learn the historical context",
          "Read the primary text closely",
          "Consult scholarly commentary",
          "Synthesize your own reading"
        ]
      },
      "title": "Order the study method"
    },
    {
      "brief": "A symbol catalog entry submitted for review fails. Click the lines that are wrong (2 issues).",
      "debrief": "Catalog entries need provenance: tradition, attestation, date. A symbol floating free of its sources is fiction wearing a costume.",
      "difficulty": 2,
      "domain_id": "symbol-systems",
      "id": "her-sim-catalog",
      "kind": "config-check",
      "points": 12,
      "steps": {
        "config": "name: ouroboros\ntradition: hermetic\nattested: Chrysopoeia of Cleopatra, c. 3rd century\nmeaning: cyclical renewal\nname: definitely-ancient rune\ntradition: unknown\nattested: my dream last night",
        "find": 2,
        "issues": [
          {
            "description": "Second entry has no tradition \u2014 'unknown' is not a scholarly attribution",
            "fix": "Research and record the actual tradition or mark it as unattested",
            "line": 6
          },
          {
            "description": "'My dream last night' is not an attestation \u2014 sources must be verifiable",
            "fix": "Cite a verifiable source or remove the entry",
            "line": 7
          }
        ]
      },
      "title": "Spot the catalog errors"
    },
    {
      "brief": "Two scholars disagree about a text's dating. Decide how to adjudicate.",
      "debrief": "Dating disputes are settled by evidence: paleography, citations, material analysis. Authority argues; evidence decides.",
      "difficulty": 3,
      "domain_id": "critical-reading",
      "id": "her-sim-dating-branch",
      "kind": "branching",
      "points": 16,
      "steps": [
        {
          "choices": [
            {
              "feedback": "Seniority is not evidence.",
              "label": "Side with the more senior scholar",
              "next": "END",
              "outcome": "bad",
              "points": 0
            },
            {
              "feedback": "Correct \u2014 compare the evidence each scholar cites.",
              "label": "Compare the paleographic and citation evidence",
              "next": "s2",
              "points": 2
            },
            {
              "feedback": "Splitting the difference invents a date nobody defends.",
              "label": "Split the difference between the dates",
              "next": "END",
              "outcome": "bad",
              "points": 0
            }
          ],
          "id": "s1",
          "text": "Two datings, one text. How to adjudicate?"
        },
        {
          "choices": [
            {
              "feedback": "Correct \u2014 the manuscript evidence constrains the possibilities.",
              "label": "Accept the dating the manuscript evidence supports",
              "next": "END",
              "outcome": "good",
              "points": 2
            },
            {
              "feedback": "Ignoring evidence for elegance is how errors persist.",
              "label": "Pick the more elegant theory",
              "next": "END",
              "outcome": "bad",
              "points": 0
            }
          ],
          "id": "s2",
          "text": "The manuscript evidence favors the later date. Conclusion?"
        }
      ],
      "title": "Date the manuscript"
    }
  ],
