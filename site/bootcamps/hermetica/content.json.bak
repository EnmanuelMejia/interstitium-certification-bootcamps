    {
      "id": "hermetica-lab-1",
      "title": "Close reading \u2014 terminal drill",
      "objective": "Run a short sequence of terminal commands that demonstrates close reading, then verify each result against the expected output.",
      "steps": [
        "This lab reworks the Hermetic Principles practice scenario \"As above, so below\" into commands you run yourself \u2014 same concept, hands-on instead of multiple choice.",
        "Open the Terminal tab for this bootcamp \u2014 every command below runs there.",
        "Type exactly: echo close-reading ready \u2014 echo prints your concept token back verbatim",
        "Type exactly: whoami \u2014 the shell reports the lab identity 'candidate'",
        "Type exactly: date \u2014 the date output includes the year 2026",
        "In your own words, say what each command's output taught you about close reading."
      ],
      "checks": [
        {
          "command_pattern": "echo",
          "expect_contains": "close-reading",
          "hint": "In the Terminal tab, run `echo close-reading ready`. If the check fails, confirm you typed it exactly and that the output contains \"close-reading\"."
        },
        {
          "command_pattern": "whoami",
          "expect_contains": "candidate",
          "hint": "In the Terminal tab, run `whoami`. If the check fails, confirm you typed it exactly and that the output contains \"candidate\"."
        },
        {
