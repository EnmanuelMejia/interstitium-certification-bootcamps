    {
      "id": "hermetica-lab1",
      "domain_id": "hermetic-principles",
      "title": "Journaling the Seven Principles",
      "objective": "Internalize the seven principles of the Kybalion tradition as contemplative instruments by journaling one concrete observation for each principle from your own experience.",
      "steps": [
        "Read the axiom of Mentalism ('THE ALL is MIND') and sit with it for two minutes. Then journal: one recent moment when your mental state visibly shaped an outcome.",
        "Read the axiom of Correspondence ('As above, so below'). Journal: one pattern you have seen repeat at two different scales of your life (e.g., a habit and a relationship).",
        "Read the axiom of Vibration ('Nothing rests; everything moves'). Journal: one thing you treat as fixed that is actually in motion \u2014 and what the motion is.",
        "Read the axiom of Polarity ('opposites are identical in nature, but different in degree'). Journal: one emotion you label as an enemy, redescribed as a degree on a scale.",
        "Read the axiom of Rhythm ('everything flows, out and in'). Journal: one cycle you are in right now, and whether you are fighting the swing or riding it.",
        "Read the axiom of Cause and Effect ('chance is but a name for law not recognized'). Journal: one 'unlucky' event, with the chain of causes traced as far back as you honestly can.",
        "Read the axiom of Gender (generation through the union of projective and receptive principles). Journal: one thing you created (an idea, a project, a repair) \u2014 which parts were projective and which receptive?",
        "Close the journal by writing one paragraph: which principle was hardest to apply, and what the resistance tells you about the principle."
      ],
      "checks": [
        {
          "command_pattern": "^journal mentalism",
          "expect_contains": "mind",
          "hint": "Start with: journal mentalism \u2014 then describe a moment your mental state shaped an outcome. Include the word 'mind'."
        },
        {
          "command_pattern": "^journal correspondence",
          "expect_contains": "pattern",
          "hint": "journal correspondence \u2014 name a pattern repeated at two scales of your life."
        },
        {
          "command_pattern": "^journal polarity",
          "expect_contains": "degree",
          "hint": "journal polarity \u2014 redescribe an emotion as a degree on a scale. Use the word 'degree'."
        },
        {
          "command_pattern": "^journal rhythm",
          "expect_contains": "swing",
          "hint": "journal rhythm \u2014 describe a cycle you are in and your relation to its swing."
        },
        {
          "command_pattern": "^journal causation",
          "expect_contains": "cause",
          "hint": "journal causation \u2014 trace the chain of causes behind one 'unlucky' event."
        },
        {
          "command_pattern": "^journal gender",
          "expect_contains": "generat",
          "hint": "journal gender \u2014 describe something you created via projective and receptive principles."
        }
      ],
      "domain_id_remapped_from": "seven-principles",
      "merged_from": "cbt-individual/hermetica"
    },
    {
      "id": "hermetica-lab2",
      "domain_id": "hermetic-principles",
      "title": "Reading the Emerald Tablet Slowly",
      "objective": "Practice the tradition's own slow-reading discipline on the Emerald Tablet: parse the text, place it historically, and read it contemplatively \u2014 three distinct operations the tradition's best readers kept separate.",
      "steps": [
        "Copy the tablet's opening line ('That which is below is like that which is above...') by hand or type it out. Journal: what does the word 'like' permit and what does it forbid?",
        "Journal the documentary facts in your own words: where does the paper trail begin (Arabic sources, 8th\u20139th century), and what is legend (the tomb discovery)?",
        "Journal: the tablet closes with 'the threefold wisdom.' Name the three branches (alchemy, astrology, theurgy) and give each a one-sentence definition in the tradition's own terms.",
        "Journal: read the tablet's 'one thing' through the Correspondence principle \u2014 what is the lower and what is the higher in one concrete case from your own work?",
        "Journal a source-critical reflection: what changes about your reading when you remember you are reading a medieval Latin text via Arabic sources, rendered into early modern English \u2014 not an Egyptian original?",
        "Close by journaling one sentence you would now put on a museum label for the tablet, and check it against the documentary facts from step 2."
      ],
      "checks": [
        {
          "command_pattern": "^journal tablet",
          "expect_contains": "like",
          "hint": "journal tablet \u2014 copy the opening line and write on what the word 'like' permits and forbids."
        },
        {
          "command_pattern": "^journal transmission",
          "expect_contains": "arabic",
          "hint": "journal transmission \u2014 where does the documentary trail begin? Mention the Arabic sources."
        },
        {
          "command_pattern": "^journal threefold",
          "expect_contains": "theurgy",
          "hint": "journal threefold \u2014 name alchemy, astrology, and theurgy with the tradition's own definitions."
        },
        {
          "command_pattern": "^reflect sources",
          "expect_contains": "medieval",
          "hint": "reflect sources \u2014 what changes when you remember the transmission layers? Mention the medieval Latin layer."
        }
      ],
      "domain_id_remapped_from": "texts-and-tradition",
      "merged_from": "cbt-individual/hermetica"
    }
  ],
