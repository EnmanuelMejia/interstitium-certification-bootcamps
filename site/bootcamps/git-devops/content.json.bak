        {
          "command_pattern": "^git status$",
          "expect_contains": "On branch main",
          "hint": "Type exactly: git status"
        },
        {
          "command_pattern": "^git branch$",
          "expect_contains": "* main",
          "hint": "Type exactly: git branch"
        }
      ],
      "success_message": "Roll call complete \u2014 the repo's identity is on record."
    },
    {
      "id": "gitops-mission-2",
      "title": "History check",
      "domain_id": "git-core",
      "difficulty": 1,
      "brief": "Read the recent history.",
      "objectives": [
        "Print the one-line log"
      ],
      "checks": [
        {
          "command_pattern": "^git log --oneline$",
          "expect_contains": "Add CI pipeline",
          "hint": "Type exactly: git log --oneline"
        }
      ],
      "success_message": "History read \u2014 the latest commit is known."
    },
    {
      "id": "gitops-mission-3",
      "title": "Branch out",
      "domain_id": "branching-merging",
      "difficulty": 2,
      "brief": "Create and switch to a feature branch.",
      "objectives": [
        "Create and switch to feature/docs"
      ],
      "checks": [
        {
          "command_pattern": "^git checkout -b feature/docs$",
          "expect_contains": "feature/docs",
          "hint": "Type exactly: git checkout -b feature/docs"
        }
      ],
      "success_message": "Branched \u2014 work now has its own line of history."
    },
    {
      "id": "gitops-mission-4",
      "title": "Review the work",
      "domain_id": "branching-merging",
      "difficulty": 2,
      "brief": "Inspect changes before committing.",
      "objectives": [
        "Show unstaged changes",
        "Show the remote"
      ],
      "checks": [
        {
          "command_pattern": "^git diff$",
          "expect_contains": "diff --git",
          "hint": "Type exactly: git diff"
        },
        {
          "command_pattern": "^git remote -v$",
          "expect_contains": "github.com",
          "hint": "Type exactly: git remote -v"
        }
      ],
      "success_message": "Review complete \u2014 changes inspected, remote confirmed."
    },
    {
      "id": "gitops-mission-5",
      "title": "Commit it",
      "domain_id": "git-core",
      "difficulty": 3,
      "brief": "Stage and commit with a real message.",
      "objectives": [
        "Stage everything",
        "Commit with message 'Update docs'"
      ],
      "checks": [
        {
          "command_pattern": "^git add \\.$",
          "expect_contains": "",
          "hint": "Type exactly: git add ."
        },
        {
          "command_pattern": "^git commit -m \"Update docs\"$",
          "expect_contains": "1 file changed",
          "hint": "Type exactly: git commit -m \"Update docs\""
        }
      ],
      "success_message": "Committed \u2014 the change is now history."
    },
    {
      "id": "gitops-mission-6",
      "title": "Ship it",
      "domain_id": "remotes-collab",
      "difficulty": 3,
      "brief": "Push the branch and verify the sync.",
      "objectives": [
        "Push to origin",
        "Verify the branch state"
      ],
      "checks": [
        {
          "command_pattern": "^git push -u origin feature/docs$",
          "expect_contains": "interstitium-labs",
          "hint": "Type exactly: git push -u origin feature/docs"
        },
        {
          "command_pattern": "^git status$",
          "expect_contains": "On branch",
          "hint": "Type exactly: git status"
        }
      ],
      "success_message": "Shipped \u2014 the branch is on the remote."
    }
  ],
