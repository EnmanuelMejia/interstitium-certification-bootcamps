  "math": [],
  "simulations": [
    {
      "id": "gitops-sim-1",
      "title": "The push that got rejected",
      "kind": "troubleshoot",
      "domain_id": "remotes-collab",
      "difficulty": 2,
      "brief": "git push is rejected: the remote has commits you don't have. Nothing is lost, but the push won't go through.",
      "steps": [
        {
          "symptom": "Push rejected \u2014 'failed to push some refs'; the remote is ahead of your branch.",
          "evidence": [
            [
              "terminal",
              "$ git push\n! [rejected] main -> main (fetch first)\nerror: failed to push some refs"
            ]
          ],
          "options": [
            "Fetch first: pull the remote's commits into your branch, resolve any conflicts, then push",
            "Push with --force to overwrite the remote",
            "Delete your branch and start over",
            "Push to a different remote"
          ],
          "correct": 0,
          "explain": "The remote moved while you worked. Fetching first integrates their commits; force-pushing would erase someone else's work."
        },
        {
          "symptom": "After fetching, one file conflicts: both sides edited the same lines.",
          "evidence": [
            [
              "terminal",
              "$ git pull\nCONFLICT (content): Merge conflict in config.yaml"
            ]
          ],
          "options": [
            "Open the conflicted file, keep the correct parts of both sides, remove the markers, add and commit",
            "Pick 'ours' blindly",
            "Pick 'theirs' blindly",
            "Abort and force-push your version"
          ],
          "correct": 0,
          "explain": "Conflict markers are a to-do list, not a verdict. Read both sides, merge the intent, then complete the merge commit."
        },
        {
          "symptom": "Conflict resolved and committed. Verify the sync.",
          "evidence": [
            [
              "terminal",
              "$ git log --oneline -3\n9f3a2c1 Add CI pipeline\n2b1c4d5 Merge remote config fix\na1b2c3d Resolve config.yaml conflict"
            ]
          ],
          "options": [
            "Confirm the merge commit exists and push succeeds",
            "Confirm the conflict file is deleted",
            "Confirm the remote was force-updated",
            "Confirm only your commits remain"
          ],
          "correct": 0,
          "explain": "The merge commit joins both histories; a clean push after it proves local and remote agree."
        }
      ],
      "debrief": "Rejected pushes mean the remote moved first. Fetch, merge the intent (never blind-pick a side), commit the merge, push. Force-push is never the answer on shared branches.",
      "points": 15
    },
    {
      "id": "gitops-sim-2",
      "title": "Release pipeline order",
      "kind": "ordering",
      "domain_id": "release-flow",
      "difficulty": 1,
      "brief": "Restore the order of a branch-to-release flow.",
      "steps": {
        "context": "Arrange the release flow stages in execution order.",
        "items": [
          "Create a feature branch from main",
          "Open a pull request",
          "Review and merge the pull request",
          "Tag the release on main",
          "Deploy the tagged release"
        ],
        "correct_order": [
          0,
          1,
          2,
          3,
          4
        ]
      },
      "debrief": "Branch \u2192 PR \u2192 merge \u2192 tag \u2192 deploy. Skipping the tag is how you deploy something you can't name later.",
      "points": 10
    },
    {
      "id": "gitops-sim-3",
      "title": "Merge or rebase?",
      "kind": "branching",
      "domain_id": "branching-merging",
      "difficulty": 2,
      "brief": "Choose the integration strategy for two situations.",
      "steps": [
        {
          "id": "s1",
          "text": "Your feature branch is 3 commits behind main, and you want the latest main changes in your branch before opening the PR. The branch is only yours.",
          "choices": [
            {
              "label": "Rebase onto main: your commits replay on the latest main \u2014 a clean, linear story",
              "next": "s2",
              "points": 2,
              "feedback": "Right: on a private branch, rebase keeps history linear and the PR diff minimal."
            },
            {
              "label": "Merge main into your branch",
              "next": "END",
              "points": 0,
              "feedback": "Merging main into a private feature branch works but litters history with merge commits before review.",
              "outcome": "bad"
            },
            {
              "label": "Cherry-pick main's commits one by one",
              "next": "END",
              "points": 0,
              "feedback": "Cherry-picking upstream changes duplicates them and confuses the later merge.",
              "outcome": "bad"
            }
          ]
        },
        {
          "id": "s2",
          "text": "The PR is approved. The branch has 20 tiny 'wip' commits. How does it land on main?",
          "choices": [
            {
              "label": "Squash-merge: one clean commit on main with the PR's intent",
              "next": "END",
              "points": 2,
              "feedback": "Right: main keeps one meaningful commit per PR; the 20 wips stay in the PR history for archaeology.",
              "outcome": "good"
            },
            {
              "label": "Rebase-merge the 20 wips onto main",
              "next": "END",
              "points": 0,
              "feedback": "20 wip commits on main's permanent history is noise nobody can bisect through.",
              "outcome": "bad"
            },
            {
              "label": "Push directly to main",
              "next": "END",
              "points": 0,
              "feedback": "Direct pushes to main bypass the review the PR just completed.",
              "outcome": "bad"
            }
          ]
        }
      ],
      "debrief": "Private branch catching up \u2192 rebase. Approved PR landing \u2192 squash. Shared history is never rewritten; private history is yours to curate.",
      "points": 12
    },
    {
      "id": "gitops-sim-4",
      "title": "The pipeline that ran on main",
      "kind": "config-check",
      "domain_id": "jenkins-basics",
      "difficulty": 3,
      "brief": "A Jenkins pipeline deploys from main on every push \u2014 including unreviewed pushes. The Jenkinsfile has 2 bugs in 14 lines.",
      "steps": {
        "config": "pipeline {\n  agent any\n  triggers { pollSCM('H/5 * * * *') }\n  stages {\n    stage('Build') { steps { sh 'npm run build' } }\n    stage('Test') { steps { sh 'npm test' } }\n    stage('Deploy') { steps { sh './deploy.sh prod' } }\n  }\n  post { failure { mail to: 'team@example.com' } }\n}",
        "find": 2,
        "issues": [
          {
            "line": 3,
            "description": "pollSCM on main rebuilds and redeploys on every push \u2014 including direct pushes that skipped review.",
            "fix": "Trigger deploys from tags or a release branch, not from every main push."
          },
          {
            "line": 9,
            "description": "The Deploy stage runs unconditionally after Test \u2014 a green test run on an unreviewed commit still ships.",
            "fix": "Gate Deploy on an approved release input or restrict it to tagged builds."
          }
        ]
      },
      "debrief": "Pipelines are policy as code: triggers and stage gates decide what ships. Unconditional deploy-on-main-push is an incident waiting for a bad commit.",
      "points": 10
    }
  ],
  "consoleSims": [
    {
      "id": "gitops-console-1",
      "title": "Open the pull request",
      "console": "git-host",
      "domain_id": "remotes-collab",
      "difficulty": 2,
      "brief": "The feature branch is pushed. Open a pull request against main with a proper description.",
      "tasks": [
        {
          "id": "t1",
          "instruction": "Open the repository's pull request view on the git host.",
          "validate": {
            "action": "click",
            "params": {
              "target": "repo:pull-requests:new"
            }
          },
          "hint": "Use the Pull requests tab, then New."
        },
        {
          "id": "t2",
          "instruction": "Set the base to main and the head to your feature branch.",
          "validate": {
            "action": "set-field",
            "params": {
              "field": "pr:head-branch",
              "value": "feature/search"
            }
          },
          "hint": "Head is the branch you pushed."
        },
        {
          "id": "t3",
          "instruction": "Write a description summarizing the change and request review.",
          "validate": {
            "action": "click",
            "params": {
              "target": "pr:request-review"
            }
          },
          "hint": "Every PR gets a reviewer before it merges."
        }
      ],
      "debrief": "PRs are the review gate: base main, head your branch, a description a stranger could understand, and a reviewer assigned."
    },
    {
      "id": "gitops-console-2",
      "title": "Rerun the failed CI job",
      "console": "cicd-pipeline",
      "domain_id": "ci-concepts",
      "difficulty": 3,
      "brief": "CI failed at the 'Test' stage after 'Build' passed. The test stage used the wrong Node version. Fix and rerun.",
      "tasks": [
        {
          "id": "t1",
          "instruction": "Open the failed 'Test' stage in the pipeline view.",
          "validate": {
            "action": "click",
            "params": {
              "target": "pipeline:stage:test"
            }
          },
          "hint": "Click the red test stage."
        },
        {
          "id": "t2",
          "instruction": "Set the Node version to '22' for the test stage.",
          "validate": {
            "action": "set-field",
            "params": {
              "field": "pipeline:test:env:NODE_VERSION",
              "value": "22"
            }
          },
          "hint": "The stage ran tests on the wrong runtime."
        },
        {
          "id": "t3",
          "instruction": "Rerun the test stage and confirm it goes green.",
          "validate": {
            "action": "click",
            "params": {
              "target": "pipeline:test:rerun"
            }
          },
          "hint": "Use the rerun control on the test stage."
        }
      ],
      "debrief": "Build-green/test-red with a runtime mismatch means the code was fine and the environment was wrong. Pin the runtime, rerun the stage."
    }
  ],
