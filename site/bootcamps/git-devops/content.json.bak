    {
      "id": "git-devops-lab-5",
      "title": "Read the repo's pulse",
      "difficulty": 1,
      "objective": "Use status, branch, and log to orient in a repository.",
      "steps": [
        "Open the Terminal view for this bootcamp.",
        "Type git status \u2014 read the branch line.",
        "Type git branch \u2014 the star marks your current branch.",
        "Type git log --oneline \u2014 read the latest commit message."
      ],
      "checks": [
        {
          "command_pattern": "^git status$",
          "expect_contains": "On branch main",
          "hint": "Type exactly: git status"
        },
        {
          "command_pattern": "^git branch$",
          "expect_contains": "* main",
          "hint": "Type exactly: git branch"
        },
        {
          "command_pattern": "^git log --oneline$",
          "expect_contains": "Add CI pipeline",
          "hint": "Type exactly: git log --oneline"
        }
      ],
      "success_message": "Oriented \u2014 you can read any repo's pulse in three commands."
    },
    {
      "id": "git-devops-lab-6",
      "title": "Create a feature branch",
      "difficulty": 1,
      "objective": "Branch off main for a new feature without touching main.",
      "steps": [
        "Type git branch to confirm you are on main.",
        "Type git checkout -b feature/search \u2014 creates and switches in one step.",
        "Type git branch \u2014 confirm the star moved to feature/search.",
        "Work always happens on branches; main stays releasable."
      ],
      "checks": [
        {
          "command_pattern": "^git branch$",
          "expect_contains": "* main",
          "hint": "Type exactly: git branch"
        },
        {
          "command_pattern": "^git checkout -b feature/search$",
          "expect_contains": "feature/search",
          "hint": "Type exactly: git checkout -b feature/search"
        }
      ],
      "success_message": "Branch created \u2014 main is untouched, your work has a home."
    },
    {
      "id": "git-devops-lab-7",
      "title": "Inspect before you commit",
      "difficulty": 2,
      "objective": "Use diff and status to review changes before they become history.",
      "steps": [
        "Type git status \u2014 see what's staged and what's not.",
        "Type git diff \u2014 read the unstaged changes line by line.",
        "Type git remote -v \u2014 confirm where this repo pushes.",
        "Review first, commit second \u2014 that's the discipline."
      ],
      "checks": [
        {
          "command_pattern": "^git status$",
          "expect_contains": "On branch main",
          "hint": "Type exactly: git status"
        },
        {
          "command_pattern": "^git diff$",
          "expect_contains": "diff --git",
          "hint": "Type exactly: git diff"
        },
        {
          "command_pattern": "^git remote -v$",
          "expect_contains": "github.com",
          "hint": "Type exactly: git remote -v"
        }
      ],
      "success_message": "Inspection done \u2014 you review changes the way history will see them."
    },
    {
      "id": "git-devops-lab-8",
      "title": "Publish the branch",
      "difficulty": 3,
      "objective": "Commit on the branch and push it to the remote.",
      "steps": [
        "Type git add . \u2014 stage your work.",
        "Type git commit -m \"Add search\" \u2014 write a message future-you will thank you for.",
        "Type git status \u2014 confirm the branch is still feature/search or main.",
        "Type git push -u origin feature/search \u2014 publish the branch upstream."
      ],
      "checks": [
        {
          "command_pattern": "^git commit -m \"Add search\"$",
          "expect_contains": "1 file changed",
          "hint": "Type exactly: git commit -m \"Add search\""
        },
        {
          "command_pattern": "^git status$",
          "expect_contains": "On branch",
          "hint": "Type exactly: git status"
        },
        {
          "command_pattern": "^git push -u origin feature/search$",
          "expect_contains": "interstitium-labs",
          "hint": "Type exactly: git push -u origin feature/search"
        }
      ],
      "success_message": "Published \u2014 the branch is on the remote, ready for review."
    }
