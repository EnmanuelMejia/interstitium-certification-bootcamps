        "id": "concurrency-virtual-threads",
        "name": "Concurrency & Virtual Threads",
        "key_points": [
          "lost updates and AtomicInteger",
          "deadlock and lock ordering",
          "virtual threads for blocking I/O",
          "executor shutdown",
          "volatile visibility",
          "ThreadLocal with virtual threads"
        ],
        "followups": [
          "How many steps is that increment?",
          "What keeps the JVM alive after main returns?"
        ]
      },
      {
        "id": "modules-jars-io",
        "name": "Modules, JARs & I/O",
        "key_points": [
          "module exports",
          "manifest Main-Class",
          "try-with-resources",
          "serialVersionUID",
          "classpath resources",
          "HttpClient"
        ],
        "followups": [
          "What does a module hide by default?",
          "Is that resource a file inside the JAR?"
        ]
      }
    ]
