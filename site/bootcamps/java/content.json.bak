  "simulations": [
    {
      "id": "java-sim-1",
      "title": "The vanishing element",
      "kind": "troubleshoot",
      "domain_id": "collections-generics",
      "difficulty": 2,
      "brief": "A cleanup loop removes expired sessions from a list \u2014 and crashes with ConcurrentModificationException on the second run.",
      "steps": [
        {
          "symptom": "First run fine, second run throws ConcurrentModificationException inside the loop.",
          "evidence": [
            [
              "SessionStore.java",
              "for (Session s : sessions) {\n    if (s.isExpired()) sessions.remove(s);  // line 31\n}"
            ]
          ],
          "options": [
            "Read line 31: the enhanced for-loop holds an iterator, and removing directly from the list invalidates it",
            "The list is too large; increase the heap",
            "Sessions expire too fast; lengthen the timeout",
            "The exception is random; rerun until it passes"
          ],
          "correct": 0,
          "explain": "The enhanced for loop uses an iterator under the hood; structural modification outside iterator.remove() trips the fail-fast check \u2014 intermittently, depending on timing."
        },
        {
          "symptom": "Confirmed: structural modification during iteration.",
          "evidence": [
            [
              "SessionStore.java",
              "// sessions: ArrayList<Session>, single-threaded cleanup task"
            ]
          ],
          "options": [
            "Remove via the iterator (iterator.remove()) or collect-then-remove after the loop",
            "Synchronize the list",
            "Switch to a raw array",
            "Catch the exception and continue"
          ],
          "correct": 0,
          "explain": "Either remove through the iterator you are iterating with, or gather the expired sessions and remove them after the loop \u2014 both keep the iterator's view consistent."
        },
        {
          "symptom": "Fix applied with iterator.remove(). Verify correctness.",
          "evidence": [
            [
              "SessionStore.java",
              "Iterator<Session> it = sessions.iterator();\nwhile (it.hasNext()) {\n    if (it.next().isExpired()) it.remove();\n}"
            ]
          ],
          "options": [
            "Confirm no expired session survives and no live session is removed \u2014 run the session-count assertion",
            "Confirm the code compiles",
            "Confirm the loop is faster",
            "Confirm the list is now empty"
          ],
          "correct": 0,
          "explain": "Compile-success is not correctness: assert the postcondition \u2014 every expired session gone, every live session kept."
        }
      ],
      "debrief": "Fail-fast iterators punish structural modification during traversal. Remove through the iterator \u2014 or after the loop \u2014 and verify the postcondition, not just the compile.",
      "points": 15
    },
    {
      "id": "java-sim-2",
      "title": "From source to running",
      "kind": "ordering",
      "domain_id": "language-core",
      "difficulty": 1,
      "brief": "Restore the order of the Java execution pipeline.",
      "steps": {
        "context": "Arrange the stages from .java source to running code.",
        "items": [
          "Write the .java source file",
          "Compile with javac to bytecode (.class)",
          "Load classes with the class loader",
          "Verify the bytecode",
          "Execute via the interpreter / JIT compiler"
        ],
        "correct_order": [
          0,
          1,
          2,
          3,
          4
        ]
      },
      "debrief": "Write \u2192 compile \u2192 load \u2192 verify \u2192 execute. The verifier is Java's safety gate: untrusted bytecode never runs unchecked.",
      "points": 10
    },
    {
      "id": "java-sim-3",
      "title": "Checked or unchecked?",
      "kind": "branching",
      "domain_id": "streams-lambdas",
      "difficulty": 2,
      "brief": "A method can fail two ways: a missing config file, and a null item in a list. Decide how each failure should be modeled.",
      "steps": [
        {
          "id": "s1",
          "text": "readConfig() may not find config.yaml on disk. How should this failure surface?",
          "choices": [
            {
              "label": "Checked exception (e.g. IOException): the caller must handle or declare it \u2014 a missing file is recoverable and expected",
              "next": "s2",
              "points": 2,
              "feedback": "Right: recoverable, external, expected \u2014 the textbook case for a checked exception."
            },
            {
              "label": "Unchecked exception: let it crash",
              "next": "END",
              "points": 0,
              "feedback": "A missing config file is foreseeable \u2014 crashing without a declared contract hides a recoverable situation.",
              "outcome": "bad"
            },
            {
              "label": "Return null and document nothing",
              "next": "END",
              "points": 0,
              "feedback": "Null returns push the failure downstream as a NullPointerException. Declare it instead.",
              "outcome": "bad"
            }
          ]
        },
        {
          "id": "s2",
          "text": "process(items) receives a list that must never contain null \u2014 a null means the caller broke the contract. How should this surface?",
          "choices": [
            {
              "label": "Unchecked exception (IllegalArgumentException): a programming error, not a recoverable condition",
              "next": "END",
              "points": 2,
              "feedback": "Right: contract violations are bugs \u2014 fail fast and loudly with an unchecked exception.",
              "outcome": "good"
            },
            {
              "label": "Checked exception: force every caller to catch it",
              "next": "END",
              "points": 0,
              "feedback": "Checked exceptions for programming errors just produce empty catch blocks.",
              "outcome": "bad"
            },
            {
              "label": "Silently skip null items",
              "next": "END",
              "points": 0,
              "feedback": "Silent skipping hides the caller's bug and corrupts downstream results.",
              "outcome": "bad"
            }
          ]
        }
      ],
      "debrief": "Checked exceptions model recoverable, expected failures (missing file); unchecked exceptions model programming errors (null where forbidden). Match the mechanism to the failure's nature.",
      "points": 12
    },
    {
      "id": "java-sim-4",
      "title": "The module-info that misfires",
      "kind": "config-check",
      "domain_id": "modules-jars-io",
      "difficulty": 3,
      "brief": "A modular JAR compiles but fails at run time with 'package is not visible'. The module-info.java has 2 bugs in 9 lines.",
      "steps": {
        "config": "module shop.app {\n    requires shop.core;\n    requires java.sql;\n    exports com.shop.api;\n    exports com.shop.internal;\n    opens com.shop.api;\n    uses com.shop.spi.PaymentService;\n    provides com.shop.spi.PaymentService\n        with com.shop.internal.StripePayment;\n}",
        "find": 2,
        "issues": [
          {
            "line": 5,
            "description": "exports com.shop.internal exposes the internal package to every consumer \u2014 internals must stay encapsulated.",
            "fix": "Remove the exports line for com.shop.internal (keep opens only if reflection is needed)."
          },
          {
            "line": 9,
            "description": "The provides clause names com.shop.internal.StripePayment, which lives in the internal package \u2014 inconsistent with encapsulation.",
            "fix": "Move the provider implementation to an exported package, or reconsider what the service exposes."
          }
        ]
      },
      "debrief": "The module system is an encapsulation contract: export only the API surface, and make sure service providers live where the contract allows.",
      "points": 10
    }
  ],
  "consoleSims": [
    {
      "id": "java-console-1",
      "title": "Fix the null dereference",
      "console": "code-editor",
      "domain_id": "oop-design",
      "difficulty": 2,
      "brief": "OrderService crashes on line 18: customer.getName() where customer can be null. Guard it in the IDE and rerun.",
      "tasks": [
        {
          "id": "t1",
          "instruction": "Open OrderService.java in the code editor.",
          "validate": {
            "action": "click",
            "params": {
              "target": "explorer:OrderService.java"
            }
          },
          "hint": "Find OrderService.java in the file explorer."
        },
        {
          "id": "t2",
          "instruction": "Guard line 18: change it to call getName() only when customer != null (use a ternary returning \"guest\").",
          "validate": {
            "action": "set-field",
            "params": {
              "field": "editor:OrderService.java:line18",
              "value": "        String name = (customer != null) ? customer.getName() : \"guest\";"
            }
          },
          "hint": "A ternary keeps the fix to one line."
        },
        {
          "id": "t3",
          "instruction": "Run the debugger and confirm no exception is thrown.",
          "validate": {
            "action": "click",
            "params": {
              "target": "debugger:run"
            }
          },
          "hint": "Use the Run and Debug control."
        }
      ],
      "debrief": "Null dereferences are contract questions: decide what 'no customer' means (here, 'guest') and encode it at the boundary."
    },
    {
      "id": "java-console-2",
      "title": "Watch the stream pipeline",
      "console": "code-editor",
      "domain_id": "streams-lambdas",
      "difficulty": 3,
      "brief": "A stream pipeline drops records and you can't see where. Break on the filter, watch the predicate input, and run.",
      "tasks": [
        {
          "id": "t1",
          "instruction": "Set a breakpoint on the filter line of ReportJob.java.",
          "validate": {
            "action": "click",
            "params": {
              "target": "editor:ReportJob.java:line22:breakpoint"
            }
          },
          "hint": "Click in the gutter next to the .filter(...) line."
        },
        {
          "id": "t2",
          "instruction": "Add a watch expression for r.getStatus().",
          "validate": {
            "action": "set-field",
            "params": {
              "field": "debugger:watch",
              "value": "r.getStatus()"
            }
          },
          "hint": "The watch shows each element the predicate sees."
        },
        {
          "id": "t3",
          "instruction": "Run the debugger and confirm which statuses get filtered out.",
          "validate": {
            "action": "click",
            "params": {
              "target": "debugger:run"
            }
          },
          "hint": "Continue through several elements and read the watch."
        }
      ],
      "debrief": "Streams are pipelines: a breakpoint on the filter plus a watch on the element makes each stage's decision visible."
    }
  ],
