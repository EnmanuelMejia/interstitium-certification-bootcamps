    {
      "id": "ides-tooling-lab1",
      "domain_id": "vscode",
      "title": "Portable VS Code Workspace",
      "objective": "Create a committed, portable VS Code workspace configuration with format-on-save and a debug launch profile.",
      "steps": [
        "Create the workspace config directory: mkdir -p .vscode",
        "Write .vscode/settings.json enabling editor.formatOnSave and setting the default formatter.",
        "Write .vscode/launch.json with a debug configuration for your language (node or python) that launches the current file.",
        "Verify both files parse as JSON: python3 -c \"import json; [json.load(open(f)) for f in ['.vscode/settings.json','.vscode/launch.json']]; print('valid')\"",
        "Review the files and confirm no absolute personal paths are present: cat .vscode/settings.json"
      ],
      "checks": [
        {
          "command_pattern": "^cat\\s",
          "expect_contains": "formatOnSave",
          "hint": "settings.json must enable editor.formatOnSave so formatting is automatic."
        },
        {
          "command_pattern": "^python3\\s",
          "expect_contains": "valid",
          "hint": "Both JSON files must parse - a trailing comma breaks the whole config."
        }
      ],
      "domain_id_remapped_from": "ides-tooling",
      "merged_from": "cbt-individual/ides-tooling"
    },
    {
      "id": "ides-tooling-lab2",
      "domain_id": "vscode",
      "title": "Surgical Git Staging",
      "objective": "Stage individual hunks instead of whole files, review exactly what will commit, and leave the tree clean.",
      "steps": [
        "Check the working tree state: git status --short",
        "Make two unrelated edits in one file (a bug fix and a comment cleanup).",
        "Stage only the bug-fix hunk interactively: git add -p (answer y/n per hunk).",
        "Review precisely what is staged: git diff --cached",
        "Commit the staged hunk with a focused message, then confirm a clean tree: git status --short"
      ],
      "checks": [
        {
          "command_pattern": "^git\\s+diff",
          "expect_contains": "diff --git",
          "hint": "git diff --cached shows the staged hunks - verify only the bug fix is staged."
        },
        {
          "command_pattern": "^git\\s+status",
          "expect_contains": "M",
          "hint": "After committing one hunk, the comment cleanup should remain as a modified, unstaged change."
        }
      ],
      "domain_id_remapped_from": "ides-tooling",
      "merged_from": "cbt-individual/ides-tooling"
    }
  ],
  "foundations": [
    {
      "track": "cli-basics",
      "why_needed": "Developer tools live half in the terminal. Learn what a command line is and how to get help before mastering IDEs."
    },
    {
      "track": "programming-basics",
      "why_needed": "IDEs exist to write code. Know what code is first, so the tooling has something to serve."
    }
  ],
  "math": [],
  "simulations": [
    {
      "id": "ides-sim-1",
      "title": "The breakpoint that never hits",
      "kind": "troubleshoot",
      "domain_id": "debugging-workflows",
      "difficulty": 2,
      "brief": "A breakpoint in app.ts never pauses the debugger. The code runs, the breakpoint stays hollow.",
      "steps": [
        {
          "symptom": "Breakpoint shows as hollow (unbound); execution never pauses there.",
          "evidence": [
            [
              "debug console",
              "Breakpoint ignored: no executable code at app.ts:42"
            ],
            [
              "launch.json",
              "\"sourceMaps\": false"
            ]
          ],
          "options": [
            "Read the evidence: sourceMaps are off, so the debugger can't map app.ts:42 to the running bundle",
            "The code has no bugs; remove the breakpoint",
            "Restart the editor",
            "Add more breakpoints"
          ],
          "correct": 0,
          "explain": "A hollow breakpoint means 'no executable code here' \u2014 with sourceMaps off, the debugger maps your TS file to nothing in the running JS bundle."
        },
        {
          "symptom": "Confirmed: source maps disabled in the launch config.",
          "evidence": [
            [
              "tsconfig.json",
              "\"sourceMap\": true  // the compiler emits maps"
            ]
          ],
          "options": [
            "Enable sourceMaps in launch.json so the debugger can bind TS lines to running code",
            "Delete tsconfig.json",
            "Debug the compiled JS directly",
            "Set a breakpoint on every line"
          ],
          "correct": 0,
          "explain": "The compiler emits the maps; the debugger just needs permission to use them. One flag binds every breakpoint."
        },
        {
          "symptom": "Fix applied. Verify the binding.",
          "evidence": [
            [
              "debug console",
              "Breakpoint bound: app.ts:42 -> bundle.js:118"
            ]
          ],
          "options": [
            "Confirm the breakpoint turns solid and pauses on the next run",
            "Confirm the editor restarts",
            "Confirm the code compiles",
            "Confirm the bundle is smaller"
          ],
          "correct": 0,
          "explain": "Solid breakpoint plus a pause is the proof \u2014 the line mapping is working end to end."
        }
      ],
      "debrief": "Hollow breakpoints are mapping failures, not code failures. The compiler emits source maps; the launch config must enable them; the solid breakpoint is the proof.",
      "points": 15
    },
    {
      "id": "ides-sim-2",
      "title": "Debug session setup",
      "kind": "ordering",
      "domain_id": "debugging-workflows",
      "difficulty": 1,
      "brief": "Restore the order for setting up a debug session.",
      "steps": {
        "context": "Arrange the debugging setup steps in execution order.",
        "items": [
          "Set a breakpoint on the suspect line",
          "Choose the launch configuration",
          "Start the debug session",
          "Step through the code",
          "Inspect variables at the pause"
        ],
        "correct_order": [
          0,
          1,
          2,
          3,
          4
        ]
      },
      "debrief": "Breakpoint \u2192 config \u2192 launch \u2192 step \u2192 inspect. Skipping the config is how you debug the wrong process.",
      "points": 10
    },
    {
      "id": "ides-sim-3",
      "title": "Quick fix or refactor?",
      "kind": "branching",
      "domain_id": "vscode",
      "difficulty": 2,
      "brief": "The editor offers two actions on a duplicated code block. Choose wisely.",
      "steps": [
        {
          "id": "s1",
          "text": "A 40-line block is duplicated in three files with small variations. The editor offers 'Extract Method' and 'Copy'. Which first?",
          "choices": [
            {
              "label": "Extract Method: deduplicate first, then vary the parameter \u2014 one fix location instead of three",
              "next": "s2",
              "points": 2,
              "feedback": "Right: duplication is the bug factory. Extract first, parameterize the differences."
            },
            {
              "label": "Copy: faster right now",
              "next": "END",
              "points": 0,
              "feedback": "Copying is how you got three divergent copies. Speed now, bugs later.",
              "outcome": "bad"
            },
            {
              "label": "Leave it \u2014 it works",
              "next": "END",
              "points": 0,
              "feedback": "'It works' three times is three places to fix the next bug.",
              "outcome": "bad"
            }
          ]
        },
        {
          "id": "s2",
          "text": "Extracted. The three call sites differ by one flag each. What next?",
          "choices": [
            {
              "label": "Add a parameter for the flag \u2014 the method stays single-sourced",
              "next": "END",
              "points": 2,
              "feedback": "Right: parameterize the variation, keep one implementation.",
              "outcome": "good"
            },
            {
              "label": "Add three if-branches inside keyed on the caller",
              "next": "END",
              "points": 0,
              "feedback": "Caller-sniffing inside the method recreates the coupling you just removed.",
              "outcome": "bad"
            }
          ]
        }
      ],
      "debrief": "Duplication is the decision point: extract to a single source, parameterize the variation. Copy is never the fix for copy-paste.",
      "points": 12
    },
    {
      "id": "ides-sim-4",
      "title": "The launch.json that misfires",
      "kind": "config-check",
      "domain_id": "terminal-tasks",
      "difficulty": 3,
      "brief": "F5 does nothing: the debug session dies instantly. launch.json has 2 bugs in 12 lines.",
      "steps": {
        "config": "{\n  \"version\": \"0.2.0\",\n  \"configurations\": [\n    {\n      \"type\": \"node\",\n      \"request\": \"launch\",\n      \"name\": \"Debug app\",\n      \"program\": \"${workspaceFolder}/srv/app.js\",\n      \"preLaunchTask\": \"npm: build\",\n      \"sourceMaps\": true\n    }\n  ]\n}",
        "find": 2,
        "issues": [
          {
            "line": 7,
            "description": "program points to srv/app.js but the built file is at dist/app.js \u2014 the debugger launches a file that doesn't exist.",
            "fix": "Change the program path to ${workspaceFolder}/dist/app.js."
          },
          {
            "line": 8,
            "description": "preLaunchTask references 'npm: build' but the task is defined as 'build' \u2014 the pre-launch step never runs.",
            "fix": "Rename the task reference to match the defined task label."
          }
        ]
      },
      "debrief": "Launch configs are path contracts: program must exist where it claims, and task names must match exactly. F5 failing silently is always a config mismatch.",
      "points": 10
    }
  ],
  "consoleSims": [
    {
      "id": "ides-console-1",
      "title": "Bind the breakpoint",
      "console": "code-editor",
      "domain_id": "debugging-workflows",
      "difficulty": 2,
      "brief": "app.ts:42 shows a hollow breakpoint. Enable source maps in the launch config from the IDE and rebind.",
      "tasks": [
        {
          "id": "t1",
          "instruction": "Open launch.json in the code editor.",
          "validate": {
            "action": "click",
            "params": {
              "target": "explorer:launch.json"
            }
          },
          "hint": "Find launch.json in the file explorer (the .vscode folder)."
        },
        {
          "id": "t2",
          "instruction": "Set \"sourceMaps\" to true on the debug configuration.",
          "validate": {
            "action": "set-field",
            "params": {
              "field": "editor:launch.json:sourceMaps",
              "value": "true"
            }
          },
          "hint": "The flag lets the debugger map TS lines to running code."
        },
        {
          "id": "t3",
          "instruction": "Restart the debug session and confirm the breakpoint turns solid.",
          "validate": {
            "action": "click",
            "params": {
              "target": "debugger:run"
            }
          },
          "hint": "Use the Run and Debug control."
        }
      ],
      "debrief": "Hollow \u2192 solid is the whole story: with source maps enabled, the debugger can bind your source lines to the running bundle."
    },
    {
      "id": "ides-console-2",
      "title": "Fix the task name",
      "console": "code-editor",
      "domain_id": "terminal-tasks",
      "difficulty": 3,
      "brief": "The preLaunchTask 'npm: build' matches no defined task, so F5 skips the build. Fix the reference in the IDE.",
      "tasks": [
        {
          "id": "t1",
          "instruction": "Open launch.json in the code editor.",
          "validate": {
            "action": "click",
            "params": {
              "target": "explorer:launch.json"
            }
          },
          "hint": "Find launch.json in the .vscode folder."
        },
        {
          "id": "t2",
          "instruction": "Change the preLaunchTask value to match the defined task label 'build'.",
          "validate": {
            "action": "set-field",
            "params": {
              "field": "editor:launch.json:preLaunchTask",
              "value": "build"
            }
          },
          "hint": "Task references must match the task label exactly."
        },
        {
          "id": "t3",
          "instruction": "Press F5 (run) and confirm the build task executes first.",
          "validate": {
            "action": "click",
            "params": {
              "target": "debugger:run"
            }
          },
          "hint": "Watch the task output before the debug session starts."
        }
      ],
      "debrief": "Task references are name contracts: a mismatch silently skips the build, and you debug stale code."
    }
  ],
