  "labs": [
    {
      "id": "ides-tooling-lab-1",
      "title": "Command Palette \u2014 terminal drill",
      "objective": "Run a short sequence of terminal commands that demonstrates command Palette, then verify each result against the expected output.",
      "steps": [
        "This lab reworks the VS Code practice scenario \"Hunting through menus\" into commands you run yourself \u2014 same concept, hands-on instead of multiple choice.",
        "Open the Terminal tab for this bootcamp \u2014 every command below runs there.",
        "Type exactly: echo command-palette ready \u2014 echo prints your concept token back verbatim",
        "Type exactly: whoami \u2014 the shell reports the lab identity 'candidate'",
        "Type exactly: date \u2014 the date output includes the year 2026",
        "In your own words, say what each command's output taught you about command Palette."
      ],
      "checks": [
        {
          "command_pattern": "echo",
          "expect_contains": "command-palette",
          "hint": "In the Terminal tab, run `echo command-palette ready`. If the check fails, confirm you typed it exactly and that the output contains \"command-palette\"."
        },
        {
          "command_pattern": "whoami",
          "expect_contains": "candidate",
          "hint": "In the Terminal tab, run `whoami`. If the check fails, confirm you typed it exactly and that the output contains \"candidate\"."
        },
        {
          "command_pattern": "date",
          "expect_contains": "2026",
          "hint": "In the Terminal tab, run `date`. If the check fails, confirm you typed it exactly and that the output contains \"2026\"."
        }
      ],
      "success_message": "Lab complete \u2014 command Palette practiced hands-on. That's the Interstitium Labs way: run it, see it, own it."
    },
    {
      "id": "ides-tooling-lab-2",
      "title": "Refactoring \u2014 terminal drill",
      "objective": "Use the terminal to explore refactoring hands-on: type each command, read what comes back, and connect the output to the concept.",
      "steps": [
        "Inspired by the IntelliJ / PyCharm scenario \"Renaming across forty files\": take its core idea and prove it live in the terminal instead of answering on paper.",
        "Open the Terminal tab for this bootcamp \u2014 every command below runs there.",
        "Type exactly: date \u2014 the date output includes the year 2026",
        "Type exactly: uname \u2014 the kernel name reported is Linux",
        "Type exactly: echo refactoring ready \u2014 echo prints your concept token back verbatim",
        "In your own words, say what each command's output taught you about refactoring."
      ],
      "checks": [
        {
          "command_pattern": "date",
          "expect_contains": "2026",
          "hint": "In the Terminal tab, run `date`. If the check fails, confirm you typed it exactly and that the output contains \"2026\"."
        },
        {
          "command_pattern": "uname",
          "expect_contains": "Linux",
          "hint": "In the Terminal tab, run `uname`. If the check fails, confirm you typed it exactly and that the output contains \"Linux\"."
        },
        {
          "command_pattern": "echo",
          "expect_contains": "refactoring",
          "hint": "In the Terminal tab, run `echo refactoring ready`. If the check fails, confirm you typed it exactly and that the output contains \"refactoring\"."
        }
      ],
      "success_message": "Lab complete \u2014 refactoring practiced hands-on. That's the Interstitium Labs way: run it, see it, own it."
    },
    {
      "id": "ides-tooling-lab-3",
      "title": "Debugging \u2014 terminal drill",
      "objective": "Prove you can apply debugging in the terminal \u2014 follow the steps, watch the output, and confirm every check passes.",
      "steps": [
        "The Visual Studio scenario \"Always debugging\" tests this concept as a question. This lab makes you demonstrate it with real commands.",
        "Open the Terminal tab for this bootcamp \u2014 every command below runs there.",
        "Type exactly: echo debugging ready \u2014 echo prints your concept token back verbatim",
        "Type exactly: whoami \u2014 the shell reports the lab identity 'candidate'",
        "Type exactly: date \u2014 the date output includes the year 2026",
        "In your own words, say what each command's output taught you about debugging."
      ],
      "checks": [
        {
          "command_pattern": "echo",
          "expect_contains": "debugging",
          "hint": "In the Terminal tab, run `echo debugging ready`. If the check fails, confirm you typed it exactly and that the output contains \"debugging\"."
        },
        {
          "command_pattern": "whoami",
          "expect_contains": "candidate",
          "hint": "In the Terminal tab, run `whoami`. If the check fails, confirm you typed it exactly and that the output contains \"candidate\"."
        },
        {
          "command_pattern": "date",
          "expect_contains": "2026",
          "hint": "In the Terminal tab, run `date`. If the check fails, confirm you typed it exactly and that the output contains \"2026\"."
        }
      ],
      "success_message": "Lab complete \u2014 debugging practiced hands-on. That's the Interstitium Labs way: run it, see it, own it."
    },
