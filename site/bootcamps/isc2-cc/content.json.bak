  "simulations": [
    {
      "id": "cc-sim-1",
      "title": "The email from the CEO",
      "kind": "troubleshoot",
      "domain_id": "sec-operations",
      "difficulty": 1,
      "brief": "It is 4:40 PM on a Friday. An email that looks like it is from the CEO asks you to buy gift cards for client gifts and send the codes right away. Work it step by step.",
      "steps": [
        {
          "symptom": "Urgent email, apparently from the CEO: buy six $200 gift cards for client gifts, scratch off the codes, reply with photos of the codes.",
          "evidence": [
            [
              "Email (excerpt)",
              "From: ceo@company.co (note: our domain is company.com)\nSubject: Quick favor \u2014 urgent\nBody: I'm in back-to-back meetings, need this in the next 30 min. Don't call, just reply here."
            ]
          ],
          "options": [
            "Stop: do not buy, do not reply. Report it to IT or security via the phishing report button",
            "Buy the cards quickly \u2014 the CEO asked and it is urgent",
            "Reply asking which store the CEO prefers",
            "Forward it to coworkers so they can help buy the cards faster"
          ],
          "correct": 0,
          "explain": "Urgency plus an unusual request plus a slightly wrong domain is the classic gift-card scam. The right move is to stop, not engage, and report it \u2014 reporting protects everyone, and the real CEO will confirm they never sent it."
        },
        {
          "symptom": "IT confirms the email is fraudulent and from an external attacker. Three coworkers received the same message.",
          "evidence": [
            [
              "IT reply",
              "Confirmed phishing. Same lure sent to 4 staff.\nSender domain: company.co (lookalike, registered 2 days ago)."
            ]
          ],
          "options": [
            "Delete your copy and forget about it",
            "Help IT warn the other recipients and share what tipped you off, so the team learns the signs",
            "Reply to the attacker telling them off",
            "Post the CEO's real email publicly to prove the difference"
          ],
          "correct": 1,
          "explain": "One report becomes team immunity when the signs are shared: lookalike domain, urgency, do-not-call instruction. Security awareness spreads fastest through real, recent examples \u2014 not annual slides."
        },
        {
          "symptom": "A coworker admits they already bought two cards and sent the codes before IT's warning arrived.",
          "evidence": [
            [
              "Timeline",
              "Codes sent 20 minutes ago. Cards: $400 total.\nRetailer: codes may still be unredeemed."
            ]
          ],
          "options": [
            "Tell them to keep quiet \u2014 it is embarrassing and the money is gone",
            "Buy two more cards to replace them",
            "Act fast: tell IT and the manager immediately, contact the retailer to try freezing the cards, and document everything",
            "Wait until Monday to report it"
          ],
          "correct": 2,
          "explain": "Speed matters: unredeemed gift-card codes can sometimes be frozen by the retailer, but only if you act within minutes to hours. A no-blame reporting culture is what makes people speak up fast enough for recovery to work."
        }
      ],
      "debrief": "You spotted the lure, reported instead of engaging, spread the warning, and escalated the real loss fast. That is exactly how a beginner becomes the team's early-warning system.",
      "points": 30
    },
    {
      "id": "cc-sim-2",
      "title": "The laptop on the train",
      "kind": "troubleshoot",
      "domain_id": "principles",
      "difficulty": 2,
      "brief": "A colleague calls you, panicked: they left their work laptop on the morning train. It holds customer records. Walk the incident down correctly.",
      "steps": [
        {
          "symptom": "Laptop missing since 8:15 AM. Last seen on the train. Contains customer records. Full-disk encryption was enabled; the device was locked.",
          "evidence": [
            [
              "Device record",
              "Asset: LT-2041 | Encryption: enabled (BitLocker)\nScreen lock: 5 min | Last check-in: 8:02 AM\nData: customer records (Confidential)"
            ]
          ],
          "options": [
            "Wait until tomorrow \u2014 it will probably turn up in lost and found",
            "Ask on social media if anyone found a laptop",
            "Do nothing \u2014 encryption means there is nothing to do",
            "Report it to IT and security immediately so the device can be remotely locked or wiped and credentials rotated"
          ],
          "correct": 3,
          "explain": "Encryption buys time, not immunity: report immediately so IT can remote-lock or wipe the device, rotate the user's credentials, and start the incident record. Fast reporting is what keeps a lost device from becoming a breach."
        },
        {
          "symptom": "IT remotely locks the laptop within the hour. The question now: is this a data breach that must be disclosed?",
          "evidence": [
            [
              "Forensics note",
              "Disk fully encrypted with a strong key.\nNo evidence of access; device locked before any login attempt.\nCredentials rotated within 90 minutes of report."
            ]
          ],
          "options": [
            "Yes \u2014 any lost device is automatically a breach",
            "Likely not a data exposure: encryption at rest kept the data unreadable, access was locked out quickly, and there is no evidence of compromise \u2014 document the analysis",
            "No \u2014 lost laptops never matter",
            "Delete the incident ticket to keep the metrics clean"
          ],
          "correct": 1,
          "explain": "Encryption at rest is what separates hardware loss from data exposure: without the key, the disk is unreadable. Combined with quick lockout and no evidence of access, the analysis supports a lost-device incident rather than a breach \u2014 but the analysis must be written down, not assumed."
        },
        {
          "symptom": "Leadership asks what prevents the next lost laptop from being worse.",
          "evidence": [
            [
              "Gap review",
              "Encryption: enabled (good). Backups: user kept files only on the laptop. Cable locks: never issued."
            ]
          ],
          "options": [
            "Ban laptops entirely",
            "Hope people are more careful next time",
            "Keep encryption enforced, add automatic cloud backup so no data lives only on the device, and issue cable locks with a reminder campaign",
            "Encrypt the laptop twice"
          ],
          "correct": 2,
          "explain": "Layered, practical fixes: encryption stays mandatory, backups remove the single-copy risk, and simple physical habits reduce loss in the first place. Prevention that people will actually follow beats perfect policies nobody follows."
        }
      ],
      "debrief": "You reported fast, reasoned about encryption correctly, and closed with practical prevention. Lost devices are inevitable; breaches from them are optional.",
      "points": 30
    },
    {
      "id": "cc-sim-3",
      "title": "The stranger at the door",
      "kind": "troubleshoot",
      "domain_id": "access-control",
      "difficulty": 1,
      "brief": "You are badging into the office on a Monday morning. A stranger with a delivery box follows close behind you through the secure door, smiling. No badge visible. Decide what to do.",
      "steps": [
        {
          "symptom": "Stranger follows you through the badge-controlled door, carrying a box, no visible badge, friendly and in a hurry.",
          "evidence": [
            [
              "Observation",
              "No badge or visitor sticker visible.\nClaims: 'delivery for the 4th floor.'\nBehavior: positioned to slip through before the door closes."
            ]
          ],
          "options": [
            "Let them through \u2014 they have a box and seem legitimate",
            "Confront them aggressively and demand ID on the spot",
            "Ignore them \u2014 security is someone else's job",
            "Politely stop them: explain the badge policy and direct them to reception to sign in and get a visitor badge"
          ],
          "correct": 3,
          "explain": "Tailgating defeats every electronic control with a smile. The correct response is polite but firm: everyone badges individually, and visitors go through reception. You are not accusing them \u2014 you are enforcing a rule that applies to everyone, which is what makes it enforceable."
        },
        {
          "symptom": "At reception, the visitor has no delivery paperwork and becomes evasive, then leaves quickly when asked to wait for security.",
          "evidence": [
            [
              "Reception log",
              "No appointment on record. No delivery scheduled.\nVisitor left before security arrived."
            ]
          ],
          "options": [
            "Forget about it \u2014 they left, so no harm done",
            "Report the incident to security with a description and the time, so it is logged and the team can check for related attempts",
            "Chase them into the parking lot",
            "Post their photo on social media"
          ],
          "correct": 1,
          "explain": "The attempt failed, but the intelligence matters: security logs the description, checks cameras, and watches for repeat attempts or an accomplice already inside. Reporting failed attempts is how patterns get caught \u2014 silence teaches the team nothing."
        },
        {
          "symptom": "Security asks what would make tailgating harder across the building.",
          "evidence": [
            [
              "Building review",
              "Doors: badge readers, but they stay open 10+ seconds.\nCulture: most staff hold doors for anyone behind them."
            ]
          ],
          "options": [
            "Shorten door-open times, run a friendly awareness reminder about the badge rule, and consider turnstiles or mantraps at main entrances",
            "Remove all the doors",
            "Hire a guard to follow every employee",
            "Nothing \u2014 the policy already exists on paper"
          ],
          "correct": 0,
          "explain": "Physical security is technology plus culture: faster doors and turnstiles raise the bar, but the durable fix is a culture where challenging tailgaters is normal and praised. A policy nobody follows is decoration."
        }
      ],
      "debrief": "You enforced the badge rule politely, reported the attempt, and suggested fixes that address both the doors and the culture. Physical security is everyone's job \u2014 including yours.",
      "points": 30
    }
  ],
  "consoleSims": [
    {
      "id": "cc-csim-1",
      "title": "Triage the impossible-travel alert",
      "console": "siem-dashboard",
      "domain_id": "isc2-cc",
      "difficulty": 1,
      "brief": "ALT-101: a user logged in from two countries an hour apart \u2014 classic impossible travel, severity high. As the on-call analyst, acknowledge it and assign it to j.chen for review.",
      "tasks": [
        {
          "id": "t1",
          "instruction": "Acknowledge alert ALT-101.",
          "validate": {
            "action": "acknowledge-alert",
            "params": {
              "id": "ALT-101"
            }
          },
          "hint": "Alerts tab \u2192 click Ack on the ALT-101 row."
        },
        {
          "id": "t2",
          "instruction": "Assign ALT-101 to analyst j.chen.",
          "validate": {
            "action": "assign-alert",
            "params": {
              "id": "ALT-101",
              "analyst": "j.chen"
            }
          },
          "hint": "Assign alert form: ALERT ID=ALT-101, ANALYST=j.chen"
        }
      ],
      "debrief": "Impossible travel is a textbook account-compromise indicator. Acknowledging takes ownership; assigning routes it to a human \u2014 the first two steps of the incident-response lifecycle."
    },
    {
      "id": "cc-csim-2",
      "title": "Report the lost access badge",
      "console": "ticketing",
      "domain_id": "isc2-cc",
      "difficulty": 1,
      "brief": "You lost your Building B access badge in the parking lot. Physical security is cybersecurity: file a P3 ticket, note that the badge was deactivated, and resolve it once the reissue is scheduled.",
      "tasks": [
        {
          "id": "t1",
          "instruction": "Create a P3 ticket titled exactly: Lost access badge \u2014 Building B",
          "validate": {
            "action": "create-ticket",
            "params": {
              "title": "Lost access badge \u2014 Building B",
              "priority": "P3"
            }
          },
          "hint": "New ticket tab \u2014 copy the title exactly, it becomes INC-9002."
        },
        {
          "id": "t2",
          "instruction": "Add the note: Badge deactivated in access system; reissue scheduled.",
          "validate": {
            "action": "add-note",
            "params": {
              "id": "INC-9002",
              "text": "Badge deactivated in access system; reissue scheduled."
            }
          },
          "hint": "Add note form with the exact text."
        },
        {
          "id": "t3",
          "instruction": "Resolve INC-9002.",
          "validate": {
            "action": "resolve-ticket",
            "params": {
              "id": "INC-9002"
            }
          },
          "hint": "Click the Resolve button on the INC-9002 row."
        }
      ],
      "debrief": "Access control isn't just passwords \u2014 badges are physical credentials. Reporting a lost one fast and deactivating it is the same instinct as rotating a compromised password."
    },
    {
      "id": "cc-csim-3",
      "title": "Contain the exfiltrating backup server",
      "console": "siem-dashboard",
      "domain_id": "isc2-cc",
      "difficulty": 2,
      "brief": "ALT-103: unusual outbound volume from srv-backup-02, severity medium. Backup servers shouldn't phone home to strangers. Acknowledge the alert, isolate the host to stop any exfiltration, then escalate.",
      "tasks": [
        {
          "id": "t1",
          "instruction": "Acknowledge alert ALT-103.",
          "validate": {
            "action": "acknowledge-alert",
            "params": {
              "id": "ALT-103"
            }
          },
          "hint": "Alerts tab \u2192 click Ack on the ALT-103 row."
        },
        {
          "id": "t2",
          "instruction": "Isolate host srv-backup-02.",
          "validate": {
            "action": "isolate-host",
            "params": {
              "host": "srv-backup-02"
            }
          },
          "hint": "Click 'Isolate host' on the ALT-103 row."
        },
        {
          "id": "t3",
          "instruction": "Escalate alert ALT-103.",
          "validate": {
            "action": "escalate",
            "params": {
              "id": "ALT-103"
            }
          },
          "hint": "Click Escalate on the ALT-103 row."
        }
      ],
      "debrief": "Data exfiltration is one of the two things attackers want (the other is persistence). Isolating first contains the damage; the escalated alert carries the evidence trail to the IR team."
    },
    {
      "id": "cc-csim-4",
      "title": "Blocklist the SSH scanner",
      "console": "firewall",
      "domain_id": "isc2-cc",
      "difficulty": 2,
      "brief": "A scanner at 203.0.113.77 is probing SSH (TCP 22) on this host. Drop SSH from that source \u2014 but keep the web management portal (TCP 443) reachable from the corporate network 10.0.0.0/8.",
      "tasks": [
        {
          "id": "t1",
          "instruction": "DROP TCP 22 from 203.0.113.77.",
          "validate": {
            "action": "add-rule",
            "params": {
              "chain": "INPUT",
              "protocol": "tcp",
              "port": "22",
              "source": "203.0.113.77",
              "action": "DROP"
            }
          },
          "hint": "CHAIN=INPUT, PROTOCOL=tcp, PORT=22, SOURCE=203.0.113.77, ACTION=DROP"
        },
        {
          "id": "t2",
          "instruction": "ACCEPT TCP 443 from 10.0.0.0/8.",
          "validate": {
            "action": "add-rule",
            "params": {
              "chain": "INPUT",
              "protocol": "tcp",
              "port": "443",
              "source": "10.0.0.0/8",
              "action": "ACCEPT"
            }
          },
          "hint": "Same form with PORT=443, SOURCE=10.0.0.0/8, ACTION=ACCEPT \u2014 legitimate management stays up."
        }
      ],
      "debrief": "Network-layer controls are the cheapest win in defense-in-depth: one rule stops the scanner, another keeps legitimate management working. Precision beats blanket blocking."
    }
  ],
  "foundations": [
    {
      "track": "principles",
      "why_needed": "The CIA triad \u2014 confidentiality, integrity, availability \u2014 is the vocabulary of the entire CC exam. Get these three words and what they protect straight before anything else."
    },
    {
      "track": "bcdr",
      "why_needed": "Threat, vulnerability, and risk get mixed up by every beginner. A two-minute refresher on what each word means makes the Business Continuity and Security Principles domains click."
    }
  ],
