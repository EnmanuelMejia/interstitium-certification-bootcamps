        {
          "id": "cc-data-labels",
          "title": "The spreadsheet marked confidential",
          "situation": "The company labels data as Public, Internal, or Confidential. A new employee wonders why a customer list marked Confidential cannot be emailed to a personal account for weekend work.",
          "prompt": "Why does classification matter?",
          "choices": [
            "Labels are decoration \u2014 data is data",
            "Only the CEO may see Confidential data",
            "Public data needs the strongest protection",
            "Classification drives handling rules: Confidential data gets encryption, sharing limits, and retention rules matched to its sensitivity"
          ],
          "answer": 3,
          "why": "Data classification assigns each type of information a sensitivity level, and each level carries handling rules: how it is stored, shared, encrypted, and eventually destroyed. Without labels, everything is treated the same \u2014 which means the crown jewels get the same protection as the lunch menu.",
          "hint": "Should the lunch menu and the customer database be protected identically?",
          "objectives": [
            "Data classification",
            "Data handling",
            "Data lifecycle"
          ],
          "mins": 6
        },
        {
          "id": "cc-laptop-encryption",
          "title": "The laptop left on the train",
          "situation": "An employee leaves a laptop on a train. It holds customer records \u2014 but the entire disk was encrypted, and the loss is reported within the hour so the password can be rotated and the device remotely locked.",
          "prompt": "Why is this incident a recovery story instead of a data breach?",
          "choices": [
            "The train company is trustworthy",
            "Full-disk encryption keeps the data unreadable without the key \u2014 a lost encrypted device is a hardware loss, not a data exposure",
            "Customer records are not sensitive",
            "Encryption only matters for email"
          ],
          "answer": 1,
          "why": "Encryption at rest protects data on lost or stolen devices: without the key, the disk is scrambled noise to whoever finds it. Paired with quick reporting, remote lock, and credential rotation, the incident stays a lost laptop instead of becoming a breach notification. Encrypt mobile devices by default \u2014 loss is a matter of when.",
          "hint": "What can the finder actually read on that disk?",
          "objectives": [
            "Encryption at rest",
            "Mobile device security",
            "Incident reporting"
          ],
          "mins": 6
        },
        {
          "id": "cc-siem-intro",
          "title": "The one screen that watches everything",
          "situation": "A small security team is drowning in separate logs from firewalls, servers, and laptops. They deploy a SIEM that pulls the logs into one place and raises alerts on suspicious patterns.",
          "prompt": "What value does the SIEM add for a junior analyst?",
          "choices": [
            "Centralized collection plus correlation and alerting: one place to search, and patterns across sources surface automatically instead of checking devices one by one",
            "It replaces analysts entirely \u2014 the SIEM makes all decisions",
            "It makes the logs prettier",
            "It deletes old logs to save disk space"
          ],
          "answer": 0,
          "why": "A SIEM (security information and event management) centralizes logs so analysts can search everything at once, and its correlation rules connect events across sources into meaningful alerts. It does not replace judgment \u2014 it focuses it: fewer places to look, higher-quality leads to investigate.",
          "hint": "What is harder: checking fifty devices, or searching one screen?",
          "objectives": [
            "SIEM",
            "Log centralization",
            "Alerting"
          ],
          "mins": 6
        }
      ]
