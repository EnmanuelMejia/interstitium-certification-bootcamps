  "behavioral": [
    {
      "prompt": "Tell me about a time you learned a difficult technical concept quickly. How did you approach it?",
      "framework": "STAR",
      "points": [
        "The concept and why it was hard for you",
        "Your specific learning method \u2014 labs, docs, teaching it back",
        "How you proved you actually understood it"
      ],
      "pitfalls": [
        "Saying you just watched videos with no practice",
        "No evidence you retained it"
      ]
    },
    {
      "prompt": "Describe a time you noticed something suspicious \u2014 at work, school, or online \u2014 and what you did about it.",
      "framework": "STAR",
      "points": [
        "What caught your attention and why it felt off",
        "The exact steps you took \u2014 verify, report, contain",
        "The outcome and what you would do the same or differently"
      ],
      "pitfalls": [
        "Ignoring it and hoping someone else handled it",
        "Overreacting without verifying first"
      ]
    },
    {
      "prompt": "Tell me about a time you had to follow strict rules or procedures even when it was inconvenient.",
      "framework": "STAR",
      "points": [
        "The rule and why it felt inconvenient in the moment",
        "Why you followed it anyway",
        "What the experience taught you about process"
      ],
      "pitfalls": [
        "Admitting you bent the rule",
        "Resenting the process with no understanding of its purpose"
      ]
    },
    {
      "prompt": "Describe a time you explained something technical to someone non-technical.",
      "framework": "STAR",
      "points": [
        "The concept and who your audience was",
        "How you adapted \u2014 analogies, plain language, checking understanding",
        "Whether they actually got it, and how you knew"
      ],
      "pitfalls": [
        "Using jargon and calling it an explanation",
        "No check that the audience understood"
      ]
    },
    {
      "prompt": "Tell me about a time you made a mistake involving important information or access. What happened and what changed?",
      "framework": "STAR",
      "points": [
        "The mistake, owned honestly and briefly",
        "How you contained it and who you told",
        "The lasting change \u2014 checklist, habit, or process"
      ],
      "pitfalls": [
        "Hiding the mistake or minimizing it",
        "No change afterward \u2014 same risk remains"
      ]
    },
    {
      "prompt": "Describe a time you worked with a team under a tight deadline.",
      "framework": "STAR",
      "points": [
        "The deadline and what was at stake",
        "Your specific role and how you coordinated with others",
        "The result and what the pressure taught you"
      ],
      "pitfalls": [
        "Taking all the credit or blaming the team",
        "No reflection on teamwork itself"
      ]
    },
    {
      "prompt": "Tell me about a time you helped someone who was frustrated with technology.",
      "framework": "STAR",
      "points": [
        "The person's frustration and what was actually wrong",
        "How you helped \u2014 patience, clear steps, follow-up",
        "The outcome and what it taught you about users"
      ],
      "pitfalls": [
        "Being condescending about their skill level",
        "Fixing it without teaching anything"
      ]
    },
    {
      "prompt": "Why are you pursuing a cybersecurity career, and what have you done in the last 90 days to prepare?",
      "framework": "STAR",
      "points": [
        "A genuine motivation \u2014 what draws you to this work",
        "Concrete recent actions \u2014 study, labs, this course, projects",
        "How those actions connect to entry-level security work"
      ],
      "pitfalls": [
        "Generic answer anyone could give",
        "No evidence of recent effort"
      ]
    }
  ],
  "chat": {
    "persona": "You are a friendly and encouraging ISC2 Certified in Cybersecurity (CC) study coach running a mock assessment for a beginner. Keep language simple and jargon-light, celebrate good reasoning, correct misconceptions gently, and tie everything back to the five CC domains. Never reproduce real exam questions; teach the underlying concepts with original everyday examples.",
    "topics": [
      {
        "id": "principles",
        "name": "Security Principles",
        "key_points": [
          "CIA triad",
          "authentication factors",
          "MFA",
          "symmetric",
          "asymmetric",
          "hashing"
        ],
        "followups": [
          "Can you explain the CIA triad in your own words?",
          "Why is a password plus a phone prompt stronger than two passwords?"
        ]
      },
      {
        "id": "bcdr",
        "name": "Business Continuity & Incident Response",
        "key_points": [
          "BCP",
          "DRP",
          "backups",
          "offline copy",
          "RTO",
          "RPO"
        ],
        "followups": [
          "What is the first thing you do when you find malware?",
          "Why must backups be offline or off-site?"
        ]
      },
      {
        "id": "access-control",
        "name": "Access Control Concepts",
        "key_points": [
          "DAC",
          "MAC",
          "RBAC",
          "least privilege",
          "need-to-know",
          "separation of duties"
        ],
        "followups": [
          "Who decides access in each of the three models?",
          "What would you do if a stranger followed you through the badge door?"
        ]
      },
      {
        "id": "network-security",
        "name": "Network Security",
        "key_points": [
          "firewall",
          "segmentation",
          "guest Wi-Fi",
          "VPN",
          "WPA2",
          "WPA3"
        ],
        "followups": [
          "What does a firewall actually do?",
          "Why shouldn't guests share the business network?"
        ]
      },
      {
        "id": "sec-operations",
        "name": "Security Operations",
        "key_points": [
          "logging",
          "SIEM",
          "patching",
          "hardening",
          "default credentials",
          "phishing"
        ],
        "followups": [
          "Why do logs matter before anything goes wrong?",
          "What do you do with a suspicious email?"
        ]
      }
    ]
  },
  "labs": [
    {
      "id": "cc-lab-1",
      "title": "Your first hash",
      "objective": "Compute SHA-256 fingerprints of two similar strings and see why hashing is the integrity tool of the trade.",
      "steps": [
        "This lab reworks the Security Principles scenario 'The breached database with no passwords in it' into commands you run yourself.",
        "Open the Terminal tab for this bootcamp \u2014 every command below runs there.",
        "Type exactly: echo -n \"hello\" | sha256sum \u2014 the fingerprint of that input",
        "Type exactly: echo -n \"hallo\" | sha256sum \u2014 one letter different, a totally different fingerprint",
        "In your own words, say why a system can verify your password with a hash without ever storing the password."
      ],
      "checks": [
        {
          "command_pattern": "echo -n \"hello\" | sha256sum",
          "expect_contains": "2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824",
          "hint": "In the Terminal tab, run `echo -n \"hello\" | sha256sum`. If the check fails, confirm you typed it exactly \u2014 including the -n flag and the quotes."
        }
      ],
      "success_message": "Lab complete \u2014 you fingerprinted data with SHA-256. One-way, unique, and verifiable: that is hashing."
    },
    {
      "id": "cc-lab-2",
      "title": "Spot the failed logins",
      "objective": "Search the authentication log for failed login attempts \u2014 the first thing an analyst checks when something feels wrong.",
      "steps": [
        "This lab reworks the Security Operations scenario 'The break-in with no witnesses' into commands you run yourself: logs are the witnesses.",
        "Open the Terminal tab for this bootcamp \u2014 every command below runs there.",
        "Type exactly: grep \"Failed password\" /var/log/auth.log | head -10 \u2014 the first ten failed login lines",
        "Look at the usernames and source addresses in the output \u2014 do they look like real users mistyping?",
        "Type exactly: grep -c \"Failed password\" /var/log/auth.log \u2014 how many failures total",
        "Decide in your own words: normal noise, or something worth reporting?"
      ],
      "checks": [
        {
          "command_pattern": "grep \"Failed password\" /var/log/auth.log",
          "expect_contains": "Failed password",
          "hint": "In the Terminal tab, run `grep \"Failed password\" /var/log/auth.log`. The matching lines themselves contain that phrase."
        }
      ],
      "success_message": "Lab complete \u2014 you read an auth log like an analyst: look at the evidence before deciding what it means."
    },
    {
      "id": "cc-lab-3",
      "title": "Who can read this file?",
      "objective": "Read Linux file permissions with ls -l and judge whether a shared folder is shared too widely.",
      "steps": [
        "This lab makes least privilege concrete: permissions you can see are permissions you can audit.",
        "Open the Terminal tab for this bootcamp \u2014 a shared folder /srv/shared is waiting with a file grades.csv inside.",
        "Type exactly: ls -l /srv/shared \u2014 the permission string, owner, and group for each file",
        "Read the first column (like -rw-rw-rw-): who can read, write, and execute? Does everyone really need write access to grades.csv?",
        "In your own words, say what you would change and why."
      ],
      "checks": [
        {
          "command_pattern": "ls -l /srv/shared",
          "expect_contains": "grades.csv",
          "hint": "In the Terminal tab, run `ls -l /srv/shared`. The listing names the files, including grades.csv."
        }
      ],
      "success_message": "Lab complete \u2014 you audited permissions with your own eyes. Least privilege starts with looking."
    },
    {
      "id": "cc-lab-4",
      "title": "See what is listening",
      "objective": "List the network services listening on the machine and ask whether each one should be there.",
      "steps": [
        "This lab builds the attack-surface habit from the Network Security domain: know your open doors.",
        "Open the Terminal tab for this bootcamp \u2014 every command below runs there.",
        "Type exactly: ss -tlnp \u2014 TCP sockets in the listening state",
        "For each LISTEN line, ask: do I recognize this service, and does it need to face the network?",
        "Write down one service you would investigate further, and why."
      ],
      "checks": [
        {
          "command_pattern": "ss -tlnp",
          "expect_contains": "LISTEN",
          "hint": "In the Terminal tab, run `ss -tlnp`. Listening sockets show the LISTEN state."
        }
      ],
      "success_message": "Lab complete \u2014 you enumerated listening services. Fewer open doors, fewer break-ins."
    },
    {
      "id": "cc-lab-5",
      "title": "Confirm the backup exists",
      "objective": "Verify that backups actually exist, are recent, and are stored where a disaster cannot reach them.",
      "steps": [
        "This lab reworks the Business Continuity scenario 'The bakery that baked through ransomware': a backup you have never checked is a rumor.",
        "Open the Terminal tab for this bootcamp \u2014 every command below runs there.",
        "Type exactly: ls -lh /backups/ \u2014 the backup files, their sizes, and their dates",
        "Ask: is the newest backup recent enough for the business? Would ransomware on the main system reach these files?",
        "In your own words, say what makes a backup trustworthy."
      ],
      "checks": [
        {
          "command_pattern": "ls -lh /backups/",
          "expect_contains": "backup",
          "hint": "In the Terminal tab, run `ls -lh /backups/`. The listing names the backup files."
        }
      ],
      "success_message": "Lab complete \u2014 you verified a backup instead of assuming one. That is continuity you can trust."
    },
    {
      "id": "isc2-cc-lab1",
      "domain_id": "principles",
      "title": "Classify the Controls",
      "objective": "Build a list of security controls in the terminal and classify each by function (preventive, detective, corrective) and category (physical, administrative, technical) using shell commands.",
      "steps": [
        "Create the control list: `printf 'mantrap\\nCCTV\\nbackup\\nvisitor-policy\\nfirewall\\n' > controls.txt` and confirm with `cat controls.txt`.",
        "Find the preventive physical control with `grep -i mantrap controls.txt` \u2014 a mantrap stops tailgating before it happens.",
        "Find the detective control with `grep -i cctv controls.txt` \u2014 cameras record events for later review.",
        "Find the corrective control with `grep -i backup controls.txt` \u2014 backups restore operations after an incident.",
        "Classify the remaining two yourself: is the visitor-policy administrative or technical? Is the firewall preventive or detective?"
      ],
      "checks": [
        {
          "command_pattern": "grep.*-i.*mantrap|grep.*mantrap",
          "expect_contains": "mantrap",
          "hint": "Run grep for the mantrap entry: `grep -i mantrap controls.txt`."
        },
        {
          "command_pattern": "grep.*-i.*cctv|grep.*cctv",
          "expect_contains": "CCTV",
          "hint": "Run grep for the CCTV entry: `grep -i cctv controls.txt`."
        },
        {
          "command_pattern": "grep.*-i.*backup|grep.*backup",
          "expect_contains": "backup",
          "hint": "Run grep for the backup entry: `grep -i backup controls.txt`."
        }
      ],
      "domain_id_remapped_from": "d1",
      "merged_from": "cbt-individual/isc2-cc"
    },
    {
      "id": "isc2-cc-lab2",
      "domain_id": "principles",
      "title": "Salt the Password Hash",
      "objective": "Use openssl to hash a password with two different salts and observe why salting defeats rainbow-table attacks on stolen password databases.",
      "steps": [
        "Hash a password with the first salt: `openssl passwd -6 -salt NaClSalt1 'S3cureP@ss'` and note the output starts with `$6$` (SHA-512 crypt).",
        "Hash the SAME password with a different salt: `openssl passwd -6 -salt NaClSalt2 'S3cureP@ss'`.",
        "Compare the two outputs: identical password, completely different hashes \u2014 the salt makes each hash unique.",
        "Reflect: a rainbow table precomputes hashes for common passwords, but with a unique random salt per user the attacker must recompute the table for every salt \u2014 this is why modern systems salt (and pepper/stretch with bcrypt, scrypt, or Argon2)."
      ],
      "checks": [
        {
          "command_pattern": "openssl\\s+passwd",
          "expect_contains": "$6$",
          "hint": "Hash a password with SHA-512 crypt: `openssl passwd -6 -salt <salt> '<password>'`. The output begins with $6$."
        }
      ],
      "domain_id_remapped_from": "d3",
      "merged_from": "cbt-individual/isc2-cc"
    },
    {
      "id": "isc2-cc-lab3",
      "domain_id": "principles",
      "title": "Audit the Firewall Ruleset",
      "objective": "Write a small firewall ruleset to a file, then use grep to find every permitted service and flag the rules that violate least privilege.",
      "steps": [
        "Create the ruleset: `printf 'ALLOW tcp 22 from 10.0.0.0/8\\nALLOW tcp 80 from any\\nALLOW tcp 443 from any\\nALLOW tcp 23 from any\\nALLOW tcp 3389 from any\\nDENY all\\n' > fw-rules.txt`.",
        "List every permitted service: `grep ALLOW fw-rules.txt`.",
        "Identify the dangerous findings: Telnet (port 23) transmits credentials in cleartext, and RDP (port 3389) open to `any` invites brute force.",
        "State the remediation aloud: remove the Telnet rule entirely, and restrict RDP to the management subnet or require VPN plus MFA."
      ],
      "checks": [
        {
          "command_pattern": "grep\\s+ALLOW",
          "expect_contains": "23",
          "hint": "List the permitted rules with `grep ALLOW fw-rules.txt` and look for port 23 (Telnet)."
        }
      ],
      "domain_id_remapped_from": "d4",
      "merged_from": "cbt-individual/isc2-cc"
    },
    {
      "id": "isc2-cc-lab4",
      "domain_id": "principles",
      "title": "Prove the File Was Not Altered",
      "objective": "Use SHA-256 hashing to detect tampering: hash a file, modify one byte, hash again, and observe the avalanche effect that underpins integrity controls.",
      "steps": [
        "Create the file: `printf 'Contract v3 - payment 50000\\n' > contract.txt`.",
        "Record its digest: `openssl dgst -sha256 contract.txt` \u2014 the output line begins with `SHA2-256(contract.txt)=`.",
        "Tamper with one byte: `printf 'Contract v3 - payment 90000\\n' > contract.txt`.",
        "Hash again: `openssl dgst -sha256 contract.txt` and compare \u2014 a completely different digest proves the file changed.",
        "Connect the concept: this is exactly how file-integrity monitoring and signed software updates detect unauthorized modification."
      ],
      "checks": [
        {
          "command_pattern": "openssl\\s+dgst",
          "expect_contains": "SHA2-256",
          "hint": "Compute the file's SHA-256 digest: `openssl dgst -sha256 contract.txt`."
        }
      ],
      "domain_id_remapped_from": "d5",
      "merged_from": "cbt-individual/isc2-cc"
    }
  ],
