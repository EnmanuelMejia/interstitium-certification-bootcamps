  },
  "disclaimer": "Independent practice material by Interstitium Labs. Not affiliated with, endorsed by, or sponsored by ISC2. Confers no certificate. All scenarios are original; no exam content is reproduced.",
  "accent": "#35c48d",
  "simulation": {
    "items": 40,
    "minutes": 60
  },
  "domains": [
    {
      "id": "principles",
      "name": "Security Principles",
      "scenarios": [
        {
          "id": "cc-cia-clinic",
          "title": "The clinic's three promises",
          "situation": "A small clinic asks you what information security means for their patient records. The manager wants one plain-language explanation they can share with staff.",
          "prompt": "Which explanation correctly maps the CIA triad?",
          "choices": [
            "Confidentiality means the records are backed up, integrity means they are encrypted, availability means everyone can see them",
            "Confidentiality, integrity, and availability are three brands of firewall",
            "Confidentiality means only authorized staff see the records, integrity means the records are not altered, availability means the systems work when patients arrive",
            "The triad only applies to hospitals, not small clinics"
          ],
          "answer": 2,
          "why": "Confidentiality protects information from unauthorized eyes, integrity protects it from unauthorized change, and availability keeps it usable when needed. The three words are a checklist: for any system, ask who should see it, whether it could be tampered with, and whether it will be there when needed.",
          "hint": "Match each word to its plain meaning: secret, unaltered, reachable.",
          "objectives": [
            "CIA triad",
            "Foundational vocabulary"
          ],
          "mins": 5
        },
        {
          "id": "cc-mfa-factors",
          "title": "Two proofs are better than one",
          "situation": "A new employee logs in with a password, then taps approve on a prompt sent to their phone. A coworker says that is two-factor authentication; another says it is just logging in twice.",
          "prompt": "Who is right, and why?",
          "choices": [
            "The first coworker \u2014 the password is something you know and the phone is something you have: two different factor types",
            "The second coworker \u2014 typing a password and tapping a phone are the same thing done twice",
            "Neither \u2014 multi-factor requires three factors minimum",
            "Both \u2014 the terms mean the same thing"
          ],
          "answer": 0,
          "why": "Authentication factors are categories: something you know (password), something you have (phone, token), something you are (fingerprint). Multi-factor means combining different categories, so stealing one is not enough. A password plus a password hint is still one factor.",
          "hint": "Count the categories of proof, not the number of steps.",
          "objectives": [
            "Authentication factors",
            "MFA"
          ],
          "mins": 5
        },
        {
          "id": "cc-mfa-stolen-password",
          "title": "The stolen password that went nowhere",
          "situation": "An attacker buys a user's password from a breach dump and tries it on the company portal. The login fails because the portal also requires approving a push notification on the user's phone.",
          "prompt": "Why did multi-factor authentication stop the attacker?",
          "choices": [
            "The second factor is something the attacker does not have \u2014 a correct password alone is no longer enough",
            "The password was too short for the attacker to type correctly",
            "Breach dumps never contain real passwords",
            "The portal was offline during the attack"
          ],
          "answer": 0,
          "why": "Passwords leak constantly through breaches, phishing, and reuse. MFA adds a second, independent proof \u2014 usually possession of a device \u2014 so a stolen password alone cannot complete the login. It is the single highest-value control most organizations can deploy.",
          "hint": "What did the attacker have, and what were they missing?",
          "objectives": [
            "MFA",
            "Password risks"
          ],
          "mins": 5
        },
        {
          "id": "cc-public-private-key",
          "title": "The lock anyone can close",
          "situation": "A job applicant needs to send sensitive documents to a hiring manager securely. The manager publishes a public key and keeps a private key secret.",
          "prompt": "How should the applicant protect the documents?",
          "choices": [
            "Encrypt with the manager's private key, which the manager should share first",
            "The public key decrypts, so send the documents in the clear and share the public key separately",
            "Public and private keys are identical, so either one works for everything",
            "Encrypt with the manager's public key \u2014 only the manager's private key can open them"
          ],
          "answer": 3,
          "why": "In asymmetric cryptography the keys are a matched pair with opposite jobs: the public key encrypts (anyone can lock), the private key decrypts (only the owner can open). The public key is shared freely; the private key is never shared. That is what makes secure communication with strangers possible.",
          "hint": "Which key is safe to publish, and what job does each key do?",
          "objectives": [
            "Asymmetric cryptography",
            "Public/private keys"
          ],
          "mins": 6
        },
        {
          "id": "cc-hash-passwords",
          "title": "The breached database with no passwords in it",
          "situation": "A website is breached and its user database is stolen. The attackers find passwords stored as salted hashes, not plain text, and cannot log in as users.",
          "prompt": "Why do systems store hashes instead of the actual passwords?",
          "choices": [
            "Hashes are faster to type than passwords",
            "Hashes make passwords impossible for users to forget",
            "Hashing lets the system verify a password without storing the secret itself \u2014 a stolen database does not hand over the passwords",
            "Storing plain text is illegal everywhere, so hashes are the only option"
          ],
          "answer": 2,
          "why": "A hash is a one-way fingerprint: the system hashes what you type and compares it to the stored hash, so the real password never sits in the database. When (not if) the database leaks, attackers get fingerprints they cannot reverse into passwords. Salting adds uniqueness so identical passwords hash differently.",
          "hint": "What does the system actually compare when you log in?",
          "objectives": [
            "Hashing",
            "Password storage"
          ],
          "mins": 6
        },
        {
          "id": "cc-risk-window",
          "title": "The window left open",
          "situation": "A ground-floor office window does not lock. The neighborhood has seen several break-ins recently. The office manager asks whether this is actually a security risk worth fixing.",
          "prompt": "What is the risk here, and what reduces it most directly?",
          "choices": [
            "There is no risk \u2014 windows are not IT equipment",
            "The risk is the window itself; remove all windows",
            "Only the break-in statistics matter; the window is irrelevant",
            "The risk is the chance that the threat (burglars) exploits the vulnerability (unlocked window); locking or securing the window reduces it"
          ],
          "answer": 3,
          "why": "Risk is the potential that a threat exploits a vulnerability to cause harm. The threat is the burglar, the vulnerability is the unlocked window, and the risk is the combination. You reduce risk by addressing either side \u2014 remove the vulnerability (lock the window) or reduce the threat \u2014 and the cheapest effective fix usually targets the vulnerability.",
          "hint": "Name the threat, name the weakness, then see how they combine.",
          "objectives": [
            "Risk concepts",
            "Threat vs vulnerability"
          ],
          "mins": 6
        },
        {
          "id": "cc-least-privilege-intern",
          "title": "The intern with the master key",
          "situation": "To make onboarding easier, IT gives a new intern full administrator access to every system on day one. The intern only needs email and the shared drive.",
          "prompt": "What principle does this violate, and what is the danger?",
          "choices": [
            "Availability \u2014 the intern will slow the systems down",
            "Encryption \u2014 the intern's laptop is not encrypted",
            "Least privilege \u2014 grant only the access needed for the job; extra access magnifies both mistakes and breaches",
            "No principle \u2014 more access is always better for productivity"
          ],
          "answer": 2,
          "why": "Least privilege means every person and process gets the minimum access needed \u2014 nothing more. An intern with admin rights can accidentally (or maliciously) cause damage far beyond their role, and if their account is compromised, the attacker inherits the keys to everything. Start small; add access only with justification.",
          "hint": "What happens when this account \u2014 or its mistakes \u2014 gets more power than the job needs?",
          "objectives": [
            "Least privilege",
            "Access provisioning"
          ],
          "mins": 5
        }
      ]
    },
    {
      "id": "bcdr",
      "name": "Business Continuity & Incident Response",
      "scenarios": [
        {
          "id": "cc-backup-bakery",
          "title": "The bakery that baked through ransomware",
          "situation": "A bakery's order computer is hit by ransomware and every file is encrypted. The owner plugs in an external drive that is normally kept unplugged in a drawer, restores the files, and is taking orders again by lunch.",
          "prompt": "What saved the bakery, and what made the backup trustworthy?",
          "choices": [
            "Luck \u2014 ransomware usually decrypts itself after a few hours",
            "Offline backups plus a restore plan \u2014 the drive was disconnected so the malware could not reach it, and the owner knew how to restore",
            "The antivirus \u2014 it silently fixed everything",
            "Paying the ransom quickly \u2014 the attackers sent the key"
          ],
          "answer": 1,
          "why": "Backups only save you if the disaster cannot reach them: an offline or disconnected copy survives ransomware that encrypts everything on the network. And a backup you have never restored is a rumor \u2014 the owner had practiced the restore, so recovery took hours instead of weeks.",
          "hint": "Why didn't the ransomware encrypt the external drive too?",
          "objectives": [
            "Backup strategies",
            "Offline backups",
            "Recovery"
          ],
          "mins": 6
        },
        {
          "id": "cc-rto-rpo",
          "title": "Four hours or the wedding cakes do not ship",
          "situation": "A bakery manager tells IT: if the order system is down more than four hours, the day's revenue is lost \u2014 and they can afford to lose at most one hour of entered orders.",
          "prompt": "What are these two requirements called?",
          "choices": [
            "RTO of four hours (how fast it must be back) and RPO of one hour (how much data loss is tolerable)",
            "RPO of four hours and RTO of one hour \u2014 time and data are the same thing",
            "An SLA and a password policy",
            "Two ways of saying the system must never fail"
          ],
          "answer": 0,
          "why": "Recovery Time Objective (RTO) is how long the business can survive without the system; Recovery Point Objective (RPO) is how much data it can afford to lose, which sets how often backups must run. The business states them, IT builds recovery to meet them.",
          "hint": "Which number is about the clock, and which is about the data?",
          "objectives": [
            "RTO",
            "RPO",
            "Business impact analysis"
          ],
          "mins": 6
        },
        {
          "id": "cc-ir-dont-wipe",
          "title": "Do not pull the plug just yet",
          "situation": "An employee sees a malware alert on their PC and is about to wipe the machine completely to get back to work. A coworker stops them and says to call IT first.",
          "prompt": "What is the correct first response, and why not wipe immediately?",
          "choices": [
            "Wipe it \u2014 speed matters more than anything",
            "Ignore the alert \u2014 antivirus handles everything silently",
            "Disconnect from the network, leave the machine on, and report it \u2014 wiping destroys evidence of how the malware arrived and whether it spread",
            "Email the malware to a friend to get a second opinion"
          ],
          "answer": 2,
          "why": "The first move in incident response is containment: disconnect the machine so the malware cannot spread, while preserving the system for investigation. Wiping first destroys the evidence that shows how the infection happened \u2014 and whether other machines are infected too. Report, contain, then let the response process decide.",
          "hint": "If you wipe it, what questions can nobody ever answer?",
          "objectives": [
            "Incident response",
            "Containment",
            "Evidence preservation"
          ],
          "mins": 6
        },
        {
          "id": "cc-bcp-vs-drp",
          "title": "The plan for the people vs the plan for the computers",
          "situation": "A burst pipe floods the office. Staff need somewhere to work on Monday, and the servers need to be brought back online. The manager pulls out two plans: the BCP and the DRP.",
          "prompt": "What is the difference between the two plans?",
          "choices": [
            "They are identical \u2014 the names are interchangeable",
            "The BCP is for computers and the DRP is for people",
            "Only large companies need either plan",
            "The business continuity plan keeps the business running (alternate site, communications, key processes); the disaster recovery plan restores the IT systems"
          ],
          "answer": 3,
          "why": "Business continuity is about the business: where people work, how customers are served, which processes matter most. Disaster recovery is the IT subset: restoring servers, data, and networks. DRP feeds into BCP \u2014 technology recovery serves business survival, not the other way around.",
          "hint": "Which plan cares about where the staff sit on Monday?",
          "objectives": [
            "BCP",
            "DRP",
            "Continuity planning"
          ],
          "mins": 6
        },
        {
          "id": "cc-tabletop",
          "title": "The drill with no computers",
          "situation": "The office team sits around a conference table and talks through what everyone would do if a flood hit the building. No systems are touched; it is all discussion.",
          "prompt": "What is the value of this exercise?",
          "choices": [
            "None \u2014 only real disasters teach anything",
            "It tests the plan and everyone's role cheaply: gaps in contacts, responsibilities, and decisions surface before a real crisis",
            "It replaces the need for backups",
            "It is a team-building lunch with extra steps"
          ],
          "answer": 1,
          "why": "A tabletop exercise walks the team through a scenario verbally, revealing the gaps paper plans hide: outdated phone numbers, unclear decision authority, steps nobody owns. It costs an afternoon and finds the flaws while there is still time to fix them \u2014 which is the whole point of testing plans.",
          "hint": "What is cheaper: finding the gap in a meeting, or during the flood?",
          "objectives": [
            "Tabletop exercises",
            "Plan testing"
          ],
          "mins": 5
        },
        {
          "id": "cc-evidence-laptop",
          "title": "The laptop that might be evidence",
          "situation": "A manager suspects a departing employee copied customer lists to a company laptop. IT is asked to examine it, and someone suggests just reimaging it quickly to reassign it.",
          "prompt": "What must the team NOT do, and why?",
          "choices": [
            "Do not wipe, reimage, or keep using the laptop \u2014 altering it destroys potential evidence of what was taken",
            "Do not tell the manager \u2014 investigations should be secret from everyone",
            "Do not document anything \u2014 paperwork slows investigations",
            "There are no restrictions; reimage it immediately"
          ],
          "answer": 0,
          "why": "Once a device may hold evidence, every change to it \u2014 wiping, reinstalling, even browsing \u2014 can destroy proof of what happened and when. The correct move is to stop using it, secure it, document who handles it, and let the investigation process run. Evidence you alter is evidence you lose.",
          "hint": "If this becomes a legal matter, what will lawyers ask about the laptop's history?",
          "objectives": [
            "Evidence handling",
            "Chain of custody basics"
          ],
          "mins": 6
        },
        {
          "id": "cc-lessons-learned",
          "title": "The meeting after the mess",
          "situation": "After a painful day-long outage, the team holds a meeting to discuss what went wrong and what to change. One person worries it will turn into a blame session.",
          "prompt": "What is the purpose of this meeting, and how should it be run?",
          "choices": [
            "To assign blame so people work harder next time",
            "A blameless review to improve the plan and controls so the failure does not repeat \u2014 focus on process, not people",
            "To decide who gets fired",
            "There is no purpose; outages are unavoidable"
          ],
          "answer": 1,
          "why": "The lessons-learned (post-incident) review exists to convert a painful event into durable improvements: fix the plan, add the missing control, update the runbook. Blame makes people hide mistakes; a blameless focus on process gets honest answers \u2014 and honest answers are what prevent the repeat.",
          "hint": "Do you want people to hide their mistakes, or report them?",
          "objectives": [
            "Lessons learned",
            "Post-incident review",
            "No-blame culture"
          ],
          "mins": 5
        }
      ]
    },
    {
      "id": "access-control",
      "name": "Access Control Concepts",
      "scenarios": [
        {
          "id": "cc-rbac-new-hire",
          "title": "The new hire's first day",
          "situation": "HR enters a new employee as an accountant in the identity system, and the correct email, file shares, and finance apps are provisioned automatically based on that role.",
          "prompt": "What access control model is this?",
          "choices": [
            "Discretionary access control \u2014 the employee decides their own access",
            "Role-based access control \u2014 permissions are assigned to the role, and people inherit them by being in the role",
            "Mandatory access control \u2014 the government assigned a clearance level",
            "No model \u2014 this is just convenience"
          ],
          "answer": 1,
          "why": "Role-based access control (RBAC) ties permissions to job roles rather than individuals: join the accountant role, get accountant access; change roles, and access follows automatically. It scales far better than hand-crafting permissions per person, and it makes reviews simple \u2014 audit the role, not every user.",
          "hint": "What did HR actually assign \u2014 permissions, or a job title that carries permissions?",
          "objectives": [
            "RBAC",
            "Access control models"
          ],
          "mins": 5
        },
        {
          "id": "cc-dac-owner",
          "title": "The folder owner shares",
          "situation": "A team lead shares their project folder with a contractor for two weeks, choosing exactly which files the contractor can open.",
          "prompt": "What model lets the data owner make that call?",
          "choices": [
            "Mandatory access control \u2014 the system administrator must approve every share",
            "Role-based access control \u2014 only the contractor role can be shared",
            "No control \u2014 sharing is always insecure",
            "Discretionary access control \u2014 the owner of the resource decides who gets access"
          ],
          "answer": 3,
          "why": "Discretionary access control (DAC) puts the owner in charge: the person who owns the file or folder decides who may access it. It is flexible and familiar \u2014 it is how most file sharing works \u2014 but it relies on owners making good decisions, which is why sensitive data usually needs stronger models.",
          "hint": "Who made the sharing decision \u2014 a policy, or the person who owns the folder?",
          "objectives": [
            "DAC",
            "Access control models"
          ],
          "mins": 5
        },
        {
          "id": "cc-mac-classified",
          "title": "The stamp that decides",
          "situation": "Government documents carry labels like Confidential and Secret. The system compares each user's clearance to each document's label and grants or denies access automatically \u2014 no user can override it.",
          "prompt": "What model is this?",
          "choices": [
            "Mandatory access control \u2014 the system enforces access from security labels; users cannot change the rules",
            "Discretionary \u2014 the document authors choose the readers",
            "Role-based \u2014 everyone with the same job sees the same files",
            "Voluntary \u2014 access is optional"
          ],
          "answer": 0,
          "why": "Mandatory access control (MAC) is system-enforced: labels on data (classification) and labels on users (clearance) decide access, and no user discretion can override them. It is strict and inflexible \u2014 which is exactly what environments with classified information require.",
          "hint": "Can the document owner share it with a friend anyway? That is the test.",
          "objectives": [
            "MAC",
            "Classification labels",
            "Access control models"
          ],
          "mins": 6
        },
        {
          "id": "cc-separation-duties",
          "title": "The cashier who also approves refunds",
          "situation": "One retail employee can both issue refunds and approve them. Last month, fake refunds totaling $9,000 went to an accomplice's account before anyone noticed.",
          "prompt": "What control would have prevented a single person from doing this?",
          "choices": [
            "Longer passwords for the cashier",
            "More security cameras",
            "A faster refund process",
            "Separation of duties \u2014 split the task so issuing and approving require two different people; fraud then needs collusion"
          ],
          "answer": 3,
          "why": "Separation of duties divides sensitive tasks so no single person controls a process end to end. One person issuing and another approving means fraud requires two people conspiring \u2014 far rarer and far easier to detect. It is a people-and-process control, not a technology purchase.",
          "hint": "How many people had to agree for the fraud to work? How many should it take?",
          "objectives": [
            "Separation of duties",
            "Fraud prevention"
          ],
          "mins": 6
        },
        {
          "id": "cc-tailgating",
          "title": "The friendly stranger with the coffee",
          "situation": "An employee badges into the office and a stranger carrying two coffee cups follows them through the door, smiling and saying thanks. The stranger has no badge visible.",
          "prompt": "What should the employee do?",
          "choices": [
            "Politely stop them and direct them to reception to sign in and get a visitor badge \u2014 tailgating is a classic intrusion method",
            "Hold the door \u2014 it is polite, and the coffee cups prove they work here",
            "Ignore it \u2014 physical security is the guards' problem",
            "Take a photo and post it online"
          ],
          "answer": 0,
          "why": "Tailgating (piggybacking) is one of the oldest intrusion techniques: follow an authorized person through a controlled door. The defense is cultural \u2014 every employee enforces the badge rule, politely but firmly, and visitors go through reception. Politeness is the attacker's tool; procedure is yours.",
          "hint": "What is the attacker counting on you feeling?",
          "objectives": [
            "Tailgating",
            "Physical security",
            "Social engineering"
          ],
          "mins": 5
        },
        {
          "id": "cc-deprovisioning",
          "title": "The account that outlived the employee",
          "situation": "An employee left six months ago, but their account was never disabled. An attacker found the stale credentials in an old breach dump and used them to log in last week.",
          "prompt": "What process failed, and what is the fix?",
          "choices": [
            "Provisioning \u2014 accounts were created too slowly",
            "Deprovisioning \u2014 accounts must be disabled promptly when people leave; tie it to the HR departure process",
            "Encryption \u2014 the account was not encrypted",
            "Backup \u2014 the account was not backed up"
          ],
          "answer": 1,
          "why": "Deprovisioning removes access when it is no longer needed \u2014 departures, role changes, contractors ending. Stale accounts are attacker favorites: nobody watches them, and their passwords never change. The fix is procedural: HR triggers IT on every departure, and access reviews catch what the process misses.",
          "hint": "When should the account's life have ended?",
          "objectives": [
            "Deprovisioning",
            "Account lifecycle",
            "Access reviews"
          ],
          "mins": 6
        },
        {
          "id": "cc-need-to-know",
          "title": "The curious coworker",
          "situation": "An employee asks IT for a peek at a colleague's salary file, saying they are just curious and promise not to tell anyone.",
          "prompt": "What is the correct response?",
          "choices": [
            "Share it \u2014 curiosity is harmless and they promised secrecy",
            "Share it but ask them not to copy it",
            "Post the salaries publicly so nobody has to ask",
            "Deny the request \u2014 access requires a business need-to-know, not curiosity; even authorized staff only see what their job requires"
          ],
          "answer": 3,
          "why": "Need-to-know (a facet of least privilege) means access follows job necessity, not curiosity or seniority. Granting one-off peeks trains the organization that access rules are negotiable \u2014 and every exception is a precedent. The answer is a polite, firm no, with the request logged.",
          "hint": "Does their job require this information?",
          "objectives": [
            "Need-to-know",
            "Least privilege"
          ],
          "mins": 5
        }
      ]
    },
    {
      "id": "network-security",
      "name": "Network Security",
      "scenarios": [
        {
          "id": "cc-firewall-basics",
          "title": "The bouncer at the door",
          "situation": "A small office installs a firewall between their network and the internet. The owner asks what it actually does for them day to day.",
          "prompt": "What is the firewall's job?",
          "choices": [
            "It speeds up the internet connection",
            "It encrypts every file on every computer",
            "It blocks unsolicited inbound traffic and enforces rules about what may enter or leave \u2014 a bouncer with a guest list",
            "It replaces the need for passwords"
          ],
          "answer": 2,
          "why": "A firewall is a policy enforcement point: it inspects traffic and allows or denies it based on rules \u2014 which addresses, ports, and directions are permitted. It does not encrypt your files or replace authentication; it controls the door so fewer attacks ever reach the inside.",
          "hint": "Think about what a bouncer does \u2014 and does not do \u2014 at a club door.",
          "objectives": [
            "Firewalls",
            "Perimeter concepts"
          ],
          "mins": 5
        },
        {
          "id": "cc-guest-wifi",
          "title": "The customers on the company network",
          "situation": "A cafe offers free Wi-Fi, but it runs on the same network as the point-of-sale system that processes card payments. A regular customer is studying networking.",
          "prompt": "What is wrong with this setup, and what is the fix?",
          "choices": [
            "The guest traffic shares a network with payment systems; isolate guest Wi-Fi on a separate network or VLAN away from business systems",
            "Nothing \u2014 customers would never look at other devices",
            "The Wi-Fi password should be removed to make it easier",
            "The point-of-sale should be moved to the guest network"
          ],
          "answer": 0,
          "why": "Anyone on the same network can observe and potentially reach other devices on it. Guest traffic \u2014 untrusted by definition \u2014 must be segmented away from systems handling payments or business data. A separate guest network or VLAN is the standard, inexpensive fix.",
          "hint": "Who else is on that network, and what could they reach?",
          "objectives": [
            "Network segmentation",
            "Guest networks",
            "VLANs"
          ],
          "mins": 6
        },
        {
          "id": "cc-vpn-remote",
          "title": "The laptop at the coffee shop",
          "situation": "An employee needs to work from a coffee shop's public Wi-Fi and access files on the office server. Anyone nearby could be listening to the wireless traffic.",
          "prompt": "How should the employee protect the connection?",
          "choices": [
            "Turn the screen brightness down so nobody can read it",
            "Only visit websites with nice designs",
            "Public Wi-Fi is safe as long as you have antivirus",
            "Use the company VPN \u2014 it encrypts traffic between the laptop and the office, shielding it from local eavesdroppers"
          ],
          "answer": 3,
          "why": "A virtual private network (VPN) builds an encrypted tunnel from the device to the trusted network, so anyone sniffing the coffee-shop Wi-Fi sees only scrambled traffic. It does not make the laptop itself secure \u2014 but it removes the network eavesdropper from the threat model.",
          "hint": "What can the person at the next table see without protection?",
          "objectives": [
            "VPNs",
            "Remote access",
            "Encryption in transit"
          ],
          "mins": 5
        },
        {
          "id": "cc-wireless-upgrade",
          "title": "The router from 2012",
          "situation": "An office access point still runs WEP security with the manufacturer's default admin password, and the network name broadcasts the company name.",
          "prompt": "What is the correct upgrade?",
          "choices": [
            "Nothing \u2014 WEP was good enough in 2012 and nothing has changed",
            "Move to WPA3 (or WPA2 at minimum), set a strong unique passphrase, and change the default admin credentials",
            "Hide the network name \u2014 that alone stops attackers",
            "Remove the password so guests connect easily"
          ],
          "answer": 1,
          "why": "WEP is broken \u2014 its encryption can be cracked in minutes \u2014 and default credentials are published in every manual online. Modern wireless security means WPA2 or WPA3 with a strong passphrase, unique admin credentials, and firmware updates. Hiding the network name (disabling SSID broadcast) is obscurity, not security.",
          "hint": "Which of these settings would stop an attacker for more than a few minutes?",
          "objectives": [
            "Wireless security",
            "WPA2/WPA3",
            "Default credentials"
          ],
          "mins": 6
        },
        {
          "id": "cc-ddos-shop",
          "title": "The website that drowned",
          "situation": "During the biggest sale of the year, an online store becomes unreachable. Traffic is a hundred times normal, coming from thousands of compromised devices worldwide \u2014 not real shoppers.",
          "prompt": "What is happening, and what is the mitigation concept?",
          "choices": [
            "A successful marketing campaign \u2014 buy a bigger server eventually",
            "A worm \u2014 disconnect the store permanently",
            "A distributed denial-of-service attack \u2014 absorb and filter the flood with a CDN, scrubbing service, or cloud scaling, and engage the ISP or provider",
            "Normal holiday traffic \u2014 do nothing"
          ],
          "answer": 2,
          "why": "A DDoS attack overwhelms a target with traffic from a botnet, making the service unavailable to legitimate users \u2014 an attack on availability. You cannot block thousands of sources with a firewall rule; mitigation means absorbing the flood upstream (CDN, scrubbing centers, elastic scaling) and filtering attack traffic before it reaches you.",
          "hint": "Is the goal to steal data, or to make the site unreachable?",
          "objectives": [
            "DDoS",
            "Availability attacks",
            "Mitigation concepts"
          ],
          "mins": 6
        },
        {
          "id": "cc-evil-twin",
          "title": "The free Wi-Fi that was not",
          "situation": "At an airport, a traveler sees Free_Airport_WiFi with full signal and joins it. The hotspot is actually a laptop in an attacker's backpack, capturing every login the traveler types.",
          "prompt": "How should travelers protect themselves from rogue hotspots?",
          "choices": [
            "Always join the strongest free signal \u2014 signal strength proves legitimacy",
            "Turn off the firewall to connect faster",
            "Airports are safe, so no precautions are needed",
            "Verify the official network name with staff, prefer a phone hotspot or VPN, and avoid sensitive logins on unknown networks"
          ],
          "answer": 3,
          "why": "An evil-twin attack mimics a legitimate hotspot to intercept traffic. Defenses: confirm the real network name with staff, use your phone's hotspot or a VPN so intercepted traffic is encrypted, and treat every unknown network as hostile. The attacker relies on convenience beating caution.",
          "hint": "How would you know which hotspot is the real one?",
          "objectives": [
            "Evil twin",
            "Rogue access points",
            "Wireless safety"
          ],
          "mins": 6
        },
        {
          "id": "cc-open-ports",
          "title": "The open doors nobody uses",
          "situation": "A scan of the office network finds an old printer with Telnet enabled \u2014 a service nobody uses or remembers configuring. The printer's firmware has not been updated in five years.",
          "prompt": "What is the correct action?",
          "choices": [
            "Leave it \u2014 unused services cannot be attacked",
            "Open more ports so the printer is easier to manage",
            "Replace Telnet with a longer password",
            "Disable the unneeded service and close the port \u2014 every open service is a potential entry point; shrink the attack surface"
          ],
          "answer": 3,
          "why": "Attack surface is the sum of reachable entry points: open ports, running services, enabled protocols. Unused services \u2014 especially ancient cleartext ones like Telnet \u2014 are pure risk with zero benefit. Hardening means disabling what you do not need, patching what you keep, and re-checking regularly.",
          "hint": "What does the business gain from that open port? What could an attacker gain?",
          "objectives": [
            "Attack surface",
            "Hardening",
            "Unneeded services"
          ],
          "mins": 6
        }
      ]
    },
    {
      "id": "sec-operations",
      "name": "Security Operations",
      "scenarios": [
        {
          "id": "cc-logs-why",
          "title": "The break-in with no witnesses",
          "situation": "A server is compromised, but the company kept almost no logs. Nobody can say when the attacker got in, what they touched, or whether they are still inside.",
          "prompt": "What is the lesson for security operations?",
          "choices": [
            "Logs are optional \u2014 the antivirus will write the incident report",
            "Centralized logging enables detection and investigation: without logs, you cannot see the attack or scope the damage",
            "Delete logs regularly so attackers cannot read them",
            "Only large companies need logging"
          ],
          "answer": 1,
          "why": "Logs are the witnesses of the digital world: they record who did what and when. Centralized collection (often in a SIEM) lets analysts detect patterns and reconstruct incidents. No logs means no timeline, no scope, and no confident recovery \u2014 you are guessing in the dark.",
          "hint": "What would a detective say about a crime scene with no witnesses and no cameras?",
          "objectives": [
            "Logging",
            "Monitoring",
            "SIEM basics"
          ],
          "mins": 5
        },
        {
          "id": "cc-patching",
          "title": "The update everyone postponed",
          "situation": "Attackers breach a company through a vulnerability the vendor patched eight months ago. The patch was marked low priority and never scheduled.",
          "prompt": "What process failed, and what does good look like?",
          "choices": [
            "Patch management \u2014 inventory systems, test patches, and deploy them on a schedule; known vulnerabilities are the attacker's favorite door",
            "Antivirus \u2014 it should have stopped a patched vulnerability",
            "Hiring \u2014 the team needed more people to ignore updates",
            "Nothing failed \u2014 patching is optional"
          ],
          "answer": 0,
          "why": "Most breaches exploit known vulnerabilities with available patches \u2014 attackers automate scanning for unpatched systems within hours of disclosure. Patch management is the disciplined cycle: know what you have, test the fix, deploy it promptly, and verify. Postponed patches are open invitations.",
          "hint": "Did the attackers discover something new, or use something everyone knew about?",
          "objectives": [
            "Patch management",
            "Vulnerability management"
          ],
          "mins": 6
        },
        {
          "id": "cc-default-creds",
          "title": "The admin admin camera",
          "situation": "An attacker logs into the office security cameras using the default username and password printed in the manufacturer's manual, then watches the building for weeks.",
          "prompt": "What is the fix, and what broader practice does it belong to?",
          "choices": [
            "Change all default credentials as part of system hardening \u2014 defaults are public knowledge, not secrets",
            "Unplug the cameras \u2014 they are the problem",
            "The manual should be kept secret instead",
            "Longer camera cables"
          ],
          "answer": 0,
          "why": "Default credentials are published in manuals and online lists \u2014 attackers try them first. Hardening a system means changing defaults, disabling unneeded services, and applying secure baselines before it touches the network. Every device with admin/admin still set is an open door with a welcome mat.",
          "hint": "Where else could an attacker find that default password?",
          "objectives": [
            "Hardening",
            "Default credentials",
            "Secure baselines"
          ],
          "mins": 5
        },
        {
          "id": "cc-report-phish",
          "title": "The email that looked like the boss",
          "situation": "An employee receives an urgent email that appears to be from the CEO, asking them to buy gift cards for client gifts and send the codes immediately.",
          "prompt": "What is the correct action?",
