  "behavioral": [
    {
      "prompt": "Tell me about yourself \u2014 as an iOS engineer.",
      "framework": "Present -> past -> future in 90 seconds, anchored on shipped apps and platform depth.",
      "points": [
        "Start with your current focus (e.g. SwiftUI + structured concurrency).",
        "Name 1-2 shipped apps and your concrete contribution.",
        "End with what you want next and why this team."
      ],
      "pitfalls": [
        "Reciting your resume chronologically.",
        "No mention of the App Store / real users."
      ]
    },
    {
      "prompt": "Tell me about the hardest production bug you fixed on iOS.",
      "framework": "STAR: symptom, systematic narrowing, root cause, fix + guard.",
      "points": [
        "Why it was hard (intermittent, device-specific, memory).",
        "How you narrowed it (Instruments, logs, hypothesis list).",
        "The process change you made afterward."
      ],
      "pitfalls": [
        "Only describing the fix, not the investigation.",
        "Blaming the OS or a teammate."
      ]
    },
    {
      "prompt": "Describe a disagreement with a designer or PM about a feature.",
      "framework": "STAR with emphasis on the tradeoff conversation.",
      "points": [
        "The technical constraint (performance, HIG, scope).",
        "How you proposed alternatives instead of just saying no.",
        "The outcome and what you learned about collaboration."
      ],
      "pitfalls": [
        "Painting the other person as unreasonable.",
        "No concrete technical detail."
      ]
    },
    {
      "prompt": "Tell me about a time you missed a deadline or cut scope.",
      "framework": "STAR: early signal, re-scoping conversation, what shipped.",
      "points": [
        "How you detected the slip early.",
        "How you renegotiated scope with data.",
        "What you changed in estimation afterward."
      ],
      "pitfalls": [
        "Claiming you never miss deadlines.",
        "Blaming others without owning your part."
      ]
    },
    {
      "prompt": "How did you learn SwiftUI (or structured concurrency) when it was new?",
      "framework": "Learning story: gap -> method -> applied result.",
      "points": [
        "The specific gap and why it mattered.",
        "Your method (docs, sample app, migrating a screen).",
        "Where you applied it in production."
      ],
      "pitfalls": [
        "'I just read the docs' with no application.",
        "No acknowledgment of what was confusing."
      ]
    },
    {
      "prompt": "Tell me about a time you improved app performance or stability.",
      "framework": "STAR with numbers: before/after metrics.",
      "points": [
        "The metric (launch time, crash rate, scroll FPS) and how you measured it.",
        "The change and why that bottleneck.",
        "The quantified result."
      ],
      "pitfalls": [
        "'It felt faster' with no numbers.",
        "Optimizing without profiling first."
      ]
    },
    {
      "prompt": "Describe dealing with an App Store rejection or a critical 1-star review wave.",
      "framework": "STAR: triage, communication, fix, prevention.",
      "points": [
        "How you triaged (guideline section, repro).",
        "How you communicated with Apple/users.",
        "The guardrail added (checklist, review step)."
      ],
      "pitfalls": [
        "Complaining about App Review.",
        "No prevention step."
      ]
    },
    {
      "prompt": "Why iOS \u2014 and why this team?",
      "framework": "Genuine motivation + specific team knowledge.",
      "points": [
        "What draws you to the platform (craft, constraints, user impact).",
        "Something specific about this team's app or tech.",
        "How the role fits your trajectory."
      ],
      "pitfalls": [
        "Generic praise any candidate could give.",
        "Focusing only on compensation or prestige."
      ]
    }
  ],
  "resources": {
    "cheatsheet": [
      "Optionals: `if let` / `guard let` bind; `?.` chains; `??` defaults; `!` is a scheduled crash.",
      "Value vs ref: struct = independent copy (CoW arrays/dicts); class = shared identity + ARC.",
      "Closures: non-escaping by default; `@escaping` outlives the call \u2014 capture lists `[weak self]`.",
      "Lifecycle: loadView -> viewDidLoad (once) -> viewWillAppear (every) -> viewDidLayoutSubviews -> viewDidAppear.",
      "SwiftUI layout: parent proposes -> child chooses -> parent places. @State owns, @Binding borrows.",
      "GCD: async never blocks; sync waits (never sync onto current/main queue). QoS: userInteractive > userInitiated > utility > background.",
      "Modern: async/await + Task; actors isolate state; @MainActor = UI. Cancel tasks; check Task.isCancelled.",
      "Persistence ladder: UserDefaults (settings) < Codable files (docs) < Core Data/SwiftData (queryable) < Keychain (secrets).",
      "Core Data rule: contexts are queue-confined; pass objectIDs across queues, never objects.",
      "Architecture: VC binds views; view model holds state; coordinator owns flow; inject dependencies for tests."
    ],
    "glossary": [
      [
        "ARC",
        "Automatic Reference Counting: deterministic deallocation at zero strong references; cycles leak."
      ],
      [
        "Copy-on-write",
        "Value-type optimization: Array/String/Dictionary share storage until mutated."
      ],
      [
        "Existential",
        "`any Protocol`: a boxed protocol value; unavailable for protocols with associated types."
      ],
      [
        "PAT",
        "Protocol with Associated Type: cannot be used directly as a property type."
      ],
      [
        "MainActor",
        "Global actor isolating code to the main thread; the modern main-thread guarantee."
      ],
      [
        "QoS",
        "Quality of Service: priority hint for GCD queues (userInteractive down to background)."
      ],
      [
        "Retain cycle",
        "Ownership loop keeping reference counts above zero; broken with weak/unowned."
      ],
      [
        "Coordinator",
        "Object owning navigation flow so view controllers stay reusable."
      ],
      [
        "Merge policy",
        "Core Data rule deciding which change wins on save conflicts."
      ],
      [
        "Debounce",
        "Delay action until input pauses; implemented by cancelling the previous scheduled work."
      ]
    ],
    "links": [
      [
        "Swift Language Guide",
        "https://www.swift.org/documentation/"
      ],
      [
        "SwiftUI Documentation",
        "https://developer.apple.com/documentation/swiftui"
      ],
      [
        "UIKit Documentation",
        "https://developer.apple.com/documentation/uikit"
      ],
      [
        "Swift Concurrency",
        "https://docs.swift.org/swift-book/documentation/the-swift-programming-language/concurrency/"
      ],
      [
        "Human Interface Guidelines",
        "https://developer.apple.com/design/human-interface-guidelines"
      ]
    ],
    "checklist": [
      "Can you narrate the SwiftUI layout algorithm and the UIViewController lifecycle from memory?",
      "Can you draw a retain cycle and fix it with a capture list without hesitating?",
      "Can you explain GCD vs async/await and when you would still reach for GCD?",
      "Do you have two STAR stories (hardest bug, disagreement) rehearsed under 3 minutes?",
      "Have you done one timed mock of each loop type (coding, architecture, debugging, behavioral)?",
      "Is your take-home portfolio piece reviewed against the self-review checklist?"
    ]
  },
  "chat": {
    "persona": "Noa \u2014 a direct, encouraging iOS interview coach. Socratic first: asks what you would do before revealing answers. Drills Swift, UIKit/SwiftUI, concurrency, and system design; runs timed mock rounds on request.",
    "topics": [
      "Swift language deep-dives",
      "UIKit vs SwiftUI tradeoff discussions",
      "Concurrency design reviews",
      "Mock whiteboard rounds",
      "Take-home scoping and review",
      "Behavioral STAR rehearsal"
    ]
  },
  "simulation": {
    "items": 10,
    "minutes": 30,
    "evidence_cost_mins": 2
  },
  "media": [
    {
