  "labs": [
    {
      "id": "ios-interview-lab1",
      "domain_id": "ios-interview",
      "title": "Retain-cycle hunt",
      "objective": "Find and fix a retain cycle in a view controller's networking closure using a capture list.",
      "steps": [
        "Open the lab fixture: `cat LeakyProfile.swift` and read the fetch closure in viewDidLoad.",
        "Draw the ownership arrows: who owns the API client, who holds the closure, who does the closure capture?",
        "Write the fixed file: `echo` or your editor to create LeakyProfile-fixed.swift with a `[weak self]` capture list and `guard let self` inside.",
        "Verify the fix is present: `grep -n \"weak self\" LeakyProfile-fixed.swift`.",
        "Explain in one sentence (say it out loud): why does the original never deallocate?"
      ],
      "checks": [
        {
          "command_pattern": "^cat\\s+LeakyProfile\\.swift",
          "expect_contains": "self.nameLabel",
          "hint": "Read the fixture first \u2014 find the closure that captures self."
        },
        {
          "command_pattern": "^grep\\s+.*weak\\s+self",
          "expect_contains": "weak self",
          "hint": "Your fixed file must contain a [weak self] capture list."
        }
      ]
    },
    {
      "id": "ios-interview-lab2",
      "domain_id": "ios-interview",
      "title": "Main-thread triage",
      "objective": "Spot a background-thread UI update and reroute it through the main queue.",
      "steps": [
        "Open the fixture: `cat JankyFeed.swift` and find the image decode completion.",
        "Identify the line that sets `cell.thumb.image` \u2014 which queue is it running on?",
        "Create JankyFeed-fixed.swift wrapping the UI assignment in `DispatchQueue.main.async`.",
        "Verify: `grep -n \"DispatchQueue.main.async\" JankyFeed-fixed.swift`.",
        "Bonus: rewrite the completion with async/await and a MainActor hop, and compare the two versions."
      ],
      "checks": [
        {
          "command_pattern": "^cat\\s+JankyFeed\\.swift",
          "expect_contains": "thumb.image",
          "hint": "Find where the cell's image view is assigned in the fixture."
        },
        {
          "command_pattern": "^grep\\s+.*DispatchQueue\\.main\\.async",
          "expect_contains": "DispatchQueue.main.async",
          "hint": "The fixed file must hop UI work back to the main queue."
        }
      ]
    }
  ],
  "simulations": [
    {
      "id": "ios-sim-1",
      "title": "The retain cycle",
      "kind": "troubleshoot",
      "domain_id": "ios-swift-core",
      "difficulty": 2,
      "points": 100,
      "brief": "ProfileViewController never deallocates after dismissal. The Memory Graph shows a purple cycle \u2014 explain it and break it.",
      "steps": [
        {
          "symptom": "ProfileViewController never deallocates after dismissal; the Memory Graph shows a retain cycle.",
          "evidence": [
            [
              "graph",
              "ProfileVC \u2192 networkTask closure \u2192 ProfileVC"
            ],
            [
              "code",
              "task = { self.updateUI() }"
            ]
          ],
          "options": [
            "Capture self weakly: { [weak self] in ... } and guard-let a strong reference inside",
            "Set the closure to nil in viewDidLoad",
            "Call removeFromParent() manually",
            "Ignore it \u2014 ARC handles cycles"
          ],
          "correct": 0,
          "explain": "A closure capturing self strongly while self owns the closure is a textbook cycle. [weak self] breaks it; the guard-let re-strengthens safely for the call."
        },
        {
          "symptom": "Cycle fixed. Now a repeating Timer keeps the settings screen alive.",
          "evidence": [
            [
              "code",
              "timer = Timer.scheduledTimer(withTimeInterval: 1, repeats: true) { _ in self.tick() }"
            ]
          ],
          "options": [
            "Invalidate the timer on the view's teardown path \u2014 repeating timers retain their target",
            "Make the timer non-repeating",
            "Move the timer to the AppDelegate",
            "Use a longer interval"
          ],
          "correct": 0,
          "explain": "A scheduled repeating timer retains its target (via the closure) until invalidated. Ownership of the timer's lifetime belongs to the screen."
        },
        {
          "symptom": "Both fixed. Prove it in the interview.",
          "evidence": [
            [
              "tool",
              "Xcode Memory Graph Debugger"
            ]
          ],
          "options": [
            "Dismiss the screen and show the Memory Graph with no purple exclamation \u2014 deinit prints confirm",
            "Check the app still launches",
            "Profile CPU usage",
            "Read the code once more"
          ],
          "correct": 0,
          "explain": "The proof is visual and mechanical: dismiss, and the graph shows no cycle. A deinit print is the cheapest regression signal."
        }
      ],
      "debrief": "Retain cycles are ownership diagrams: find who holds whom, break one link with weak, and prove it in the Memory Graph."
    },
    {
      "id": "ios-sim-2",
      "title": "The frozen UI",
      "kind": "troubleshoot",
      "domain_id": "ios-ui-frameworks",
      "difficulty": 2,
      "points": 100,
      "brief": "Tapping Sync freezes the UI for 4 seconds while photos upload. The interviewer is watching the main thread.",
      "steps": [
        {
          "symptom": "Tapping Sync freezes the UI for 4 seconds while photos upload.",
          "evidence": [
            [
              "trace",
              "Main thread blocked in uploadAll() \u2014 synchronous URLSession"
            ]
          ],
          "options": [
            "Move the upload off the main thread (URLSession data task / async-await) and update UI on completion",
            "Show a spinner on the main thread during the upload",
            "Split the upload into smaller synchronous chunks",
            "Disable the Sync button while uploading"
          ],
          "correct": 0,
          "explain": "UIKit demands a responsive main thread. Async work with a completion that hops back to Main is the entire pattern."
        },
        {
          "symptom": "Upload is async now, but the progress bar updates from the background closure and sometimes never redraws.",
          "evidence": [
            [
              "code",
              "progressView.progress = p // called from URLSession delegate queue"
            ]
          ],
          "options": [
            "Dispatch UI updates to the main queue: DispatchQueue.main.async { ... }",
            "Update progress less often",
            "Remove the progress bar",
            "Use a UILabel instead"
          ],
          "correct": 0,
          "explain": "UIKit is not thread-safe: every UI mutation must happen on the main thread. The hop is one line and non-negotiable."
        },
        {
          "symptom": "Smooth now. The interviewer asks about Swift concurrency instead of GCD.",
          "evidence": [
            [
              "code",
              "async func sync() \u2014 needs @MainActor?"
            ]
          ],
          "options": [
            "Mark UI-touching code @MainActor so the compiler enforces main-thread execution",
            "Keep GCD everywhere",
            "Mark everything @MainActor",
            "Avoid async/await"
          ],
          "correct": 0,
          "explain": "@MainActor moves the main-thread rule from convention to compiler enforcement \u2014 the modern answer to the same discipline."
        }
      ],
      "debrief": "UI responsiveness is a threading contract: work off-main, UI on-main, and let @MainActor enforce it."
    },
    {
      "id": "ios-sim-3",
      "title": "The Core Data migration crash",
      "kind": "troubleshoot",
      "domain_id": "ios-persistence",
      "difficulty": 2,
      "points": 100,
      "brief": "Adding an attribute crashes existing installs on launch. Walk the interviewer through the migration taxonomy.",
      "steps": [
        {
          "symptom": "Adding a 'nickname' attribute crashes existing installs: 'Can't find mapping model for migration'.",
          "evidence": [
            [
              "change",
              "added optional attribute nickname to User entity"
            ]
          ],
          "options": [
            "Enable lightweight migration (NSMigratePersistentStoresAutomaticallyOption) \u2014 adding an optional attribute is inferable",
            "Write a manual mapping model for every change",
            "Delete the store and recreate",
            "Ship a new app instead of an update"
          ],
          "correct": 0,
          "explain": "Additive, inferable changes migrate automatically with the lightweight options. Manual mapping models are for renames and splits."
        },
        {
          "symptom": "Lightweight migration on. Now splitting 'name' into 'firstName'+'lastName' still crashes.",
          "evidence": [
            [
              "change",
              "renamed/split attribute \u2014 not inferable"
            ]
          ],
          "options": [
            "Write a custom NSEntityMigrationPolicy mapping the old name into the two new attributes",
            "Force lightweight migration anyway",
            "Destructive recreate",
            "Do the split in code after launch"
          ],
          "correct": 0,
          "explain": "Non-inferable changes need an explicit mapping model plus policy. That is the line between lightweight and heavyweight."
        },
        {
          "symptom": "Migration works. How do you test it in CI?",
          "evidence": [
            [
              "stores",
              "v1 store file checked into test fixtures"
            ]
          ],
          "options": [
            "Migrate the fixture v1 store in a test and assert user data survives",
            "Test only fresh installs",
            "Manually upgrade once on a device",
            "Trust the mapping model XML"
          ],
          "correct": 0,
          "explain": "Migration tests replay the real upgrade: old store in, migrated store out, data asserted. Fixtures make it repeatable."
        }
      ],
      "debrief": "Core Data migrations split on inferability: lightweight for additive changes, mapping models for the rest, fixtures proving both."
    },
    {
      "id": "ios-sim-4",
      "title": "The flaky XCUITest",
      "kind": "troubleshoot",
      "domain_id": "ios-mock-circuit",
      "difficulty": 2,
      "points": 100,
      "brief": "The login UI test fails on CI whenever the mock server is slow. Stabilize it live for the interviewer.",
      "steps": [
        {
          "symptom": "Login UI test fails on CI when the mock server is slow: the test taps Sign in before the button enables.",
          "evidence": [
            [
              "log",
              "XCTAssertTrue(signInButton.isEnabled) failed \u2014 button enabled 800ms later"
            ]
          ],
          "options": [
            "Wait on the real condition with an XCTNSPredicateExpectation instead of a fixed sleep",
            "Add sleep(2) before the tap",
            "Retry the test on failure",
            "Run UI tests only on simulators"
          ],
          "correct": 0,
          "explain": "Expectations wait for the actual state; sleeps guess at timing. The flake disappears when the test observes instead of assumes."
        },
        {
          "symptom": "Expectation added. Still flakes when animations run long on CI.",
          "evidence": [
            [
              "env",
              "CI simulators are slow; animations take 3x longer"
            ]
          ],
          "options": [
            "Disable animations in the test scheme (UIView.setAnimationsEnabled(false))",
            "Increase all timeouts to 60s",
            "Record a new test",
            "Test on physical devices only"
          ],
          "correct": 0,
          "explain": "Animations are the other timing variable. Disabling them in tests removes a whole class of flakes deterministically."
        },
        {
          "symptom": "Green 30/30. Keep it green?",
          "evidence": [
            [
              "CI",
              "UI tests gate the release branch"
            ]
          ],
          "options": [
            "Gate on them and treat every new flake as a P1 bug",
            "Move them to nightly",
            "Allow one retry per test",
            "Delete slow tests"
          ],
          "correct": 0,
          "explain": "Flake tolerance compounds. Gating plus immediate flake triage is what keeps a UI suite trustworthy at scale."
        }
      ],
      "debrief": "Flaky UI tests are timing assumptions: wait on predicates, kill animations, and gate."
    },
    {
      "id": "ios-sim-5",
      "title": "Whiteboard: offline-first sync",
      "kind": "troubleshoot",
      "domain_id": "ios-architecture",
      "difficulty": 3,
      "points": 100,
      "brief": "System-design round: offline-first notes with two-device sync conflicts. 40 minutes \u2014 reason out loud.",
      "steps": [
        {
          "symptom": "Design offline-first notes: instant render offline, sync when online, conflicts possible.",
          "evidence": [
            [
              "constraints",
              "two devices, same account, spotty network"
            ]
          ],
          "options": [
            "Local store (Core Data/SwiftData) as source of truth; a sync engine pushes/pulls deltas; the UI observes the store",
            "The UI fetches from the server on every appear",
            "iCloud-only with no local cache",
            "One JSON file in Documents"
          ],
          "correct": 0,
          "explain": "Source-of-truth locally means the UI never waits on network. Sync is a background reconciliation against that store."
        },
        {
          "symptom": "Interviewer: both devices edit the same note offline. Resolve it.",
          "evidence": [
            [
              "conflict",
              "device A: 'buy milk'; device B: 'buy oat milk'"
            ]
          ],
          "options": [
            "Last-writer-wins with a deterministic tiebreak, surfaced in UI when data was merged \u2014 or CRDTs if ordering matters",
            "First-writer-wins silently",
            "Duplicate the note",
            "Crash and ask the user to pick a device"
          ],
          "correct": 0,
          "explain": "Conflicts need a deterministic rule plus user visibility. LWW with timestamps is the pragmatic default; CRDTs when merge semantics matter."
        },
        {
          "symptom": "Last: the sync engine itself \u2014 how is it structured?",
          "evidence": [
            [
              "app",
              "MVVM + repository already in place"
            ]
          ],
          "options": [
            "A sync coordinator owned by the repository: push local changes, pull remote deltas, write both through the store in transactions",
            "Sync code inside every view model",
            "Sync on app launch only",
            "Poll the server from the view"
          ],
          "correct": 0,
          "explain": "Sync belongs behind the repository boundary: one coordinator, transactional writes, and the UI never knows the network exists."
        }
      ],
      "debrief": "Offline-first is a layering decision: the store is truth, sync reconciles behind the repository, conflicts resolve deterministically."
    }
  ],
  "consoleSims": [
    {
      "id": "ios-console-1",
      "title": "Trace the sample",
      "console": "code-editor",
      "domain_id": "ios-swift-core",
      "difficulty": 1,
      "brief": "A sample routine needs tracing in the interviewer's debugger exercise. Open, break, run, inspect.",
      "tasks": [
        {
          "id": "ios-c1-t1",
          "instruction": "Open app.py in the Explorer.",
          "validate": {
            "action": "open-file",
            "params": {
              "name": "app.py"
            }
          },
          "hint": "Explorer tab \u2192 Open app.py."
        },
        {
          "id": "ios-c1-t2",
          "instruction": "Set a breakpoint at app.py line 4.",
          "validate": {
            "action": "toggle-breakpoint",
            "params": {
              "file": "app.py",
              "line": 4
            }
          },
          "hint": "Click line 4 in the editor to toggle a breakpoint."
        },
        {
          "id": "ios-c1-t3",
          "instruction": "Run to the breakpoint.",
          "validate": {
            "action": "run-to-breakpoint",
            "params": {}
          },
          "hint": "Press Run to breakpoint."
        },
        {
          "id": "ios-c1-t4",
          "instruction": "Inspect the variable s.",
          "validate": {
            "action": "inspect-variable",
            "params": {
              "name": "s"
            }
          },
          "hint": "Use Inspect with variable name s."
        }
      ],
      "debrief": "Debugger habits are language-agnostic: open, break, run, inspect \u2014 read state before guessing."
    },
    {
      "id": "ios-console-2",
      "title": "Review the login PR",
      "console": "git-host",
      "domain_id": "ios-guided-build",
      "difficulty": 2,
      "brief": "The biometric-login branch is ready for review. Drive it from branch to approval in the simulated git host.",
      "tasks": [
        {
          "id": "ios-c2-t1",
          "instruction": "Create the branch login/biometric in the Branches tab.",
          "validate": {
            "action": "create-branch",
            "params": {
              "name": "login/biometric"
            }
          },
          "hint": "Branches tab \u2192 Create branch, name it login/biometric."
        },
        {
          "id": "ios-c2-t2",
          "instruction": "Open a pull request titled 'Add biometric login' from login/biometric into main.",
          "validate": {
            "action": "open-pr",
            "params": {
              "title": "Add biometric login",
              "base": "main",
              "head": "login/biometric"
            }
          },
          "hint": "Pull requests tab \u2192 Open pull request; head is login/biometric, base is main."
        },
        {
          "id": "ios-c2-t3",
          "instruction": "Leave a review comment on PR #2 confirming Face ID and Touch ID paths were tested.",
          "validate": {
            "action": "add-comment",
            "params": {
              "pr": 2,
              "text": "Face ID and Touch ID paths tested."
            }
          },
          "hint": "Add a comment on PR 2 confirming both biometric paths tested."
        },
        {
          "id": "ios-c2-t4",
          "instruction": "Approve PR #2.",
          "validate": {
            "action": "approve-pr",
            "params": {
              "pr": 2
            }
          },
          "hint": "Click Approve on PR #2."
        }
      ],
      "debrief": "Every feature ships the same way: branch, PR, recorded review, approval."
    },
    {
      "id": "ios-console-3",
      "title": "Green the release train",
      "console": "cicd-pipeline",
      "domain_id": "ios-guided-build",
      "difficulty": 2,
      "brief": "The iOS release pipeline builds with the wrong Xcode. Retarget it and rerun tests in the simulated CI console.",
      "tasks": [
        {
          "id": "ios-c3-t1",
          "instruction": "Set the XCODE_VERSION pipeline variable to 16.2.",
          "validate": {
            "action": "set-variable",
            "params": {
              "key": "XCODE_VERSION",
              "value": "16.2"
            }
          },
          "hint": "Set variable XCODE_VERSION = 16.2."
        },
        {
          "id": "ios-c3-t2",
          "instruction": "Trigger a fresh build.",
          "validate": {
            "action": "trigger-build",
            "params": {}
          },
          "hint": "Trigger the build."
        },
        {
          "id": "ios-c3-t3",
          "instruction": "Retry the failed test stage.",
          "validate": {
            "action": "retry-stage",
            "params": {
              "stage": "test"
            }
          },
          "hint": "Retry the test stage."
        }
      ],
      "debrief": "Release trains run on explicit configuration: pin the toolchain, rebuild clean, rerun what failed."
    },
    {
      "id": "ios-console-4",
      "title": "Query the Core Data export",
      "console": "sql-studio",
      "domain_id": "ios-persistence",
      "difficulty": 2,
      "brief": "The interviewer exports a Core Data store as SQLite. Recreate its notes table and query it in the SQL workbench.",
      "tasks": [
        {
          "id": "ios-c4-t1",
          "instruction": "Create table notes with columns id INTEGER, body TEXT.",
          "validate": {
            "action": "create-table",
            "params": {
              "name": "notes",
              "columns": "id INTEGER, body TEXT"
            }
          },
          "hint": "Create table notes (id INTEGER, body TEXT)."
        },
        {
          "id": "ios-c4-t2",
          "instruction": "Index the body column for search.",
          "validate": {
            "action": "create-index",
            "params": {
              "table": "notes",
              "column": "body"
            }
          },
          "hint": "Create an index on notes.body."
        },
        {
          "id": "ios-c4-t3",
          "instruction": "Run a query selecting bodies from notes.",
          "validate": {
            "action": "run-query",
            "params": {
              "match": "notes"
            }
          },
          "hint": "Run any SELECT that mentions the notes table."
        }
      ],
      "debrief": "Under the ORM it is still tables and indexes: model it, index the search path, query it."
    }
  ],
