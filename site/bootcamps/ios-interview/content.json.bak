  "sections": [
    {
      "id": "ios-interview-sec",
      "title": "iOS Engineering Interview Prep",
      "kind": "path",
      "lectures": [],
      "lab_ids": [
        "ios-interview-lab1",
        "ios-interview-lab2"
      ],
      "drill_domain_ids": [
        "ios-swift-core",
        "ios-ui-frameworks",
        "ios-concurrency",
        "ios-persistence",
        "ios-architecture",
        "ios-guided-build",
        "ios-mock-circuit"
      ]
    }
