        "Derive the first two subnet network addresses"
      ],
      "checks": [
        {
          "command_pattern": "^echo /19$",
          "expect_contains": "/19",
          "hint": "8 subnets need 3 borrowed bits: 16 + 3. In the Terminal tab, run `echo /19` with the new prefix length."
        },
        {
          "command_pattern": "^echo 10\\.20\\.32\\.0$",
          "expect_contains": "10.20.32.0",
          "hint": "With a /19, the block size in the third octet is 32. In the Terminal tab, run `echo 10.20.32.0` for the second subnet's network address (the first is 10.20.0.0)."
        }
      ],
      "success_message": "Carved correctly \u2014 /19 subnets on 32-address boundaries in the third octet. Branch addressing plan: done."
