        },
        {
          "command_pattern": "^python3\\s",
          "expect_contains": "192.168.14.63",
          "hint": "The same command should print the broadcast address 192.168.14.63 for the first /26."
        }
      ],
      "domain_id_remapped_from": "fundamentals",
      "merged_from": "cbt-individual/comptia-network-plus"
