  "domains": [
    {
      "id": "concepts",
      "name": "Networking Concepts",
      "scenarios": [
        {
          "id": "net-plus-osi-ip",
          "title": "The address on the envelope",
          "situation": "A junior tech asks: 'When a packet travels, which OSI layer is responsible for the IP addresses that get it across networks?'",
          "prompt": "Which layer \u2014 and why does the distinction matter for troubleshooting?",
          "choices": [
            "Layer 3, the Network layer \u2014 IP addressing and routing live here; layer mix-ups send you to the wrong tools",
            "Layer 2, the Data Link layer \u2014 IP addresses are MAC addresses",
            "Layer 4, the Transport layer \u2014 ports are the same as IP addresses",
            "Layer 7, the Application layer \u2014 DNS handles all addressing"
          ],
          "answer": 0,
          "why": "IP addresses belong to Layer 3 (Network): they provide logical, hierarchical addressing that routers use to forward between networks. Layer 2 MAC addresses only matter within a single broadcast domain. The distinction matters because a Layer 3 problem (wrong subnet, bad gateway) needs completely different tools than a Layer 2 problem (bad cable, duplex mismatch).",
          "hint": "MAC addresses get a frame across one wire; what gets a packet across ten networks?",
          "objectives": [
            "OSI model",
            "Encapsulation"
          ],
          "mins": 5
        },
        {
          "id": "net-plus-tcp-udp",
          "title": "The video call versus the file",
          "situation": "You are choosing transport protocols: a live video call and a payroll file transfer, both crossing the WAN.",
          "prompt": "Which protocol suits each, and why?",
          "choices": [
            "UDP for the video call (speed over perfection), TCP for the file (every byte must arrive intact and in order)",
            "TCP for both \u2014 reliability is always the priority",
            "UDP for both \u2014 speed is always the priority",
            "It does not matter; the application decides nothing"
          ],
          "answer": 0,
          "why": "TCP is connection-oriented with sequencing, acknowledgments, and retransmission \u2014 perfect for a file where one flipped byte corrupts payroll. UDP skips all that overhead for speed \u2014 perfect for live video, where a late packet is useless anyway and the codec conceals small losses. Choosing the transport is choosing which guarantee matters.",
          "hint": "What is worse: a video frame that arrives late, or a paycheck byte that arrives wrong?",
          "objectives": [
            "TCP vs UDP",
            "Transport layer"
          ],
          "mins": 6
        },
        {
          "id": "net-plus-fiber-campus",
          "title": "The two-kilometer link",
          "situation": "Two campus buildings 2 km apart need a 10 Gbps link. The conduit is already in place, but copper Ethernet maxes out at 100 meters.",
          "prompt": "What medium do you specify?",
          "choices": [
            "Single-mode fiber \u2014 designed for long distances, using laser light over kilometers",
            "Cat6a copper \u2014 it can be stretched to 2 km with signal boosters",
            "Multimode fiber \u2014 cheaper, and distance does not matter for fiber",
            "Coaxial cable \u2014 it was good enough for the old network"
          ],
          "answer": 0,
          "why": "Single-mode fiber uses a narrow core and laser light to carry signals for kilometers \u2014 it is the standard answer for campus and metro links. Multimode is cheaper but limited to hundreds of meters (fine inside a building, wrong between them). Copper cannot span 2 km at 10 Gbps no matter the category.",
          "hint": "Copper taps out at 100 meters. Which glass is built for kilometers, and what lights it?",
          "objectives": [
            "Cabling and media",
            "Fiber types"
          ],
          "mins": 6
        },
        {
          "id": "net-plus-connector",
          "title": "The patch panel puzzle",
          "situation": "You need to connect a switch's SFP fiber port to the fiber patch panel. The panel ports are small, square-ish, with a latch \u2014 two of them side by side per link.",
          "prompt": "Which connector type do you order?",
          "choices": [
            "LC \u2014 the small-form-factor latch connector standard for SFP fiber links",
            "RJ45 \u2014 the standard for all switch connections",
            "BNC \u2014 the bayonet connector for fiber",
            "DB-9 \u2014 the serial connector, adapted for fiber"
          ],
          "answer": 0,
          "why": "LC (Lucent Connector) is the small-form-factor fiber connector with a latch, designed for SFP/SFP+ transceivers \u2014 the duplex pair you describe is the classic LC duplex. RJ45 is copper, BNC is coax, and DB-9 is serial. Matching the connector to the transceiver is day-one physical-layer literacy.",
          "hint": "SFP cages are tiny. Which fiber connector was made tiny to match?",
          "objectives": [
            "Connectors",
            "Physical layer"
          ],
          "mins": 5
        },
        {
          "id": "net-plus-topology",
          "title": "The switch that took everyone down",
          "situation": "A small office runs a star topology: every PC connects to one central switch. That switch fails at 10 a.m. and the whole office is offline.",
          "prompt": "What does this teach about topology, and what is the fix?",
          "choices": [
            "The central switch is a single point of failure \u2014 add redundancy: a second switch, dual uplinks, or NIC teaming on critical hosts",
            "Star topologies are obsolete \u2014 rewire as a bus",
            "The PCs should have been wireless instead",
            "Topology does not matter; switches never fail"
          ],
          "answer": 0,
          "why": "A star's strength (simple, cheap, easy to troubleshoot) is also its weakness: the center is a single point of failure. The design lesson is redundancy where downtime hurts \u2014 a second switch, aggregated uplinks, or at minimum a cold spare on the shelf. Mesh topologies eliminate the SPOF but cost far more; engineering is choosing where the risk is acceptable.",
          "hint": "One box, everybody dark. What is the name for that kind of risk?",
          "objectives": [
            "Topologies",
            "High availability"
          ],
          "mins": 6
        },
        {
          "id": "net-plus-binary-why",
          "title": "Why the router counts in binary",
          "situation": "A trainee is frustrated: 'Why do I need binary? The addresses are already in decimal.' The address on the whiteboard is 192.168.1.0/24.",
          "prompt": "What is the correct explanation?",
          "choices": [
            "The /24 is a count of binary 1-bits in the mask \u2014 you cannot understand what the prefix length means without binary",
            "Binary is only for programmers; network techs never use it",
            "Decimal is enough because routers display decimal",
            "Subnet masks are random numbers assigned by the ISP"
          ],
          "answer": 0,
          "why": "An IPv4 address is a 32-bit binary number wearing a decimal costume \u2014 192.168.1.0 is 11000000.10101000.00000001.00000000. The /24 means the first 24 of those bits are network, and the mask 255.255.255.0 is twenty-four 1-bits followed by eight 0-bits. Every subnetting decision \u2014 how many subnets, how many hosts \u2014 is binary arithmetic, so the decimal is just the display format.",
          "hint": "The slash is counting something. What is it counting, one by one?",
          "objectives": [
            "Binary fundamentals",
            "IPv4 addressing"
          ],
          "mins": 6
        },
        {
          "id": "net-plus-encap-order",
          "title": "The packet's journey down the stack",
          "situation": "A trainee mixes up the order: 'Does the IP header go on before or after the Ethernet header?'",
          "prompt": "What is the correct encapsulation order as data moves down the OSI stack?",
          "choices": [
            "Data -> segment (TCP) -> packet (IP) -> frame (Ethernet) -> bits on the wire",
            "Data -> frame -> packet -> segment -> bits",
            "Data -> bits -> frame -> packet -> segment",
            "Data -> packet -> segment -> frame -> bits"
          ],
          "answer": 0,
          "why": "Encapsulation works top-down: the Transport layer wraps data into a segment (adding ports), the Network layer wraps that into a packet (adding IP addresses), the Data Link layer wraps that into a frame (adding MAC addresses), and the Physical layer transmits bits. Each layer's header is read by its peer on the other end \u2014 that is why the order is fixed.",
          "hint": "Think of nested envelopes, each stamped by a different post office. Which office stamps first?",
          "objectives": [
            "Encapsulation",
            "OSI model"
          ],
          "mins": 5
        }
      ]
    },
    {
      "id": "implementation",
      "name": "Network Implementation",
      "scenarios": [
        {
          "id": "net-plus-subnet-four",
          "title": "Four subnets from one /24",
          "situation": "You have 192.168.10.0/24 and need four equal subnets for four departments, each needing at least 50 host addresses.",
          "prompt": "What is the correct subnetting plan?",
          "choices": [
            "Borrow 2 bits: /26 subnets (255.255.255.192), 62 usable hosts each \u2014 192.168.10.0, .64, .128, .192",
            "Borrow 3 bits: /27 subnets, 30 usable hosts each",
            "Use /30 subnets \u2014 2 usable hosts each is plenty",
            "Keep the /24 whole and assign departments by VLAN only"
          ],
          "answer": 0,
          "why": "Four subnets need 2 borrowed bits (2^2 = 4). The mask becomes /26 (255.255.255.192), each subnet holds 64 addresses minus network and broadcast = 62 usable hosts \u2014 comfortably over 50. The subnets fall on 64-address boundaries: .0, .64, .128, .192. Borrowing 3 bits would give 8 subnets of only 30 hosts \u2014 failing the requirement.",
          "hint": "How many bits must you borrow to get four subnets \u2014 and how many hosts survive in each?",
          "objectives": [
            "Subnetting",
            "IPv4 addressing"
          ],
          "mins": 9,
          "evidence": [
            [
              "Requirement",
              "Network: 192.168.10.0/24\nSubnets needed: 4\nHosts per subnet: >= 50"
            ]
          ]
        },
        {
          "id": "net-plus-subnet-ptp",
          "title": "The point-to-point link",
          "situation": "Two routers connect over a serial point-to-point link. You must assign the smallest possible subnet \u2014 wasting addresses here is sloppy.",
          "prompt": "Which prefix is correct for exactly two usable host addresses?",
          "choices": [
            "/30 (255.255.255.252) \u2014 4 addresses, 2 usable: one per router",
            "/24 \u2014 plenty of room for growth",
            "/31 \u2014 the modern answer everywhere",
            "/29 \u2014 6 usable hosts, safe margin"
          ],
          "answer": 0,
          "why": "A point-to-point link has exactly two endpoints, so /30 gives 4 total addresses minus network and broadcast = 2 usable \u2014 a perfect fit with zero waste. (Some platforms support /31 for point-to-point per RFC 3021, but /30 remains the classic exam-safe answer for 'two usable hosts'.) Oversizing to /24 burns 252 addresses for nothing.",
          "hint": "Two routers, two addresses needed. What is 2^2 minus the two reserved?",
          "objectives": [
            "Subnetting",
            "Prefix lengths"
          ],
          "mins": 6
        },
        {
          "id": "net-plus-vlan-voice",
          "title": "The VLAN that leaked",
          "situation": "Voice phones and PCs share one flat network. Broadcast traffic is heavy, and anyone with Wireshark can sniff voice calls.",
          "prompt": "What is the correct design change?",
          "choices": [
            "Create separate voice and data VLANs with an 802.1Q trunk to the router for inter-VLAN routing",
            "Buy a faster switch \u2014 bandwidth fixes everything",
            "Change all IPs to a different subnet but keep one broadcast domain",
            "Disable broadcast traffic on the PCs"
          ],
          "answer": 0,
          "why": "VLANs split one physical switch into multiple logical broadcast domains: voice in one, data in another. 802.1Q tags trunked frames so the router can route between VLANs while broadcasts stay contained \u2014 which also keeps voice traffic away from curious sniffers. New IPs alone change nothing about who hears broadcasts.",
          "hint": "Broadcasts go everywhere the wire goes. How do you build walls without new wires?",
          "objectives": [
            "VLANs",
            "Switching"
          ],
          "mins": 7
        },
        {
          "id": "net-plus-dhcp-scope",
          "title": "The scope that ran dry",
          "situation": "New devices get 169.254.x.x addresses while older ones work fine. The DHCP scope shows 0 free leases.",
          "prompt": "What is the diagnosis and the fix?",
          "choices": [
            "Scope exhaustion \u2014 shorten the lease time, reconcile stale leases, and expand the scope",
            "The DHCP server is hacked \u2014 wipe it",
            "New devices need static IPs from now on",
            "The switch is blocking DHCP \u2014 replace it"
          ],
          "answer": 0,
          "why": "Older devices hold valid leases while new ones get APIPA: the scope is exhausted, usually by stale leases held long past their usefulness. Shortening lease duration lets dead leases expire, reconciling clears the ghosts, and expanding the scope prevents recurrence. The pattern \u2014 some work, newcomers fail \u2014 is the fingerprint of exhaustion.",
          "hint": "The old-timers have addresses and the newcomers do not. What ran out?",
          "objectives": [
            "DHCP",
            "IPAM"
          ],
          "mins": 6
        },
        {
          "id": "net-plus-gateway",
          "title": "Local yes, internet no",
          "situation": "A PC pings everything on its own subnet but cannot reach anything beyond it \u2014 no internet, no other subnets.",
          "prompt": "What is the most likely misconfiguration?",
          "choices": [
            "Missing or wrong default gateway \u2014 the PC has no route off its subnet",
            "Wrong DNS server",
            "Bad Ethernet cable",
            "The PC's IP is APIPA"
          ],
          "answer": 0,
          "why": "Reaching the local subnet proves the NIC, cable, IP, and mask are fine; failing beyond it means the PC does not know where to send off-subnet traffic \u2014 the default gateway's job. DNS would break names but not IPs, and a bad cable would break everything. The gateway is the door out of the subnet, and this PC cannot find it.",
          "hint": "It can talk to its neighbors but not the next town. Who gives directions out of town?",
          "objectives": [
            "Routing concepts",
            "Default gateway"
          ],
          "mins": 5
        },
        {
          "id": "net-plus-ipv6-loopback",
          "title": "The IPv6 loopback",
          "situation": "You are documenting the IPv6 addressing plan and need the loopback address for testing, plus the link-local range for neighbor discovery.",
          "prompt": "Which are correct?",
          "choices": [
            "Loopback ::1; link-local fe80::/10",
            "Loopback 127.0.0.1; link-local 169.254.0.0/16",
            "Loopback ::ffff:127.0.0.1; link-local 192.168.0.0/16",
            "Loopback 0:0:0:0:0:0:0:1 is deprecated; use 127.0.0.1"
          ],
          "answer": 0,
          "why": "IPv6 loopback is ::1 (all zeros except the last bit \u2014 the compressed form of 0:0:0:0:0:0:0:1), and link-local addresses live in fe80::/10, auto-configured on every interface for neighbor discovery. The 127.0.0.1 and 169.254.0.0/16 answers are IPv4 concepts wearing the wrong costume.",
          "hint": "128 bits, eight hextets, and a lot of zeros to compress. What is the shortest possible address?",
          "objectives": [
            "IPv6 addressing",
            "Address types"
          ],
          "mins": 6
        },
        {
          "id": "net-plus-wireless-config",
          "title": "The warehouse Wi-Fi",
          "situation": "A warehouse needs Wi-Fi for scanners. The 2.4 GHz band is crowded with neighboring networks; the space is large and open with high shelves.",
          "prompt": "What is the best wireless design?",
          "choices": [
            "Use 5 GHz with multiple APs on non-overlapping channels, WPA3-Enterprise, and a site survey for placement",
            "One powerful 2.4 GHz AP at maximum power in the corner",
            "Open Wi-Fi with no password for easy scanner onboarding",
            "Hide the SSID \u2014 security through obscurity"
          ],
          "answer": 0,
          "why": "Warehouses need capacity and coverage: 5 GHz offers more non-overlapping channels and less neighbor interference, multiple APs with a proper site survey cover the shelving dead zones, and WPA3-Enterprise with 802.1X gives per-device credentials instead of one shared passphrase on a clipboard. One max-power AP creates a loud, unreliable cell; open Wi-Fi invites everyone.",
          "hint": "Big space, metal shelves, crowded airwaves. What beats one loud AP?",
          "objectives": [
            "Wireless configuration",
            "WLAN design"
          ],
          "mins": 7
        }
      ]
    },
    {
      "id": "operations",
      "name": "Network Operations",
      "scenarios": [
        {
          "id": "net-plus-snmp-monitor",
          "title": "The blind NOC",
          "situation": "The NOC cannot see device health \u2014 they learn about full disks and dead fans from users calling in. You need standardized remote monitoring of routers, switches, and servers.",
          "prompt": "Which protocol and approach fit?",
          "choices": [
            "SNMP \u2014 poll devices for metrics (CPU, interface counters, uptime) and receive traps on UDP 161/162",
            "SMTP \u2014 email the devices and ask how they feel",
            "FTP \u2014 download the health as a file every morning",
            "Telnet \u2014 log into each device hourly and eyeball it"
          ],
          "answer": 0,
          "why": "SNMP is the standard for device monitoring: managers poll agents for OIDs covering CPU, memory, interface errors, and uptime, while agents fire traps to the manager on events. It is built for exactly this \u2014 fleet-wide, automated visibility \u2014 where manual logins and user complaints are not monitoring at all.",
          "hint": "You need numbers from a hundred boxes without logging into any of them. What asks and listens?",
          "objectives": [
            "Monitoring",
            "SNMP"
          ],
          "mins": 6
        },
        {
          "id": "net-plus-baseline",
          "title": "Slow \u2014 compared to what?",
          "situation": "Users say 'the network is slow today.' Nobody can say what normal looks like \u2014 there are no recorded measurements of typical throughput, latency, or utilization.",
          "prompt": "What is missing, and what do you do first?",
          "choices": [
            "A performance baseline \u2014 measure normal first, then compare; without it, 'slow' is not a diagnosis",
            "More bandwidth \u2014 slow always means buy bigger pipes",
            "A new ISP \u2014 the current one is obviously at fault",
            "Faster PCs for all users"
          ],
          "answer": 0,
          "why": "A baseline is the recorded normal: throughput, latency, jitter, utilization at known times. Without it you cannot distinguish a real degradation from a busy Monday, and every 'slow' report becomes a guessing game. Measure first, then the next complaint has something to be compared against.",
          "hint": "Slow compared to what? If you cannot answer that, what can you not do?",
          "objectives": [
            "Performance metrics",
            "Baselines"
          ],
          "mins": 5
        },
        {
          "id": "net-plus-diagram",
          "title": "The outage with no map",
          "situation": "A core switch fails and nobody knows which uplinks feed which closets \u2014 the only 'diagram' is in a former admin's head, and they left last year.",
          "prompt": "What documentation would have prevented the scramble?",
          "choices": [
            "Current physical and logical network diagrams plus labeled wiring and an asset inventory",
            "A longer maintenance contract",
            "More redundant hardware everywhere",
            "A bigger whiteboard"
          ],
          "answer": 0,
          "why": "Physical diagrams show what connects to what and where; logical diagrams show addressing, VLANs, and routing; labeling and inventory tie them to reality. Together they turn an outage from archaeology into procedure. Redundancy helps availability, but documentation is what lets humans act correctly under pressure.",
          "hint": "The map left with the person. What should never live only in a person?",
          "objectives": [
            "Documentation",
            "Network diagrams"
          ],
          "mins": 5
        },
        {
          "id": "net-plus-ha-uplink",
          "title": "The single uplink",
          "situation": "A branch office connects to headquarters over one router with one WAN link. When it flaps, the branch is an island.",
          "prompt": "What is the correct availability improvement?",
          "choices": [
            "Add a redundant path \u2014 a second link and first-hop redundancy (HSRP/VRRP) so a failure fails over automatically",
            "Buy a faster single link \u2014 speed is reliability",
            "Schedule outages for nights so nobody notices",
            "Give the branch a bigger switch"
          ],
          "answer": 0,
          "why": "High availability means no single point of failure in the path: a second WAN link plus first-hop redundancy (HSRP/VRRP) lets traffic fail over without human intervention. A faster single link is still a single link \u2014 speed does not survive a cut fiber. Design for failure, not just for load.",
          "hint": "One wire, one island. What turns one wire into a path that survives?",
          "objectives": [
            "High availability",
            "Redundancy"
          ],
          "mins": 6
        },
        {
          "id": "net-plus-syslog",
          "title": "Logs everywhere, answers nowhere",
          "situation": "Each switch and router keeps its own logs locally, which rotate away in days. After an incident, the evidence on the key device is already gone.",
          "prompt": "What is the fix?",
          "choices": [
            "Centralized syslog \u2014 forward all device logs to a syslog server (UDP/TCP 514) with retention and search",
            "Disable logging to save disk space",
            "Log only errors, never informational messages",
            "Copy logs by hand every Friday"
          ],
          "answer": 0,
          "why": "Centralized syslog gives every device's logs one home with retention, timestamps, and search \u2014 so post-incident forensics has evidence instead of rotated-away emptiness. Local-only logging with short rotation is the same as no logging the week after an incident. Severity filtering is fine, but centralization is the structural fix.",
          "hint": "The evidence existed \u2014 for three days, on one box. Where should it have lived?",
          "objectives": [
            "Logging",
            "Syslog"
          ],
          "mins": 5
        },
        {
          "id": "net-plus-change-window",
          "title": "The noon firmware upgrade",
          "situation": "An admin wants to upgrade core switch firmware at noon 'because the window is quiet.' No rollback plan exists and users were not notified.",
          "prompt": "What is the correct process?",
          "choices": [
            "Follow change management: risk assessment, maintenance window off-hours, tested rollback plan, stakeholder notification",
            "Noon is fine if it is quick",
            "Skip the rollback plan \u2014 firmware upgrades never fail",
            "Just do not tell users; they will not notice"
          ],
          "answer": 0,
          "why": "Changes to production infrastructure go through change management: assess risk and impact, schedule a maintenance window when impact is lowest, have a tested back-out plan, and notify stakeholders. 'Quiet noon' is still production hours, and a failed upgrade without a rollback plan turns minutes of work into hours of outage.",
          "hint": "If the firmware bricks the switch at 12:05, what is the plan at 12:06?",
          "objectives": [
            "Change management",
            "Policies"
          ],
          "mins": 6
        },
        {
          "id": "net-plus-qos-voice",
          "title": "The choppy calls",
          "situation": "Voice calls break up every afternoon when backups run. Data throughput is fine \u2014 only real-time voice suffers.",
          "prompt": "What is the correct remediation?",
          "choices": [
            "Implement QoS \u2014 classify and prioritize voice traffic so backups cannot starve it",
            "Buy more bandwidth \u2014 voice needs bigger pipes",
            "Move backups to tape",
            "Tell users to call in the morning instead"
          ],
          "answer": 0,
          "why": "This is a classic QoS case: bulk backup traffic saturates queues and voice \u2014 which needs low latency and jitter, not raw bandwidth \u2014 arrives late and choppy. QoS markings (DSCP) and priority queuing guarantee voice its slice regardless of the backup flood. More bandwidth helps until the next bulk job; prioritization fixes the actual contention.",
          "hint": "The pipe is full of backups and the voice is drowning. Do you need a bigger pipe or a lifeguard?",
          "objectives": [
            "QoS",
            "Performance"
          ],
          "mins": 7
        }
      ]
