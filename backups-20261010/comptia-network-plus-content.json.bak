    {
      "id": "comptia-network-plus-lab2",
      "domain_id": "concepts",
      "title": "Run the Core Diagnostic Toolkit",
      "objective": "Practice the standard CLI sequence for a 'cannot reach the server' ticket: verify local config, test Layer 3, test name resolution, and map the path \u2014 in methodology order.",
      "steps": [
        "Step 1 (identify): inspect local addressing with ip addr (Linux) or ipconfig /all (Windows) \u2014 record IP, mask, gateway, DNS servers.",
        "Ping the default gateway by IP to confirm the local link, then ping a public IP (e.g., 8.8.8.8) to confirm routed connectivity.",
        "Ping a hostname (e.g., example.com). If IP pings succeed but the name fails, run nslookup example.com (or dig example.com) to isolate DNS.",
        "Run traceroute (Linux) or tracert (Windows) toward the target and note the last responding hop.",
        "Write a one-line conclusion naming the faulty layer: physical/link, network, or name resolution."
      ],
      "checks": [
        {
          "command_pattern": "^ping\\s",
          "expect_contains": "ttl=",
          "hint": "Run ping against an IP address \u2014 successful replies include a ttl= field in the output."
        },
        {
          "command_pattern": "^(nslookup|dig)\\s",
          "expect_contains": "Address",
          "hint": "Query DNS for a hostname with nslookup (or dig) \u2014 the answer section contains an Address line."
