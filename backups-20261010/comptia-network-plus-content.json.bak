      ],
      "domain_id_remapped_from": "troubleshooting",
      "merged_from": "cbt-individual/comptia-network-plus"
    },
    {
      "id": "comptia-network-plus-lab3",
      "domain_id": "concepts",
      "title": "Audit Open Ports and Harden the Host",
      "objective": "Scan a host, identify risky cleartext services from the results, and write a hardening plan that closes or replaces them.",
      "steps": [
        "Run a service-version scan: nmap -sV 192.168.14.10 (use the lab target address).",
        "List every open TCP port with its service and version from the output.",
        "Flag cleartext services (Telnet 23, FTP 21, HTTP 80 without redirect) and any service you cannot justify.",
        "Write the hardening plan: disable Telnet in favor of the existing SSH (22), replace FTP with SFTP/SCP, and redirect HTTP to HTTPS (443).",
        "Re-scan after the changes and confirm only justified ports remain open."
      ],
      "checks": [
        {
          "command_pattern": "^nmap\\s",
          "expect_contains": "open",
          "hint": "Run nmap -sV against the target \u2014 the results table marks reachable services as 'open'."
        },
        {
          "command_pattern": "^nmap\\s",
          "expect_contains": "23/tcp",
          "hint": "The version scan should reveal the Telnet port (23/tcp) you are auditing for removal."
        }
      ],
      "domain_id_remapped_from": "security",
      "merged_from": "cbt-individual/comptia-network-plus"
    }
