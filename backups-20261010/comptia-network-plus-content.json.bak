  "simulations": [
    {
      "id": "net-plus-sim-vlan-leak",
      "title": "The VLAN that leaked",
      "kind": "troubleshoot",
      "domain_id": "implementation",
      "difficulty": 2,
      "brief": "After a switch replacement, voice phones work but PCs on the data VLAN cannot reach the internet. The old switch did this fine. Work the evidence in order.",
      "steps": [
        {
          "symptom": "Phones (VLAN 20) work. PCs (VLAN 10) get no DHCP and cannot reach the gateway.",
          "evidence": [
            [
              "ipconfig (PC)",
              "IPv4: 169.254.44.10\nGateway: (none)"
            ],
            [
              "Switch port status",
              "Gi0/1 (to router): access VLAN 1\nGi0/2-24: access VLAN 10"
            ]
          ],
          "options": [
            "Replace the router \u2014 it must have failed during the swap",
            "The uplink to the router is an access port instead of an 802.1Q trunk \u2014 reconfigure Gi0/1 as a trunk carrying VLANs 10 and 20",
            "Assign static IPs to all PCs",
            "Reboot the phones to free up DHCP leases"
          ],
          "correct": 1,
          "explain": "The PCs' APIPA addresses say DHCP never reached them, and the port evidence shows why: the router uplink is an access port in VLAN 1, so tagged VLAN 10/20 traffic has no path to the router. The fix is an 802.1Q trunk on the uplink carrying both VLANs \u2014 the phones worked only because voice traffic was already handled elsewhere."
        },
        {
          "symptom": "Uplink is now a trunk, but PCs still get no DHCP. The router's subinterfaces exist for both VLANs.",
          "evidence": [
            [
              "Trunk status",
              "Gi0/1: trunk, allowed VLANs: 1"
            ],
            [
              "Router subinterfaces",
              "Gi0/0.10 (VLAN 10): 192.168.10.1/24\nGi0/0.20 (VLAN 20): 192.168.20.1/24"
            ]
          ],
          "options": [
            "The trunk is the problem \u2014 convert it back to access",
            "Add VLANs 10 and 20 to the trunk's allowed list \u2014 pruning is dropping the tagged frames",
            "Replace the DHCP server",
            "Change the PCs to VLAN 1"
          ],
          "correct": 1,
          "explain": "The trunk exists but its allowed-VLAN list contains only VLAN 1 \u2014 classic over-pruning. Tagged frames for 10 and 20 are dropped at the trunk. Adding the VLANs to the allowed list completes the path: PC -> access port (VLAN 10) -> trunk -> router subinterface -> DHCP."
        },
        {
          "symptom": "PCs now receive 192.168.10.x addresses and reach the internet. Phones still work.",
          "evidence": [
            [
              "ipconfig (PC)",
              "IPv4: 192.168.10.45\nGateway: 192.168.10.1"
            ]
          ],
          "options": [
            "Close the ticket \u2014 connectivity is restored",
            "Verify DHCP, routing, and voice quality on a sample of each VLAN, then document the trunk and allowed-VLAN configuration",
            "Remove VLAN 20 since the phones worked without the trunk",
            "Set all ports back to access VLAN 1 for simplicity"
          ],
          "correct": 1,
          "explain": "Verify both VLANs fully \u2014 addressing, gateway reachability, and voice quality \u2014 because the swap touched shared infrastructure. Then document the trunk config and allowed VLANs so the next replacement does not repeat the outage. Connectivity restored is not the same as verified and documented."
        }
      ],
      "debrief": "You diagnosed a trunking failure in two layers: missing trunk, then pruned trunk. VLAN problems are almost always about what the trunk carries \u2014 check mode first, allowed list second.",
      "points": 20
    },
    {
      "id": "net-plus-sim-half-offline",
      "title": "Half the office is offline",
      "kind": "troubleshoot",
      "domain_id": "net-troubleshoot",
      "difficulty": 2,
      "brief": "Monday 9 a.m.: half the office cannot get on the network. The other half is fine. The weekend brought twenty new hires with laptops.",
      "steps": [
        {
          "symptom": "Affected machines show 169.254.x.x; unaffected machines hold 10.1.1.x leases.",
          "evidence": [
            [
              "DHCP scope",
              "Scope 10.1.1.0/24: 253/254 leased"
            ],
            [
              "Timeline",
              "20 new laptops joined Friday afternoon"
            ]
          ],
          "options": [
            "The switch is failing \u2014 replace it",
            "Scope exhaustion from the new hires \u2014 shorten lease time, reconcile stale leases, expand the scope",
            "The ISP is down for half the office",
            "Reinstall NIC drivers on all affected machines"
          ],
          "correct": 1,
          "explain": "Twenty new devices against one free lease is arithmetic, not mystery: the scope is exhausted. Old leases keep working while newcomers get APIPA \u2014 the exact fingerprint. Shorten leases so stale ones expire, reconcile the ghosts, and expand the scope for headroom."
        },
        {
          "symptom": "Scope expanded to a /23 and leases shortened, but three machines still show APIPA after renewing.",
          "evidence": [
            [
              "ipconfig (stubborn PC)",
              "IPv4: 169.254.9.2"
            ],
            [
              "Switch port",
              "Gi0/17: err-disabled"
            ]
          ],
          "options": [
            "Expand the scope again \u2014 it must still be exhausted",
            "The port is err-disabled (likely a port-security violation or loop) \u2014 investigate the port, clear the cause, re-enable it",
            "Replace those three PCs",
            "Disable DHCP and go static everywhere"
          ],
          "correct": 1,
          "explain": "Err-disabled is the switch protecting itself \u2014 typically a port-security violation, a loop, or excessive errors. The port is administratively down, so no DHCP conversation can happen on it. Find the cause (rogue switch? too many MACs?), clear it, and re-enable the port; the scope fix already solved everyone else."
        },
        {
          "symptom": "All machines now hold 10.1.x.x leases and reach the network. The err-disabled port was a new hire's travel switch creating a loop.",
          "evidence": [
            [
              "Scope",
              "10.1.0.0/23: 271/510 leased"
            ],
            [
              "Port Gi0/17",
              "up, single MAC, STP blocking the loop port"
            ]
          ],
          "options": [
            "Close the ticket",
            "Verify a sample of previously affected machines, enable STP loop protection where missing, and document the new scope and lease policy",
            "Ban personal switches with no written policy",
            "Extend leases back to 30 days"
          ],
          "correct": 1,
          "explain": "Two root causes, two preventions: scope sizing and lease policy for the exhaustion, STP loop guard for the travel switch. Verify the sample, harden the edge against loops, and document \u2014 otherwise the next hiring wave replays the morning."
        }
      ],
      "debrief": "You read APIPA's fingerprint twice \u2014 once for exhaustion, once for a dead port \u2014 and fixed causes, not symptoms. Scoping by 'who works and who does not' is the whole game.",
      "points": 20
    },
    {
      "id": "net-plus-sim-slow-wan",
      "title": "The slow WAN",
      "kind": "troubleshoot",
      "domain_id": "operations",
      "difficulty": 3,
      "brief": "The branch's WAN link tests at full speed at 6 a.m. but crawls every afternoon. The carrier insists their circuit is clean.",
      "steps": [
        {
          "symptom": "6 a.m.: 95 Mbps. 2 p.m.: 8 Mbps with high latency. No errors on the carrier handoff.",
          "evidence": [
            [
              "Utilization graph",
              "06:00 12% util\n14:00 98% util, latency 240ms"
            ],
            [
              "Top talkers 14:00",
              "Backup server -> offsite: 78 Mbps"
            ]
          ],
          "options": [
            "The carrier is lying \u2014 escalate aggressively",
            "Afternoon backups saturate the link \u2014 the pattern is utilization, not a fault; reschedule or rate-limit backups and consider QoS",
            "Replace the branch router",
            "Upgrade the LAN switches"
          ],
          "correct": 1,
          "explain": "The utilization graph is the diagnosis: the link is fine at 6 a.m. and saturated at 2 p.m. by backups. A fault would not keep office hours. The fix is traffic management \u2014 move backups off-hours, rate-limit them, and protect interactive traffic with QoS \u2014 not new hardware."
        },
        {
          "symptom": "Backups rescheduled to midnight, but afternoons still show 60% utilization with bursty latency spikes.",
          "evidence": [
            [
              "Interface counters",
              "FCS errors rising on the WAN port\nCollisions: 0 (full duplex)"
            ],
            [
              "Speed/duplex",
              "Router: auto | Provider CPE: 100/full forced"
            ]
          ],
          "options": [
            "The backups are still running \u2014 reschedule again",
            "Duplex mismatch between auto-negotiating router and forced-full provider CPE \u2014 match the settings (both auto or both forced)",
            "The cable is too long",
            "Buy a bigger WAN circuit"
          ],
          "correct": 1,
          "explain": "Rising FCS errors with zero collisions on a full-duplex link is the duplex-mismatch fingerprint: the auto side fell back to half-duplex while the forced side stays full, so one's transmissions look like errors to the other. Matching both sides to auto (or both forced identically) clears it \u2014 a configuration fix, not a capacity problem."
        },
        {
          "symptom": "Duplex matched, backups at midnight, afternoons now run at 35% utilization with 18ms latency. Users report the link feels new.",
          "evidence": [
            [
              "Utilization graph",
              "14:00 35% util, latency 18ms\n00:00 backup window: 88% util"
            ]
          ],
          "options": [
            "Close the ticket \u2014 performance is restored",
            "Verify with a week of monitoring against the new baseline, document the backup window and duplex standard, and set a utilization alert threshold",
            "Keep tuning \u2014 35% is still too high",
            "Remove the QoS policy since the link is fast now"
          ],
          "correct": 1,
          "explain": "One good afternoon is not a baseline: monitor for a week to confirm the pattern holds, document the backup window and the duplex standard so the next device swap does not reintroduce the mismatch, and set an alert before utilization creeps back up. Prevention is the last methodology step for a reason."
        }
      ],
      "debrief": "You separated utilization from faults, read FCS errors as a duplex fingerprint, and closed with baselines and alerts. Performance troubleshooting is measurement plus pattern recognition.",
      "points": 25
    }
  ],
  "consoleSims": [
    {
      "id": "netplus-csim-1",
      "title": "Open DNS for the new resolver",
      "console": "firewall",
      "domain_id": "comptia-network-plus",
      "difficulty": 1,
      "brief": "The new internal DNS resolver must answer queries from the 192.168.1.0/24 LAN. DNS needs both UDP and TCP port 53. Add both ACCEPT rules on the INPUT chain.",
      "tasks": [
        {
          "id": "t1",
          "instruction": "Allow UDP port 53 from 192.168.1.0/24.",
          "validate": {
            "action": "add-rule",
            "params": {
              "chain": "INPUT",
              "protocol": "udp",
              "port": "53",
              "source": "192.168.1.0/24",
              "action": "ACCEPT"
            }
          },
          "hint": "Rules tab \u2192 Add rule: CHAIN=INPUT, PROTOCOL=udp, PORT=53, SOURCE=192.168.1.0/24, ACTION=ACCEPT"
        },
        {
          "id": "t2",
          "instruction": "Allow TCP port 53 from 192.168.1.0/24.",
          "validate": {
            "action": "add-rule",
            "params": {
              "chain": "INPUT",
              "protocol": "tcp",
              "port": "53",
              "source": "192.168.1.0/24",
              "action": "ACCEPT"
            }
          },
          "hint": "Same form with PROTOCOL=tcp \u2014 zone transfers and large DNS replies need TCP."
        }
      ],
      "debrief": "DNS is the classic 'works by IP, fails by name' culprit, and it needs both UDP and TCP 53. Network+ loves asking which ports a service needs \u2014 memorize the pairs."
    },
    {
      "id": "netplus-csim-2",
      "title": "Kill legacy Telnet at the border",
      "console": "firewall",
      "domain_id": "comptia-network-plus",
      "difficulty": 2,
      "brief": "Security policy bans Telnet (port 23) \u2014 it sends credentials in cleartext. Block it in both directions on this host: no outbound Telnet, and no inbound Telnet from anywhere.",
      "tasks": [
        {
          "id": "t1",
          "instruction": "DROP outbound TCP port 23.",
          "validate": {
            "action": "add-rule",
            "params": {
              "chain": "OUTPUT",
              "protocol": "tcp",
              "port": "23",
              "source": "0.0.0.0/0",
              "action": "DROP"
            }
          },
          "hint": "CHAIN=OUTPUT, PROTOCOL=tcp, PORT=23, SOURCE=0.0.0.0/0, ACTION=DROP"
        },
        {
          "id": "t2",
          "instruction": "DROP inbound TCP port 23 from anywhere.",
          "validate": {
            "action": "add-rule",
            "params": {
              "chain": "INPUT",
              "protocol": "tcp",
              "port": "23",
              "source": "0.0.0.0/0",
              "action": "DROP"
            }
          },
          "hint": "CHAIN=INPUT with the same values \u2014 block the listener side too."
        }
      ],
      "debrief": "Telnet vs SSH is the textbook insecure-vs-secure protocol swap. Blocking both chains closes the loop: nobody can Telnet out, and nobody can Telnet in."
    },
    {
      "id": "netplus-csim-3",
      "title": "Stand up the management VLAN",
      "console": "switch-cli",
      "domain_id": "comptia-network-plus",
      "difficulty": 2,
      "brief": "Switch management interfaces are moving to VLAN 99 (named MGMT) for isolation, and the uplink on Gi0/24 must trunk all VLANs to the core. Build the VLAN, trunk the uplink, save.",
      "tasks": [
        {
          "id": "t1",
          "instruction": "Create VLAN 99 named MGMT.",
          "validate": {
            "action": "create-vlan",
            "params": {
              "id": "99",
              "name": "MGMT"
            }
          },
          "hint": "Type: vlan 99 name MGMT"
        },
        {
          "id": "t2",
          "instruction": "Make Gi0/24 a trunk.",
          "validate": {
            "action": "set-trunk",
            "params": {
              "port": "Gi0/24"
            }
          },
          "hint": "Type: interface Gi0/24 trunk"
        },
        {
          "id": "t3",
          "instruction": "Save the configuration.",
          "validate": {
            "action": "save-config",
            "params": {}
          },
          "hint": "Type: write memory"
        }
      ],
      "debrief": "A dedicated management VLAN keeps admin traffic off user broadcast domains \u2014 a Network+ design best practice \u2014 and the trunk carries it (plus everything else) upstream."
    },
    {
      "id": "netplus-csim-4",
      "title": "File the maintenance change ticket",
      "console": "ticketing",
      "domain_id": "comptia-network-plus",
      "difficulty": 1,
      "brief": "Tonight's core-switch firmware window (22:00\u201323:00) is approved. File a P2 change ticket, attach the approval note, and assign it to netops.",
      "tasks": [
        {
          "id": "t1",
          "instruction": "Create a P2 ticket titled exactly: Change: core switch firmware 22:00-23:00",
          "validate": {
            "action": "create-ticket",
            "params": {
              "title": "Change: core switch firmware 22:00-23:00",
              "priority": "P2"
            }
          },
          "hint": "New ticket tab \u2014 copy the title exactly, it becomes INC-9002."
        },
        {
          "id": "t2",
          "instruction": "Add the note: Change board approved; rollback plan on file.",
          "validate": {
            "action": "add-note",
            "params": {
              "id": "INC-9002",
              "text": "Change board approved; rollback plan on file."
            }
          },
          "hint": "Add note form with the exact text."
        },
        {
          "id": "t3",
          "instruction": "Assign INC-9002 to netops.",
          "validate": {
            "action": "assign-ticket",
            "params": {
              "id": "INC-9002",
              "assignee": "netops"
            }
          },
          "hint": "Assign form: TICKET ID=INC-9002, ASSIGNEE=netops"
        }
      ],
      "debrief": "Network+ change management: every change gets documented, approved, and assigned before it happens \u2014 with a rollback plan, always."
    }
  ],
  "foundations": [
    {
      "track": "networking",
      "why_needed": "Network+ assumes two math fluencies: binary-to-decimal conversion (IP addresses and masks are 32-bit numbers) and subnetting (splitting networks, counting hosts, finding ranges and broadcasts). This track refreshes both before the drills begin."
    }
  ],
