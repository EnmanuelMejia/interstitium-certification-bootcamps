  "behavioral": [
    {
      "prompt": "Tell me about a time you had to explain a network outage to non-technical staff or leadership.",
      "framework": "STAR",
      "points": [
        "The outage and who needed to understand it",
        "How you translated it \u2014 the analogy or plain language, no jargon",
        "How you confirmed understanding and what decision or patience it bought"
      ],
      "pitfalls": [
        "Hiding behind acronyms",
        "Blaming users for not understanding",
        "No confirmation they got it"
      ]
    },
    {
      "prompt": "Describe a high-pressure network incident you worked \u2014 what was your role and how did you keep it structured?",
      "framework": "STAR",
      "points": [
        "The incident, its impact, and your specific role",
        "How you stayed methodical \u2014 what you checked in what order",
        "The outcome and what changed afterward"
      ],
      "pitfalls": [
        "Hero narrative with no method",
        "Skipping the team",
        "No lessons learned"
      ]
    },
    {
      "prompt": "Tell me about a change you made that went wrong \u2014 and how you recovered.",
      "framework": "STAR",
      "points": [
        "The change and what went wrong \u2014 own your part plainly",
        "How you detected it and executed the rollback or fix",
        "The process change that prevents a repeat"
      ],
      "pitfalls": [
        "Blaming the equipment or the vendor",
        "No rollback described",
        "Claiming you have never had one"
      ]
    },
    {
      "prompt": "Give an example of network documentation you created that someone else relied on.",
      "framework": "STAR",
      "points": [
        "What you documented \u2014 diagram, runbook, addressing plan \u2014 and why",
        "The moment someone used it and what it saved",
        "How you keep it current"
      ],
      "pitfalls": [
        "Saying documentation is someone else's job",
        "Vague claims with no instance",
        "No maintenance plan"
      ]
    },
    {
      "prompt": "Describe a time you resolved a finger-pointing situation between teams or vendors during an outage.",
      "framework": "STAR",
      "points": [
        "The dispute and what each side claimed",
        "The evidence you gathered \u2014 captures, logs, tests \u2014 that settled it",
        "How you kept it professional and what the fix was"
      ],
      "pitfalls": [
        "Taking sides without evidence",
        "Escalating the conflict",
        "No evidence described"
      ]
    },
    {
      "prompt": "Tell me about a security-versus-usability trade-off you had to make or recommend.",
      "framework": "STAR",
      "points": [
        "The tension \u2014 what security wanted versus what users needed",
        "How you evaluated the risk and who you involved in the decision",
        "The outcome and how you communicated it"
      ],
      "pitfalls": [
        "Security at all costs with no business sense",
        "Usability at all costs with no risk sense",
        "Deciding alone in a vacuum"
      ]
    },
    {
      "prompt": "Tell me about a misconfiguration you caused or found \u2014 how did you handle it?",
      "framework": "STAR",
      "points": [
        "What was misconfigured and what the impact was",
        "How you found it, fixed it, and verified the fix",
        "What check or habit you added so it does not recur"
      ],
      "pitfalls": [
        "Minimizing the impact",
        "Fixing without verifying",
        "No preventive habit added"
      ]
    },
    {
      "prompt": "Describe a time you mentored a junior colleague on a networking concept or troubleshooting skill.",
      "framework": "STAR",
      "points": [
        "The person, their level, and what they were stuck on",
        "How you taught it \u2014 hands-on, analogy, guided practice",
        "How you knew it stuck"
      ],
      "pitfalls": [
        "Doing it for them instead of teaching",
        "Condescension",
        "No evidence they learned"
      ]
    }
  ],
  "chat": {
    "persona": "You are a friendly but rigorous CompTIA Network+ practice coach running a mock assessment. Probe OSI/TCP-IP, addressing and subnetting, switching and VLANs, wireless, security, operations, and troubleshooting with follow-ups, correct misconceptions gently but firmly, and make the learner show binary-level reasoning where it counts. Never reproduce real exam questions.",
    "topics": [
      {
        "id": "concepts",
        "name": "Networking Concepts",
        "key_points": [
          "OSI seven layers",
          "encapsulation order",
          "TCP vs UDP",
          "fiber types and connectors",
          "topologies",
          "binary fundamentals"
        ],
        "followups": [
          "Which layer handles IP addresses, and why does it matter?",
          "Walk me through the encapsulation order."
        ]
      },
      {
        "id": "implementation",
        "name": "Network Implementation",
        "key_points": [
          "subnetting math",
          "block boundaries",
          "VLANs and 802.1Q",
          "DHCP DORA",
          "default gateway",
          "IPv6 addressing"
        ],
        "followups": [
          "Subnet 192.168.10.0/24 into four subnets \u2014 show your work.",
          "Why does the host count always subtract two?"
        ]
      },
      {
        "id": "operations",
        "name": "Network Operations",
        "key_points": [
          "SNMP polling and traps",
          "performance baselines",
          "physical vs logical diagrams",
          "HSRP/VRRP redundancy",
          "centralized syslog",
          "QoS prioritization"
        ],
        "followups": [
          "Users say 'slow' \u2014 what is your first question?",
          "What breaks when every log lives only on its own device?"
        ]
      },
      {
        "id": "net-security",
        "name": "Network Security",
        "key_points": [
          "firewall rules by port",
          "IDS vs IPS",
          "client-to-site vs site-to-site VPN",
          "evil twin and rogue AP",
          "ARP spoofing and DAI",
          "segmentation"
        ],
        "followups": [
          "Why is IDS alone not enough to stop an attack?",
          "One IP maps to two MACs \u2014 what is happening?"
        ]
      },
      {
        "id": "net-troubleshoot",
        "name": "Network Troubleshooting",
        "key_points": [
          "methodology order",
          "inside-out ping testing",
          "traceroute",
          "nslookup/dig",
          "cable and duplex faults",
          "packet capture"
        ],
        "followups": [
          "Where do you ping first, and why?",
          "What do rising FCS errors on a port tell you?"
        ]
      }
    ]
  },
  "labs": [
    {
      "id": "net-plus-lab-1",
      "title": "Map the path \u2014 ping and traceroute",
      "objective": "Verify reachability with ping, then use traceroute to list every hop and identify where a path breaks.",
      "steps": [
        "This lab reworks the Network Troubleshooting scenarios 'Where do you ping first?' and 'Where do the packets die?' into commands you run yourself.",
        "Open the Terminal tab for this bootcamp \u2014 every command below runs there.",
        "Type exactly: ping -c 4 192.168.1.1 \u2014 four echo requests to the gateway; watch for Reply lines and 0% packet loss",
        "Type exactly: traceroute 203.0.113.8 \u2014 each hop prints in order with round-trip times; asterisks mark hops that do not answer",
        "Read the last responding hop before the timeouts \u2014 say in your own words which device or provider owns the fault.",
        "Type exactly: ping -c 4 127.0.0.1 \u2014 the loopback baseline: if this ever fails, the fault is your own stack, not the network."
      ],
      "checks": [
        {
          "command_pattern": "^ping -c 4 192\\.168\\.1\\.1$",
          "expect_contains": "0% packet loss",
          "hint": "In the Terminal tab, run `ping -c 4 192.168.1.1`. If the check fails, confirm you typed it exactly and that the output contains \"0% packet loss\"."
        },
        {
          "command_pattern": "^traceroute 203\\.0\\.113\\.8$",
          "expect_contains": "hop",
          "hint": "In the Terminal tab, run `traceroute 203.0.113.8`. If the check fails, confirm you typed it exactly and that the output contains \"hop\"."
        }
      ],
      "success_message": "Lab complete \u2014 you test inside out and read the exact hop where paths die. Vague WAN tickets fear you now."
    },
    {
      "id": "net-plus-lab-2",
      "title": "Interrogate DNS \u2014 nslookup and dig",
      "objective": "Query DNS directly with nslookup and dig, read which server answered, and distinguish record problems from server problems.",
      "steps": [
        "This lab reworks the Network Troubleshooting scenario 'The name that will not resolve' into commands you run yourself.",
        "Open the Terminal tab for this bootcamp \u2014 every command below runs there.",
        "Type exactly: nslookup intranet.lab.local \u2014 note the Server line (who answered) and the Address lines (what it returned)",
        "Type exactly: dig intranet.lab.local \u2014 the ANSWER SECTION shows the record; the SERVER line shows who answered",
        "Type exactly: dig intranet.lab.local MX \u2014 ask for mail exchanger records to see record-type selection in action",
        "In your own words, say how you would tell 'the record is missing' apart from 'the client is asking the wrong server'."
      ],
      "checks": [
        {
          "command_pattern": "^nslookup intranet\\.lab\\.local$",
          "expect_contains": "Server",
          "hint": "In the Terminal tab, run `nslookup intranet.lab.local`. If the check fails, confirm you typed it exactly and that the output contains \"Server\"."
        },
        {
          "command_pattern": "^dig intranet\\.lab\\.local$",
          "expect_contains": "ANSWER SECTION",
          "hint": "In the Terminal tab, run `dig intranet.lab.local`. If the check fails, confirm you typed it exactly and that the output contains \"ANSWER SECTION\"."
        }
      ],
      "success_message": "Lab complete \u2014 you question DNS directly instead of guessing. The phone book has no secrets from you."
    },
    {
      "id": "net-plus-lab-3",
      "title": "Read the host \u2014 ip addr and ss",
      "objective": "Read interface addressing with ip addr and list listening sockets with ss, mapping ports to services.",
      "steps": [
        "Open the Terminal tab for this bootcamp \u2014 every command below runs there.",
        "Type exactly: ip addr \u2014 find the inet line: it shows the IPv4 address with its prefix length (e.g., 192.168.1.44/24)",
        "From that prefix length, say the subnet mask and network address in your own words",
        "Type exactly: ss -tuln \u2014 listening TCP and UDP sockets, numeric \u2014 the modern replacement for netstat",
        "Match each listening port to a service: 22 is SSH, 53 is DNS, 80/443 are web \u2014 say what an unexpected open port would prompt you to do."
      ],
      "checks": [
        {
          "command_pattern": "^ip addr$",
          "expect_contains": "inet ",
          "hint": "In the Terminal tab, run `ip addr`. If the check fails, confirm you typed it exactly and that the output contains \"inet \"."
        },
        {
          "command_pattern": "^ss -tuln$",
          "expect_contains": "LISTEN",
          "hint": "In the Terminal tab, run `ss -tuln`. If the check fails, confirm you typed it exactly and that the output contains \"LISTEN\"."
        }
      ],
      "success_message": "Lab complete \u2014 addressing and listening sockets read at a glance. You see the host the way the network sees it."
    },
    {
      "id": "net-plus-lab-4",
      "title": "Subnet on the wire \u2014 calculate and prove",
      "objective": "Given a host address with a prefix length, compute the network address and broadcast address, then verify connectivity reasoning.",
      "steps": [
        "This lab turns the Network Implementation subnetting scenarios into a drill you run yourself.",
        "Open the Terminal tab for this bootcamp \u2014 every command below runs there.",
        "Type exactly: ip addr \u2014 the lab host shows inet 192.168.10.77/27",
        "On paper or in your head: /27 means a 32-address block; 77 falls in the 64-95 block, so the network address is 192.168.10.64 and broadcast is 192.168.10.95",
        "Type exactly: echo 192.168.10.64 \u2014 submit the network address you computed",
        "Type exactly: echo 192.168.10.95 \u2014 submit the broadcast address you computed",
        "Type exactly: ping -c 2 192.168.10.94 \u2014 the last usable host in the subnet; a reply proves your range math describes a real, reachable subnet."
      ],
      "checks": [
        {
          "command_pattern": "^echo 192\\.168\\.10\\.64$",
          "expect_contains": "192.168.10.64",
          "hint": "Compute the /27 network address for 192.168.10.77/27, then in the Terminal tab run `echo 192.168.10.64` with your answer. Block size 32; which block holds 77?"
        },
        {
          "command_pattern": "^echo 192\\.168\\.10\\.95$",
          "expect_contains": "192.168.10.95",
          "hint": "Compute the /27 broadcast address for 192.168.10.77/27, then in the Terminal tab run `echo 192.168.10.95` with your answer. It is the last address of the block."
        },
        {
          "command_pattern": "^ping -c 2 192\\.168\\.10\\.94$",
          "expect_contains": "0% packet loss",
          "hint": "In the Terminal tab, run `ping -c 2 192.168.10.94`. If the check fails, confirm you typed it exactly and that the output contains \"0% packet loss\"."
        }
      ],
      "success_message": "Lab complete \u2014 network, broadcast, and last usable host computed and proven. Subnetting is now a skill, not a formula."
    },
    {
      "id": "net-plus-lab-5",
      "title": "Trust but verify \u2014 the ARP table",
      "objective": "Inspect the ARP table with ip neigh, recognize a healthy gateway mapping, and spot the fingerprint of ARP spoofing.",
      "steps": [
        "This lab reworks the Network Security scenario 'The poisoned cache' into commands you run yourself.",
        "Open the Terminal tab for this bootcamp \u2014 every command below runs there.",
        "Type exactly: ip neigh \u2014 the neighbor table: each IP maps to exactly one MAC in the REACHABLE state",
        "Find the gateway entry (192.168.1.1) and note its single MAC address \u2014 that is the healthy baseline",
        "Now imagine a second machine claiming the same gateway IP with a different MAC \u2014 say in your own words what attack that is and which switch feature stops it",
        "Type exactly: ping -c 2 192.168.1.1 \u2014 confirm the gateway still answers while you think like an attacker spotting the lie."
      ],
      "checks": [
        {
          "command_pattern": "^ip neigh$",
          "expect_contains": "REACHABLE",
          "hint": "In the Terminal tab, run `ip neigh`. If the check fails, confirm you typed it exactly and that the output contains \"REACHABLE\"."
        },
        {
          "command_pattern": "^ping -c 2 192\\.168\\.1\\.1$",
          "expect_contains": "0% packet loss",
          "hint": "In the Terminal tab, run `ping -c 2 192.168.1.1`. If the check fails, confirm you typed it exactly and that the output contains \"0% packet loss\"."
        }
      ],
      "success_message": "Lab complete \u2014 you read ARP tables and know the spoofing fingerprint. Dynamic ARP Inspection is your answer when one IP wears two MACs."
    },
    {
      "id": "comptia-network-plus-lab1",
      "domain_id": "concepts",
      "title": "Carve a /24 into Four /26 Subnets",
      "objective": "Subnet 192.168.14.0/24 into four /26 networks and document each subnet's network address, usable range, and broadcast address using the terminal to verify your math.",
      "steps": [
        "Decide how many host bits a /26 leaves (32 - 26) and compute usable hosts with 2^(host bits) - 2.",
        "List the four /26 network addresses that tile 192.168.14.0/24.",
        "For the first subnet, write the network address, first usable host, last usable host, and broadcast address.",
        "Verify with Python's ipaddress module: python3 -c \"import ipaddress; n=ipaddress.ip_network('192.168.14.0/26'); print(n.network_address, list(n.hosts())[0], list(n.hosts())[-1], n.broadcast_address)\"",
        "Repeat the verification for 192.168.14.64/26 and confirm the pattern: each /26 advances the network address by 64."
      ],
      "checks": [
        {
          "command_pattern": "^python3\\s",
          "expect_contains": "192.168.14.1",
