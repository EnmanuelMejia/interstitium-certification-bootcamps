      "steps": [
        "Open the Terminal tab.",
        "Type exactly: SELECT name, salary FROM employees ORDER BY salary DESC; \u2014 top earner?",
        "Type exactly: SELECT name FROM employees WHERE dept = 'Data'; \u2014 who is on the Data team?",
        "Type exactly: SELECT name, hired FROM employees ORDER BY hired; \u2014 longest tenure first?",
        "Sorting changes the story: what does each ordering emphasize?"
      ],
      "success_message": "Lab complete \u2014 sorted and filtered. ORDER BY is the analyst's spotlight.",
      "title": "Sort and filter \u2014 SQL drill"
    },
    {
      "checks": [
        {
          "command_pattern": "SELECT COUNT\\(\\*\\) FROM employees",
          "expect_contains": "6",
          "hint": "Run `SELECT COUNT(*) FROM employees;`."
        },
        {
          "command_pattern": "SELECT DISTINCT dept FROM employees",
          "expect_contains": "3 row(s)",
          "hint": "Run `SELECT DISTINCT dept FROM employees;`."
        },
        {
          "command_pattern": "amount > 1000",
          "expect_contains": "3",
          "hint": "Run `SELECT COUNT(*) FROM orders WHERE amount > 1000;`."
        }
      ],
      "difficulty": 2,
      "id": "data-analyst-lab-7",
      "objective": "Summary statistics: counts, distinct categories, threshold counts.",
      "steps": [
        "Open the Terminal tab.",
        "Type exactly: SELECT COUNT(*) FROM employees; \u2014 headcount.",
        "Type exactly: SELECT DISTINCT dept FROM employees; \u2014 how many departments?",
        "Type exactly: SELECT COUNT(*) FROM orders WHERE amount > 1000; \u2014 big-ticket orders.",
        "Type exactly: SELECT COUNT(*) FROM orders WHERE status = 'shipped'; \u2014 fulfillment rate numerator.",
        "Compute the shipped share (shipped / total) in your head. What is it?"
      ],
      "success_message": "Lab complete \u2014 summary stats. Counts and shares are the vocabulary of reporting.",
      "title": "Summary statistics \u2014 SQL drill"
    },
    {
      "checks": [
        {
          "command_pattern": "SELECT id, product, status FROM orders WHERE status = 'pending'",
          "expect_contains": "pending",
          "hint": "Run `SELECT id, product, status FROM orders WHERE status = 'pending';` to see the two pending orders."
        },
        {
          "command_pattern": "UPDATE orders SET status = 'cancelled' WHERE id = 103",
          "expect_contains": "1 row(s) updated",
          "hint": "Run `UPDATE orders SET status = 'cancelled' WHERE id = 103;`."
        },
        {
          "command_pattern": "SELECT COUNT\\(\\*\\) FROM orders WHERE status = 'pending'",
          "expect_contains": "1",
          "hint": "Re-run the pending count."
        }
      ],
      "difficulty": 3,
      "id": "data-analyst-lab-8",
      "objective": "Correct a mislabeled order and re-verify the pending count.",
      "steps": [
        "Open the Terminal tab.",
        "Type exactly: SELECT id, product, status FROM orders WHERE status = 'pending'; \u2014 the two pending orders.",
        "Business note: order 103 (keyboard) was cancelled by the customer. Fix it.",
        "Type exactly: UPDATE orders SET status = 'cancelled' WHERE id = 103;",
        "Type exactly: SELECT COUNT(*) FROM orders WHERE status = 'pending'; \u2014 should be 1 now.",
        "Type exactly: SELECT COUNT(*) FROM orders WHERE status = 'cancelled'; \u2014 should be 2.",
        "Why verify both the old and new status counts? One sentence."
      ],
      "success_message": "Lab complete \u2014 data corrected with full verification. Analysts fix and prove.",
      "title": "Correct a mislabeled order \u2014 SQL drill"
    },
    {
      "id": "data-analyst-lab1",
      "domain_id": "sql-analysis",
      "title": "Rankings with window functions in sqlite3",
      "objective": "Use RANK() and LAG() in sqlite3 to rank customers by revenue and compute month-over-month change.",
      "steps": [
        "Create a practice database: sqlite3 practice.db \"CREATE TABLE orders(id INTEGER, cust TEXT, amt REAL, m TEXT);\"",
        "Insert sample rows: sqlite3 practice.db \"INSERT INTO orders VALUES (1,'acme',120,'2026-08'),(2,'acme',80,'2026-09'),(3,'globex',300,'2026-09');\"",
        "Verify the grain: sqlite3 practice.db \"SELECT cust, SUM(amt) FROM orders GROUP BY cust;\"",
        "Rank customers: sqlite3 practice.db \"SELECT cust, SUM(amt) AS t, RANK() OVER (ORDER BY SUM(amt) DESC) AS r FROM orders GROUP BY cust;\"",
        "Clean up when done: rm practice.db"
      ],
      "checks": [
        {
          "command_pattern": "^sqlite3 practice\\.db \"SELECT cust, SUM\\(amt\\) FROM",
          "expect_contains": "|",
          "hint": "Run the GROUP BY query against practice.db \u2014 sqlite3 separates columns with |."
        },
        {
          "command_pattern": "^sqlite3 practice\\.db \"SELECT cust, SUM\\(amt\\) AS t, RANK",
          "expect_contains": "|1|",
          "hint": "The top-ranked customer row should end with |1 \u2014 the rank column."
        }
      ],
      "domain_id_remapped_from": "data-analyst",
      "merged_from": "cbt-individual/data-analyst"
    },
    {
      "id": "data-analyst-lab2",
      "domain_id": "sql-analysis",
      "title": "Audit a messy CSV with csvkit",
      "objective": "Profile a messy leads CSV with csvkit, dry-run the cleaning, and produce a cleaned file.",
      "steps": [
        "Confirm csvkit is installed: csvstat --version (install with: pip install csvkit).",
        "Save the lab's sample file as leads.csv in your working directory.",
        "Profile it: csvstat leads.csv \u2014 note the row count, nulls, and unique counts per column.",
        "Dry-run the cleaner: csvclean -n leads.csv \u2014 review what it flags before changing anything.",
        "Clean for real: csvclean leads.csv, then inspect the result: csvcut -c name,email leads_out.csv | head."
      ],
      "checks": [
        {
          "command_pattern": "^csvstat",
          "expect_contains": "Row count",
          "hint": "csvstat prints a 'Row count' summary line \u2014 find it in the output."
        },
        {
          "command_pattern": "^csvclean leads\\.csv$",
          "expect_contains": "leads_out.csv",
          "hint": "csvclean writes the cleaned file as leads_out.csv \u2014 confirm it exists with ls."
        }
      ],
      "domain_id_remapped_from": "data-analyst",
      "merged_from": "cbt-individual/data-analyst"
    }
  ],
  "foundations": [
    {
      "track": "sql",
      "why_needed": "Analysis is querying: SELECT, filter, sort, aggregate. Learn the query language before the BI tools."
    },
    {
      "track": "python",
      "why_needed": "Spreadsheets end where Python begins. Scripting unlocks repeatable analysis."
    }
  ],
  "math": [
    "stats",
    "probability"
  ],
  "simulations": [
    {
      "brief": "A bar chart shows Engineering with the tallest bar, but the y-axis starts at 120000. Leadership thinks Engineering earns triple.",
      "debrief": "Truncated axes exaggerate differences \u2014 the honest fix is a zero baseline (or a dot plot for small differences). Chart choices are analysis choices: the axis is part of the claim.",
      "difficulty": 2,
      "domain_id": "visualization",
      "id": "data-analyst-sim-1",
      "kind": "troubleshoot",
      "points": 15,
      "steps": [
        {
          "correct": 1,
          "evidence": [
            [
              "chart",
              "Bar chart, y-axis from 120000 to 160000; Engineering bar ~3x the Data bar visually"
            ],
            [
              "data",
              "Engineering avg 127333, Data avg 125000 \u2014 a 1.9% difference"
            ]
          ],
          "explain": "The data differs by under 2%, but the truncated axis makes it look 3x. The visual lies while the numbers tell the truth \u2014 reset the axis to zero.",
          "options": [
            "Make the bars 3D for clarity",
            "Reset the y-axis to start at zero",
            "Remove the Data bar",
            "Change to a pie chart"
          ],
          "symptom": "Chart exaggerates a 2% gap into 3x."
        }
      ],
      "title": "The misleading bar chart"
    },
    {
      "brief": "Stakeholders want 'the average salary'. The data has one extreme outlier. Choose the right statistic.",
      "debrief": "With skew, the median represents the typical case; the mean follows the outlier. Report the median as the headline, and mention the mean and the outlier in a footnote \u2014 honesty with context.",
      "difficulty": 2,
      "domain_id": "statistics",
      "id": "data-analyst-sim-2",
      "kind": "branching",
      "points": 15,
      "steps": [
        {
          "choices": [
            {
              "feedback": "Correct: median for the headline, mean + outlier noted for context.",
              "label": "Report the median; footnote the mean and the outlier",
              "next": "END",
              "outcome": "good",
              "points": 2
            },
            {
              "feedback": "The mean alone lets one outlier set the narrative \u2014 misleading.",
              "label": "Report only the mean",
              "next": "END",
              "outcome": "bad",
              "points": 0
            }
          ],
          "id": "s1",
          "text": "Salaries: five around 120-150k, one at 890k (executive). Which average?"
        }
      ],
      "title": "Mean or median?"
    },
    {
      "brief": "Put these analysis steps in order.",
      "debrief": "Understand the question, explore the data, clean it, analyze, then visualize and communicate. Analysis that skips exploration answers the wrong question precisely.",
      "difficulty": 1,
      "domain_id": "storytelling",
      "id": "data-analyst-sim-3",
      "kind": "ordering",
      "points": 10,
      "steps": {
        "context": "An analysis workflow",
        "correct_order": [
          0,
          1,
          2,
          3,
          4
        ],
        "items": [
          "Clarify the business question with the stakeholder",
          "Explore the data: distributions, missing values",
          "Clean: handle nulls, fix mislabeled rows",
          "Analyze: aggregate, compare, test",
          "Visualize and tell the story"
        ]
      },
      "title": "Analysis workflow order"
    },
    {
      "brief": "This dashboard spec is headed for review. Click the problematic lines (2 issues to find).",
      "debrief": "Two dashboard sins: a dual-axis chart comparing unrelated units (invites false correlation), and a KPI with no definition of its denominator (unverifiable). One message per visual; every KPI defined.",
      "difficulty": 3,
      "domain_id": "bi-tools",
      "id": "data-analyst-sim-4",
      "kind": "config-check",
      "points": 10,
      "steps": {
        "config": "Dashboard: Q3 Review\nChart 1: Dual-axis \u2014 headcount (bars) vs avg salary (line)\nKPI 1: 'Fulfillment rate 83%' (no definition)\nChart 2: Order amounts by month, y-axis from 0\nFilter: status = shipped",
        "find": 2,
        "issues": [
          {
            "description": "Dual-axis chart mixes headcount and salary scales \u2014 readers infer correlation that may not exist.",
            "fix": "Split into two charts with honest single axes.",
            "line": 2
          },
          {
            "description": "KPI has no definition \u2014 83% of what? Unverifiable.",
            "fix": "Define the KPI: shipped orders / total orders, with the date range.",
            "line": 3
          }
        ]
      },
      "title": "Review the dashboard spec"
    }
  ],
  "consoleSims": [
    {
      "brief": "Build the headcount-by-department chart for the leadership deck in the BI tool: pick the right visual and aggregation.",
      "console": "sql-studio",
      "debrief": "Bar charts compare categories; the aggregation (COUNT) must match the question (how many per department). The wrong visual or wrong aggregation is how dashboards lie.",
      "difficulty": 2,
      "domain_id": "visualization",
      "id": "data-analyst-console-1",
      "tasks": [
        {
          "hint": "Categories on the axis.",
          "id": "data-analyst-console-1-t1",
          "instruction": "Set the chart type to Bar and the dimension to dept.",
          "validate": {
            "action": "set-field",
            "params": {
              "field": "chart-dimension",
              "value": "dept"
            }
          }
        },
        {
          "hint": "Count people, not salaries.",
          "id": "data-analyst-console-1-t2",
          "instruction": "Set the measure to COUNT of employees.",
          "validate": {
            "action": "set-field",
            "params": {
              "field": "chart-measure",
              "value": "COUNT"
            }
          }
        },
        {
          "hint": "Render it.",
          "id": "data-analyst-console-1-t3",
          "instruction": "Click Render to build the chart.",
          "validate": {
            "action": "click",
            "params": {
              "target": "render-chart"
            }
          }
        }
      ],
      "title": "Build a headcount chart"
    },
    {
      "brief": "A stakeholder asks for 'average order value'. Build the KPI card showing the right average for skewed order data.",
      "console": "sql-studio",
      "debrief": "Skewed data (one huge server order) pulls the mean up \u2014 the median describes the typical order better. Analysts pick the statistic that answers the stakeholder's real question, and say which one they used.",
      "difficulty": 2,
      "domain_id": "statistics",
      "id": "data-analyst-console-2",
      "tasks": [
        {
          "hint": "KPIs need one number.",
          "id": "data-analyst-console-2-t1",
          "instruction": "Create a KPI card on the orders dataset.",
          "validate": {
            "action": "create",
            "params": {
              "name": "aov-kpi",
              "type": "kpi-card"
            }
          }
        },
        {
          "hint": "Skewed data: prefer the median.",
          "id": "data-analyst-console-2-t2",
          "instruction": "Set the aggregation to Median of amount.",
          "validate": {
            "action": "set-field",
            "params": {
              "field": "kpi-aggregation",
              "value": "Median"
            }
          }
        },
        {
          "hint": "Label honestly.",
          "id": "data-analyst-console-2-t3",
          "instruction": "Set the card title to 'Median order value'.",
          "validate": {
            "action": "set-field",
            "params": {
              "field": "kpi-title",
              "value": "Median order value"
            }
          }
        }
      ],
      "title": "Build an honest KPI card"
    }
  ],
  "terminalMissions": [
    {
      "brief": "List the tables.",
      "checks": [
        {
          "command_pattern": "^\\.tables",
          "expect_contains": "orders",
          "hint": "Run `.tables`."
        }
      ],
      "difficulty": 1,
      "domain_id": "sql-analysis",
      "id": "data-analyst-mission-1",
      "objectives": [
        "Show available tables"
      ],
      "success_message": "Mission complete \u2014 tables listed.",
      "title": "Dataset check"
    },
    {
      "brief": "Sample three employees.",
      "checks": [
        {
          "command_pattern": "SELECT \\* FROM employees LIMIT 3",
          "expect_contains": "3 row(s)",
          "hint": "Run `SELECT * FROM employees LIMIT 3;`."
        }
      ],
      "difficulty": 1,
      "domain_id": "sql-analysis",
      "id": "data-analyst-mission-2",
      "objectives": [
        "Return a 3-row sample"
      ],
      "success_message": "Mission complete \u2014 sample taken.",
      "title": "Sample the data"
    },
    {
      "brief": "Count shipped orders.",
      "checks": [
        {
          "command_pattern": "WHERE status = 'shipped'",
          "expect_contains": "3",
          "hint": "Run `SELECT COUNT(*) FROM orders WHERE status = 'shipped';`."
        }
      ],
      "difficulty": 2,
      "domain_id": "sql-analysis",
      "id": "data-analyst-mission-3",
      "objectives": [
        "Count shipped orders"
      ],
      "success_message": "Mission complete \u2014 3 shipped.",
      "title": "Fulfillment count"
    },
    {
      "brief": "List employees hired before 2022.",
      "checks": [
        {
          "command_pattern": "hired < '2022",
          "expect_contains": "Noah Kim",
          "hint": "Run `SELECT name FROM employees WHERE hired < '2022-01-01';`."
        }
      ],
      "difficulty": 2,
      "domain_id": "sql-analysis",
      "id": "data-analyst-mission-4",
      "objectives": [
        "Filter by hire date"
      ],
      "success_message": "Mission complete \u2014 tenure filter done.",
      "title": "Tenure filter"
    },
    {
      "brief": "Find the lowest-paid employee.",
      "checks": [
        {
          "command_pattern": "ORDER BY salary",
          "expect_contains": "Eli Park",
          "hint": "Run `SELECT name FROM employees ORDER BY salary LIMIT 1;`."
        }
      ],
      "difficulty": 3,
      "domain_id": "statistics",
      "id": "data-analyst-mission-5",
      "objectives": [
        "Sort ascending and take the first row"
      ],
      "success_message": "Mission complete \u2014 lowest salary found.",
      "title": "Lowest salary"
    },
    {
      "brief": "Correct order 103 and show the new pending count.",
      "checks": [
        {
          "command_pattern": "UPDATE orders SET status = 'cancelled' WHERE id = 103",
          "expect_contains": "1 row(s) updated",
          "hint": "Run `UPDATE orders SET status = 'cancelled' WHERE id = 103;`."
        },
        {
          "command_pattern": "SELECT COUNT\\(\\*\\) FROM orders WHERE status = 'pending'",
          "expect_contains": "1",
          "hint": "Run `SELECT COUNT(*) FROM orders WHERE status = 'pending';`."
        }
      ],
      "difficulty": 3,
      "domain_id": "sql-analysis",
      "id": "data-analyst-mission-6",
      "objectives": [
        "Fix the order status",
        "Verify the pending count"
      ],
      "success_message": "Mission complete \u2014 data fixed and verified.",
      "title": "Fix and verify"
    }
  ],
