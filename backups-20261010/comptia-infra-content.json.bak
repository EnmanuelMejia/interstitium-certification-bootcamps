          "mins": 4
        },
        {
          "id": "infra-data-sql",
          "title": "Combining the tables",
          "situation": "You need each customer's name alongside their order totals. Customers live in one table, orders in another.",
          "prompt": "What is the correct approach?",
          "choices": [
            "JOIN the tables on the shared customer_id key, then aggregate with GROUP BY",
            "Run two separate queries and merge them by hand in a spreadsheet",
            "Export both tables to CSV and eyeball it",
            "Use SELECT * with no join condition"
          ],
          "answer": 0,
          "why": "A JOIN combines related rows via the key they share; GROUP BY with SUM then rolls orders up per customer. A join without a condition creates a Cartesian product \u2014 every customer times every order \u2014 which is never what you want.",
          "hint": "What relates the two tables to each other?",
          "objectives": [
            "SQL",
            "JOINs"
          ],
          "mins": 6,
          "evidence": [
            [
              "tables",
              "customers(customer_id, name)\norders(order_id, customer_id, total)\n-- need: name + SUM(total) per customer"
            ]
          ]
        },
        {
          "id": "infra-data-etl",
          "title": "Garbage in",
          "situation": "Source systems feed your warehouse dirty data: duplicate rows, wrong date formats, nulls in required fields.",
          "prompt": "Where do you fix it?",
          "choices": [
            "In the ETL pipeline: validate, cleanse, and transform before loading into the warehouse",
            "Load it raw and let analysts fix it in every report",
            "Skip validation to load faster",
            "Fix it by hand each morning"
          ],
          "answer": 0,
          "why": "The transform stage exists to enforce quality once, upstream: standardize formats, dedupe, reject or quarantine bad rows. Cleaning downstream means every report reinvents (and disagrees on) the fixes.",
          "hint": "When is bad data cheapest to catch?",
          "objectives": [
            "ETL",
            "Data quality"
          ],
          "mins": 5
        },
        {
          "id": "infra-data-norm",
          "title": "The duplicated customer",
          "situation": "Customer addresses are stored in every order row. A customer moves, one row gets updated, and now reports show two addresses.",
          "prompt": "What database design principle prevents this?",
          "choices": [
            "Normalization: store the customer once in a customer table and reference it by ID",
            "Store even more copies for safety",
            "Buy a bigger database",
            "Delete the old rows by hand"
          ],
          "answer": 0,
          "why": "Update anomalies come from duplicated facts: normalization keeps each fact in one place, referenced by key, so a change happens once. Denormalization has performance uses, but it trades away this integrity.",
          "hint": "What happens when the address changes in only one copy?",
          "objectives": [
            "Normalization",
            "Data integrity"
          ],
          "mins": 5
        },
        {
          "id": "infra-data-pii",
          "title": "Analytics on customer data",
          "situation": "Analysts want to study purchasing patterns in production customer data that includes names, emails, and card numbers.",
          "prompt": "What is the correct handling?",
          "choices": [
            "Mask or anonymize PII, work on the minimum necessary fields, and enforce retention limits",
            "Give analysts raw production data \u2014 they are employees",
            "Email CSV extracts around for convenience",
            "No controls needed for internal use"
          ],
          "answer": 0,
          "why": "Analytics rarely needs real identities: masking/anonymization plus least-privilege access preserves utility while limiting breach impact and meeting privacy obligations. Raw PII in spreadsheets is how breaches happen.",
          "hint": "Does the analyst need real names and card numbers?",
          "objectives": [
            "PII",
            "Data privacy"
          ],
          "mins": 5
        },
        {
          "id": "infra-data-viz",
          "title": "Showing the trend",
          "situation": "Leadership wants to see monthly revenue over the past two years to judge growth.",
          "prompt": "Which visualization is appropriate?",
          "choices": [
            "A line chart \u2014 it shows change over continuous time",
            "A pie chart of all 24 months",
            "A 3D exploding pie chart",
            "A raw data table with no chart"
          ],
          "answer": 0,
          "why": "Line charts encode time on an axis so trends, seasonality, and inflection points are visible at a glance. Pie charts compare parts of a whole at one moment \u2014 24 slices communicate nothing about growth.",
          "hint": "What shows change across months best?",
          "objectives": [
            "Data visualization",
            "Chart selection"
          ],
          "mins": 4
        }
      ]
    },
    {
      "id": "ops-sec",
      "name": "Operations & Security",
      "scenarios": [
        {
          "id": "infra-ops-backup",
          "title": "The database backup",
          "situation": "A critical database is backed up nightly to disk on the same server. Restores have never been tested.",
          "prompt": "What must change to meet a 4-hour RPO?",
          "choices": [
            "Follow 3-2-1 with offsite copies, back up at least every 4 hours, and test restores regularly",
            "Keep the single nightly copy \u2014 RAID protects it",
            "Back up weekly to save space",
            "Trust that backups work without testing"
          ],
          "answer": 0,
          "why": "RPO is the maximum tolerable data loss: a 4-hour RPO needs backups at least every 4 hours. Same-server copies die with the server (RAID is not backup), and untested restores are unproven \u2014 test on a schedule.",
          "hint": "What does a 4-hour RPO demand of your backup frequency?",
          "objectives": [
            "Backups",
            "RPO"
          ],
          "mins": 6
        },
        {
          "id": "infra-ops-patch",
          "title": "Patch Tuesday for production",
          "situation": "Security patches are released for your production hypervisors and guest servers.",
          "prompt": "What is the correct patching workflow?",
          "choices": [
            "Test in staging first, then deploy in a maintenance window with a rollback plan",
            "Patch production directly \u2014 speed matters most",
            "Never patch production",
            "Enable auto-patching on everything with no oversight"
          ],
          "answer": 0,
          "why": "Patches fix vulnerabilities but can break workloads: staging catches regressions, windows bound the blast radius, and rollback plans bound the outage. Untested production patching trades one risk for another.",
          "hint": "Where do bad patches go first?",
          "objectives": [
            "Patch management",
            "Change control"
          ],
          "mins": 5
        },
        {
          "id": "infra-ops-monitor",
          "title": "Drowning in alerts",
          "situation": "The monitoring system sends 500 emails a day. Engineers now ignore all of them \u2014 including real outages.",
          "prompt": "What is the fix?",
          "choices": [
            "Tune thresholds, aggregate related alerts, and tier severities so critical pages are rare and real",
            "Add more checks for coverage",
            "Ignore everything until something breaks",
            "Disable monitoring to stop the noise"
          ],
          "answer": 0,
          "why": "Alert fatigue is a tuning failure: when everything is critical, nothing is. Baselines drive thresholds, aggregation kills storms, and severity tiers protect the paging channel for genuine emergencies.",
          "hint": "What happens when everything is critical?",
          "objectives": [
            "Monitoring",
            "Alert fatigue"
          ],
          "mins": 5
        },
        {
          "id": "infra-ops-change",
          "title": "The firewall rule request",
          "situation": "A developer needs a new firewall rule opened for a production deployment tonight.",
          "prompt": "What is the correct process?",
          "choices": [
            "Submit a change request: business justification, risk review, approval, implementation, and verification",
            "Add the rule now, document later",
            "Email the firewall admin after adding it",
            "Freeze all firewall changes forever"
          ],
          "answer": 0,
          "why": "Firewall changes alter the security boundary: they need the same change control as any production change \u2014 justification, approval, testing, and a backout plan. 'Temporary' undocumented rules become permanent holes.",
          "hint": "What stops a temporary rule from becoming permanent?",
          "objectives": [
            "Change management",
            "Firewall governance"
          ],
          "mins": 5
        },
        {
          "id": "infra-ops-fw",
          "title": "Auditing the ruleset",
          "situation": "You inherit a firewall with 400 rules, many years old, in random order with no comments.",
          "prompt": "What principles guide the cleanup?",
          "choices": [
            "Default-deny, least privilege, remove unused rules, and order specific rules before general ones",
            "Allow all traffic both directions for simplicity",
            "Rule order does not matter",
            "Stop logging to improve performance"
          ],
          "answer": 0,
          "why": "Firewalls evaluate top-down: specific allows/denies must precede general ones, and an explicit deny-all closes the bottom. Stale rules accumulate risk \u2014 each unused allow is an unreviewed hole. Document every rule's owner and purpose.",
          "hint": "What should the last rule in the list be?",
          "objectives": [
            "Firewall rules",
            "Default deny"
          ],
          "mins": 6
        },
        {
          "id": "infra-ops-incident",
          "title": "The compromised web server",
          "situation": "You confirm a public web server is compromised and beaconing out. It also hosts the company's main site.",
          "prompt": "What are the correct FIRST actions?",
          "choices": [
            "Isolate the host from the network, preserve logs and memory for forensics, and invoke the incident response plan",
            "Keep it running to watch the attacker",
            "Wipe and rebuild it immediately",
            "Hide the incident to avoid embarrassment"
          ],
          "answer": 0,
          "why": "Isolation stops spread and exfiltration; preserving volatile evidence (memory, logs) enables forensics and legal action; the IR plan coordinates the rest. Wiping first destroys evidence, and watching an active compromise risks the whole network.",
          "hint": "What does wiping destroy besides the malware?",
          "objectives": [
            "Incident response",
            "Evidence preservation"
          ],
          "mins": 6
        }
      ]
    },
