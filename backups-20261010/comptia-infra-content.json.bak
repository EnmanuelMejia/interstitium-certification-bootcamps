  "behavioral": [
    {
      "prompt": "Tell me about a production outage you helped resolve. What was your role?",
      "framework": "STAR",
      "points": [
        "Your specific diagnostic steps",
        "How you communicated during the outage",
        "The preventive change afterward"
      ],
      "pitfalls": [
        "No timeline of actions",
        "Skipping the post-mortem"
      ]
    },
    {
      "prompt": "Describe an automation or script you built that saved real time or reduced errors.",
      "framework": "STAR",
      "points": [
        "The manual pain it replaced",
        "How you built and tested it safely",
        "Measurable impact"
      ],
      "pitfalls": [
        "Automation with no testing",
        "No measurable result"
      ]
    },
    {
      "prompt": "Tell me about a time you had to explain downtime or a failed change to stakeholders.",
      "framework": "STAR",
      "points": [
        "Plain-language explanation",
        "How you handled frustration or pressure",
        "What you committed to next"
      ],
      "pitfalls": [
        "Blaming others",
        "Technical jargon as a shield"
      ]
    },
    {
      "prompt": "Describe a change that went wrong in production. How did you recover?",
      "framework": "STAR",
      "points": [
        "Owning your part plainly",
        "The rollback or fix under pressure",
        "The process improvement that followed"
      ],
      "pitfalls": [
        "Hiding the failure",
        "No rollback plan mentioned"
      ]
    },
    {
      "prompt": "Tell me about a time you had to learn a new platform or tool quickly.",
      "framework": "STAR",
      "points": [
        "What you needed to learn and why",
        "Your method: docs, labs, peers",
        "How you proved competence"
      ],
      "pitfalls": [
        "Claiming mastery without evidence",
        "Learning nothing and winging it"
      ]
    },
    {
      "prompt": "Describe how you planned capacity for growth \u2014 servers, storage, or cloud spend.",
      "framework": "STAR",
      "points": [
        "The data you based projections on",
        "How you balanced headroom vs. cost",
        "Whether the plan held up"
      ],
      "pitfalls": [
        "Guessing without data",
        "Ignoring cost entirely"
      ]
    },
    {
      "prompt": "Tell me about your worst on-call week. How did you handle it?",
      "framework": "STAR",
      "points": [
        "How you triaged competing pages",
        "How you stayed effective under fatigue",
        "What changed to reduce the load"
      ],
      "pitfalls": [
        "Heroics with no systemic fix",
        "Complaining without action"
      ]
    },
    {
      "prompt": "Describe a time you mentored a junior admin or engineer.",
      "framework": "STAR",
      "points": [
        "What they were stuck on",
        "How you guided without just doing it",
        "Their progress afterward"
      ],
      "pitfalls": [
        "Doing their work for them",
        "No concrete example"
      ]
    }
  ],
  "chat": {
    "persona": "You are a friendly but rigorous infrastructure interviewer running a mock Cloud+/Linux+/Server+/Data+ assessment. Probe on architecture trade-offs, Linux fluency, and operational discipline; stay Socratic.",
    "topics": [
      {
        "id": "cloud-arch",
        "name": "Cloud Architecture",
        "key_points": [
          "shared responsibility",
          "IaaS/PaaS/SaaS",
          "auto-scaling",
          "object vs block storage",
          "migration strategies",
          "hybrid cloud"
        ],
        "followups": [
          "Where does the provider's responsibility end in IaaS?",
          "When would you lift-and-shift vs refactor?",
          "How do you control cloud costs?"
        ]
      },
      {
        "id": "linux-admin",
        "name": "Linux Administration",
        "key_points": [
          "permissions and chmod",
          "systemd and journalctl",
          "df/du",
          "SSH hardening",
          "cron environments",
          "package trust"
        ],
        "followups": [
          "Why does a script work by hand but fail in cron?",
          "How do you diagnose a failed service?",
          "What makes SSH brute force impossible?"
        ]
      },
      {
        "id": "server-hw",
        "name": "Server Hardware",
        "key_points": [
          "RAID 10 vs 5",
          "ECC memory",
          "redundant PSUs",
          "cooling and airflow",
          "POST diagnostics",
          "out-of-band management"
        ],
        "followups": [
          "When is RAID 10 the right call?",
          "Why do servers use ECC RAM?",
          "How do you manage a server with a dead OS?"
        ]
      },
      {
        "id": "virtualization",
        "name": "Virtualization",
        "key_points": [
          "snapshots vs backups",
          "CPU ready time",
          "containers vs VMs",
          "live migration",
          "Type 1 vs Type 2",
          "VM sprawl"
        ],
        "followups": [
          "Why aren't snapshots backups?",
          "What does high CPU ready time mean?",
          "When do containers beat VMs?"
        ]
      },
      {
        "id": "data",
        "name": "Data Concepts",
        "key_points": [
          "structured vs unstructured",
          "SQL JOINs",
          "ETL and quality",
          "normalization",
          "PII handling",
          "chart selection"
        ],
        "followups": [
          "How do you combine two related tables?",
          "Where do you fix dirty data?",
          "What chart shows a trend over time?"
        ]
      },
      {
        "id": "ops-sec",
        "name": "Operations & Security",
        "key_points": [
          "3-2-1 backups and RPO",
          "patch workflows",
          "alert tuning",
          "change management",
          "firewall default-deny",
          "incident first response"
        ],
        "followups": [
          "What does your RPO demand of backups?",
          "How do you fix alert fatigue?",
          "What is your first move on a compromised host?"
        ]
      }
    ]
  },
  "labs": [
    {
      "id": "comptia-infra-lab-1",
      "title": "Shared responsibility \u2014 shell drill",
      "objective": "Run a short sequence of lab shell commands that demonstrates shared responsibility, then verify each result against the expected output.",
      "steps": [
        "This lab reworks the Cloud Architecture practice scenario \"Whose patch is it?\" into commands you run yourself \u2014 same concept, hands-on instead of multiple choice.",
        "Open the Terminal tab for this bootcamp \u2014 every command below runs there.",
        "Type exactly: whoami \u2014 the shell reports the lab identity 'candidate'",
        "Type exactly: pwd \u2014 the output is an absolute path starting with /",
        "Type exactly: uname \u2014 the kernel name reported is Linux",
        "In your own words, say what each command's output taught you about shared responsibility."
      ],
      "checks": [
        {
          "command_pattern": "whoami",
          "expect_contains": "candidate",
          "hint": "In the Terminal tab, run `whoami`. If the check fails, confirm you typed it exactly and that the output contains \"candidate\"."
        },
        {
          "command_pattern": "pwd",
          "expect_contains": "/",
          "hint": "In the Terminal tab, run `pwd`. If the check fails, confirm you typed it exactly and that the output contains \"/\"."
        },
        {
          "command_pattern": "uname",
          "expect_contains": "Linux",
          "hint": "In the Terminal tab, run `uname`. If the check fails, confirm you typed it exactly and that the output contains \"Linux\"."
        }
      ],
      "success_message": "Lab complete \u2014 shared responsibility practiced hands-on. That's the Interstitium Labs way: run it, see it, own it."
    },
    {
      "id": "comptia-infra-lab-2",
      "title": "Linux permissions \u2014 shell drill",
