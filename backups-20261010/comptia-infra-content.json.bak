  "foundations": [
    {
      "track": "networking",
      "why_needed": "Cloud+ and Server+ assume networking literacy: addresses, DNS, and ports appear in every infrastructure topic."
    },
    {
      "track": "linux-cli",
      "why_needed": "Linux+ is hands-on Linux. Learn files, text tools, and pipes before administration topics assume them."
    }
  ],
  "math": [
    "binary",
    "subnetting"
  ],
  "simulations": [
    {
      "id": "infra-sim-1",
      "title": "The disk that filled up",
      "kind": "troubleshoot",
      "domain_id": "linux-admin",
      "difficulty": 2,
      "brief": "A VM stops accepting writes: the app logs 'No space left on device', but the dashboard shows the disk at 57%.",
      "steps": [
        {
          "symptom": "Writes fail with 'No space left', yet the volume shows 57% used.",
          "evidence": [
            [
              "terminal",
              "$ df\n/dev/sda1  57% /\n$ echo test > /tmp/t\nbash: /tmp/t: No space left on device"
            ]
          ],
          "options": [
            "Suspect inode exhaustion: check inode usage \u2014 a full inode table blocks new files with space to spare",
            "The disk is full",
            "Reboot the VM",
            "Add more RAM"
          ],
          "correct": 0,
          "explain": "'No space left' with free blocks means inodes, not bytes: millions of tiny files (often runaway logs or sessions) exhausted the inode table."
        },
        {
          "symptom": "Confirmed: inode table at 100% on /tmp \u2014 millions of session files.",
          "evidence": [
            [
              "terminal",
              "$ df -i\n/dev/sda1  100% /tmp\n$ ls /tmp | wc -l\n4821031"
            ]
          ],
          "options": [
            "Clear the stale session files and fix the app to clean up sessions (tmpwatch/cron)",
            "Delete random system files",
            "Expand the disk",
            "Ignore /tmp"
          ],
          "correct": 0,
          "explain": "Clear the symptom (stale files) AND the cause (no session cleanup). Disk expansion wouldn't help \u2014 inodes, not bytes, were exhausted."
        },
        {
          "symptom": "Cleanup done. Verify the fix holds.",
          "evidence": [
            [
              "terminal",
              "$ df -i\n/dev/sda1  12% /\n$ echo test > /tmp/t && echo OK\nOK"
            ]
          ],
          "options": [
            "Confirm writes succeed and inode usage is healthy, and the cleanup job is scheduled",
            "Confirm the disk is bigger",
            "Confirm the app restarted",
            "Confirm /tmp is empty"
          ],
          "correct": 0,
          "explain": "Writes succeeding plus healthy inodes plus a scheduled cleanup is the complete fix \u2014 one without the others recurs."
        }
      ],
      "debrief": "'No space left' with free space means inodes. Clear the files, fix the leak (session cleanup), schedule the prevention. df without -i only tells half the story.",
      "points": 15
    },
    {
      "id": "infra-sim-2",
      "title": "Virtualization stack order",
      "kind": "ordering",
      "domain_id": "virtualization",
      "difficulty": 1,
      "brief": "Restore the order of the virtualization stack from silicon to app.",
      "steps": {
        "context": "Arrange the virtualization layers bottom-up.",
        "items": [
          "Physical hardware: CPU, RAM, disk",
          "Hypervisor manages the hardware",
          "Virtual machine: virtual hardware",
          "Guest OS runs on the VM",
          "Application runs on the guest OS"
        ],
        "correct_order": [
          0,
          1,
          2,
          3,
          4
        ]
      },
      "debrief": "Hardware \u2192 hypervisor \u2192 VM \u2192 guest OS \u2192 app. Each layer's failure looks different \u2014 and gets fixed at its own layer.",
      "points": 10
    },
    {
      "id": "infra-sim-3",
      "title": "Scale up or scale out?",
      "kind": "branching",
      "domain_id": "cloud-arch",
      "difficulty": 2,
      "brief": "Choose the scaling strategy for two workloads.",
      "steps": [
        {
          "id": "s1",
          "text": "A stateful database is slow. It holds 2 TB and can't easily shard. Strategy?",
          "choices": [
            {
              "label": "Scale up: bigger instance \u2014 stateful stores with hard sharding limits scale vertically first",
              "next": "s2",
              "points": 2,
              "feedback": "Right: when the data can't split, grow the box. Sharding a 2 TB store under load is a migration, not a scaling event."
            },
            {
              "label": "Scale out: add 10 replicas",
              "next": "END",
              "points": 0,
              "feedback": "Replicas of a write-heavy unshardable store multiply the consistency problem, not the capacity.",
              "outcome": "bad"
            },
            {
              "label": "Delete old data",
              "next": "END",
              "points": 0,
              "feedback": "Deleting production data to fix performance is data loss with extra steps.",
              "outcome": "bad"
            }
          ]
        },
        {
          "id": "s2",
          "text": "A stateless API tier is slow at peak. Strategy?",
          "choices": [
            {
              "label": "Scale out: add instances behind the load balancer \u2014 stateless tiers scale horizontally",
              "next": "END",
              "points": 2,
              "feedback": "Right: stateless means any instance can serve any request \u2014 add more of them.",
              "outcome": "good"
            },
            {
              "label": "Scale up: one giant instance",
              "next": "END",
              "points": 0,
              "feedback": "One giant instance is a single point of failure with a scaling ceiling.",
              "outcome": "bad"
            }
          ]
        }
      ],
      "debrief": "Stateful and hard-to-shard \u2192 scale up. Stateless \u2192 scale out. The workload's statefulness decides, not the cloud bill.",
      "points": 12
    },
    {
      "id": "infra-sim-4",
      "title": "The backup that never ran",
      "kind": "config-check",
      "domain_id": "data",
      "difficulty": 3,
      "brief": "Backups report 'success' but restores find nothing. The backup config has 2 bugs in 8 lines.",
      "steps": {
        "config": "schedule: daily 02:00\nsource: /data\ntarget: /mnt/backup\nretention: 7\nverify: false\nnotify: never\n# last restore test: never\n# owner: infra-team",
        "find": 2,
        "issues": [
          {
            "line": 5,
            "description": "verify: false \u2014 backups are never validated, so silent corruption or empty runs report success.",
            "fix": "Enable verification (checksums/test restores) on every run."
          },
          {
            "line": 7,
            "description": "No restore has ever been tested \u2014 an untested backup is a hope, not a recovery plan.",
            "fix": "Run scheduled restore drills and record the results."
          }
        ]
      },
      "debrief": "Backups are only real if they're verified and restores are tested. 'Success' without verification is a green lie.",
      "points": 10
    }
  ],
  "consoleSims": [
    {
      "id": "infra-console-1",
      "title": "Provision the VM",
      "console": "linux-desktop",
      "domain_id": "virtualization",
      "difficulty": 2,
      "brief": "On the management desktop, provision a new VM from the template.",
      "tasks": [
        {
          "id": "t1",
          "instruction": "Open the virtualization manager.",
          "validate": {
            "action": "click",
            "params": {
              "target": "virt-manager:open"
            }
          },
          "hint": "Use the virtualization management console."
        },
        {
          "id": "t2",
          "instruction": "Create a VM named 'web-02' from the 'ubuntu-template'.",
          "validate": {
            "action": "create",
            "params": {
              "type": "vm",
              "name": "web-02"
            }
          },
          "hint": "Clone from the template, don't build by hand."
        },
        {
          "id": "t3",
          "instruction": "Confirm the VM appears in the inventory as powered off.",
          "validate": {
            "action": "click",
            "params": {
              "target": "virt-manager:vm:web-02"
            }
          },
          "hint": "The new VM should be listed."
        }
      ],
      "debrief": "VMs come from templates: consistent, repeatable, auditable. Hand-built snowflakes are how fleets become unmanageable."
    },
    {
      "id": "infra-console-2",
      "title": "Open the firewall for the app port",
      "console": "firewall",
      "domain_id": "ops-sec",
      "difficulty": 3,
      "brief": "The app listens on 8080 but the firewall drops it. Add a scoped ALLOW rule.",
      "tasks": [
        {
          "id": "t1",
          "instruction": "Open the firewall ruleset.",
          "validate": {
            "action": "click",
            "params": {
              "target": "firewall:rules"
            }
          },
          "hint": "Use the firewall's rules view."
        },
        {
          "id": "t2",
          "instruction": "Create an ALLOW rule: TCP 8080 from the 10.0.0.0/8 network only.",
          "validate": {
            "action": "create",
            "params": {
              "type": "firewall-rule",
              "name": "allow-app-8080"
            }
          },
          "hint": "Scope the source \u2014 never open app ports to the world."
        },
        {
          "id": "t3",
          "instruction": "Verify the rule is active and the app port responds.",
          "validate": {
            "action": "click",
            "params": {
              "target": "firewall:rules:verify"
            }
          },
          "hint": "Check the rule's hit counter."
        }
      ],
      "debrief": "Firewall rules are scoped by source: the app port opens to the internal network, not to everyone. Verify with the hit counter."
    }
  ],
  "terminalMissions": [
    {
      "id": "infra-mission-1",
      "title": "Server roll call",
      "domain_id": "server-hw",
      "difficulty": 1,
      "brief": "Prove the server answers.",
      "objectives": [
        "Print your username",
        "Print the environment",
        "Print the kernel name"
      ],
      "checks": [
        {
          "command_pattern": "^whoami$",
          "expect_contains": "candidate",
          "hint": "Type exactly: whoami"
        },
        {
          "command_pattern": "^env$",
          "expect_contains": "HOSTNAME=interstitium",
          "hint": "Type exactly: env"
        },
        {
          "command_pattern": "^uname$",
          "expect_contains": "Linux",
          "hint": "Type exactly: uname"
        }
      ],
      "success_message": "Roll call complete \u2014 the server is present."
    },
    {
      "id": "infra-mission-2",
      "title": "Service logs",
      "domain_id": "linux-admin",
      "difficulty": 1,
      "brief": "List the logs and extract the errors.",
      "objectives": [
        "List the logs directory",
        "Grep ERROR lines with numbers"
      ],
      "checks": [
        {
          "command_pattern": "^ls logs/$",
          "expect_contains": "app.log",
          "hint": "Type exactly: ls logs/"
        },
        {
          "command_pattern": "^grep -n ERROR logs/app\\.log$",
          "expect_contains": "connection refused",
          "hint": "Type exactly: grep -n ERROR logs/app.log"
        }
      ],
      "success_message": "Logs read \u2014 the service's errors are numbered."
    },
    {
      "id": "infra-mission-3",
      "title": "Workload check",
      "domain_id": "virtualization",
      "difficulty": 2,
      "brief": "Confirm the workload is running.",
      "objectives": [
        "List processes"
      ],
      "checks": [
        {
          "command_pattern": "^ps$",
          "expect_contains": "node server.js",
          "hint": "Type exactly: ps"
        }
      ],
      "success_message": "Workload confirmed \u2014 both services running."
    },
    {
      "id": "infra-mission-4",
      "title": "Capacity snapshot",
      "domain_id": "cloud-arch",
      "difficulty": 2,
      "brief": "Snapshot disk usage and the working directory.",
      "objectives": [
        "Check disk usage",
        "Print the working directory"
      ],
      "checks": [
        {
          "command_pattern": "^df$",
          "expect_contains": "57%",
          "hint": "Type exactly: df"
        },
        {
          "command_pattern": "^pwd$",
          "expect_contains": "/home/candidate",
          "hint": "Type exactly: pwd"
        }
      ],
      "success_message": "Snapshot taken \u2014 disk and directory on record."
    },
    {
      "id": "infra-mission-5",
      "title": "Identity files",
      "domain_id": "ops-sec",
      "difficulty": 3,
      "brief": "Confirm host identity and your identity.",
      "objectives": [
        "Read the hosts file",
        "Print your username"
      ],
      "checks": [
        {
          "command_pattern": "^cat /etc/hosts$",
          "expect_contains": "interstitium",
          "hint": "Type exactly: cat /etc/hosts"
        },
        {
          "command_pattern": "^whoami$",
          "expect_contains": "candidate",
          "hint": "Type exactly: whoami"
        }
      ],
      "success_message": "Identity confirmed \u2014 host and operator on record."
    },
    {
      "id": "infra-mission-6",
      "title": "Time and environment",
      "domain_id": "data",
      "difficulty": 3,
      "brief": "Stamp the time and record the environment.",
      "objectives": [
        "Print the date",
        "Print the environment"
      ],
      "checks": [
        {
          "command_pattern": "^date$",
          "expect_contains": "2026",
          "hint": "Type exactly: date"
        },
        {
          "command_pattern": "^env$",
          "expect_contains": "PATH=",
          "hint": "Type exactly: env"
        }
      ],
      "success_message": "Stamped \u2014 time and environment recorded."
    }
  ],
