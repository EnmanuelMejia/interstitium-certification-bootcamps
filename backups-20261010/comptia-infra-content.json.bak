      "scenarios": [
        {
          "id": "sysanat-cloud-architecture",
          "title": "The Cloud Architecture Mystery",
          "domain_id": "systems-anatomy",
          "situation": "Users report that Cloud Architecture is not working correctly. The obvious checks pass \u2014 the components are online, basic connectivity works. You need to think in systems, not symptoms.",
          "prompt": "Using the systems anatomy method (whole \u2192 cut open \u2192 step through \u2192 pull apart), how would you systematically trace a failure in Cloud Architecture?",
          "choices": [
            "Walk the full journey: start from the trigger, verify each handoff in sequence, check dependencies at every step, and isolate where the flow breaks \u2014 then examine that specific layer",
            "Restart all components \u2014 Cloud Architecture issues are always fixed by restarting",
            "Check the most common cause from memory and apply that fix immediately",
            "Escalate to senior support \u2014 Cloud Architecture is too complex to troubleshoot systematically"
          ],
          "answer": 0,
          "why": "The correct answer is A. Systems thinking means tracing the living flow: (1) Whole: what is Cloud Architecture supposed to do end-to-end? (2) Cut open: what are the layers/stages? (3) Step through: verify each handoff \u2014 where does the expected output diverge from actual? (4) Pull apart: isolate the broken layer and examine it in detail. This method works for any Cloud Architecture failure in Comptia Infra.",
          "hint": "Don't jump to the fix. First map the journey, then find where it breaks.",
          "objectives": [
            "Apply systems anatomy to Cloud Architecture",
            "Trace failures through layered dependencies",
            "Distinguish symptoms from root causes"
          ],
          "mins": 15,
          "evidence": [
            [
              "System Status",
              "All Cloud Architecture components report 'online'. Basic health checks pass."
            ],
            [
              "User Report",
              "Functionality is broken despite green status indicators. The failure is in the flow, not the components."
            ]
          ]
        },
