    {
      "id": "comptia-infra-lab1",
      "domain_id": "cloud-arch",
      "title": "Diagnose the Gateway",
      "objective": "Walk the TCP/IP troubleshooting ladder in the simulated terminal: address, route, gateway reachability, external reachability, name resolution.",
      "steps": [
        "Show addresses with ip -brief addr show and confirm the interface has an IP and mask.",
        "Show the default route with ip route show default.",
        "Ping the gateway with ping -c 3 <gateway-ip> to test the local path.",
        "Ping 8.8.8.8 to test off-subnet routing without DNS.",
        "Resolve a name with getent hosts example.com to test DNS last."
      ],
      "checks": [
        {
          "command_pattern": "^ip\\s",
          "expect_contains": "default via",
          "hint": "Run: ip route show default"
        },
        {
          "command_pattern": "^ping\\s",
          "expect_contains": "0% packet loss",
          "hint": "Run: ping -c 3 <gateway-ip>"
        }
      ],
      "domain_id_remapped_from": "comptia-infra",
      "merged_from": "cbt-individual/comptia-infra"
    },
