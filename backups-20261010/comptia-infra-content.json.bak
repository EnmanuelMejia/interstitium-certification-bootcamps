  },
  "disclaimer": "Independent practice material by Interstitium Labs. Not affiliated with, endorsed by, or sponsored by CompTIA. Confers no certificate. All scenarios are original; no exam content is reproduced.",
  "domains": [
    {
      "id": "cloud-arch",
      "name": "Cloud Architecture",
      "scenarios": [
        {
          "id": "infra-cloud-shared",
          "title": "Whose patch is it?",
          "situation": "A VM running in a public cloud IaaS account is breached through an unpatched operating system. The customer argues the cloud provider should have patched it.",
          "prompt": "Who is responsible for patching the guest OS under the shared-responsibility model?",
          "choices": [
            "The customer \u2014 in IaaS the provider secures the physical layer and hypervisor; the guest OS is yours",
            "The cloud provider \u2014 they own everything below your data",
            "Nobody \u2014 shared means neither side",
            "The OS vendor, automatically"
          ],
          "answer": 0,
          "why": "Shared responsibility splits at the hypervisor for IaaS: the provider secures facilities, hardware, and virtualization; you own the OS, middleware, apps, and data. The line moves up the stack with PaaS and SaaS, but IaaS guests are always the customer's job.",
          "hint": "In IaaS, where does the provider's job end?",
          "objectives": [
            "Shared responsibility",
            "IaaS vs PaaS vs SaaS"
          ],
          "mins": 5
        },
        {
          "id": "infra-cloud-scale",
          "title": "The spiky web app",
          "situation": "An e-commerce app idles most of the day but gets 20x traffic spikes during flash sales. It currently runs on one oversized VM, 24/7.",
          "prompt": "What architecture handles this most cost-effectively?",
          "choices": [
            "A load balancer with auto-scaling: add instances as traffic rises, remove them as it falls",
            "A single even bigger VM running all the time",
            "Vertical scaling by hand before each sale",
            "Move it back on-premises"
          ],
          "answer": 0,
          "why": "Auto-scaling matches capacity to demand automatically, and the load balancer spreads traffic across the fleet. Paying for peak capacity around the clock wastes money; manual vertical scaling is slow and error-prone under flash-sale pressure.",
          "hint": "What matches capacity to demand without a human watching?",
          "objectives": [
            "Auto-scaling",
            "Load balancing"
          ],
          "mins": 6
        },
        {
          "id": "infra-cloud-storage",
          "title": "Picking the storage tier",
          "situation": "An app needs storage for two things: millions of user-uploaded images, and a relational database with heavy random reads and writes.",
          "prompt": "Which pairing is correct?",
          "choices": [
            "Object storage for the images; block storage volumes for the database",
            "Block storage for everything",
            "File storage for everything",
            "Archive tape for the database"
          ],
          "answer": 0,
          "why": "Object storage is built for massive numbers of flat, immutable blobs (images, backups) with HTTP access; databases need low-latency block devices that look like local disks. Matching the access pattern to the storage type is a core Cloud+ skill.",
          "hint": "What storage is built for billions of flat files?",
          "objectives": [
            "Storage types",
            "Object vs block vs file"
          ],
          "mins": 5
        },
        {
          "id": "infra-cloud-migrate",
          "title": "The deadline migration",
          "situation": "A legacy app must leave a colo data center before the contract ends in three months. There is no time for a rewrite.",
          "prompt": "Which migration strategy fits, and what is the trade-off?",
          "choices": [
            "Lift-and-shift (rehost) now to meet the deadline, then plan modernization later \u2014 it carries tech debt into the cloud",
            "Refactor to cloud-native first, deadline or not",
            "Stay and renegotiate at any cost",
            "Rewrite from scratch in three months"
          ],
          "answer": 0,
          "why": "Rehosting moves the app as-is: fastest, lowest risk to the deadline, but you inherit on-prem architectures (and costs) in the cloud. Refactoring is better long-term but cannot fit the timeline \u2014 so rehost now, replatform/refactor in phases.",
          "hint": "What gets you moved before the contract ends?",
          "objectives": [
            "Migration strategies",
            "Rehost vs refactor"
          ],
          "mins": 6
        },
        {
          "id": "infra-cloud-hybrid",
          "title": "The residency requirement",
          "situation": "A healthcare company wants cloud elasticity, but regulations require patient records to stay in-country in facilities it controls.",
          "prompt": "Which deployment model fits?",
          "choices": [
            "Hybrid cloud: regulated data on the private side, elastic workloads bursting to public",
            "All-public cloud \u2014 regulations are just paperwork",
            "All on-premises \u2014 give up elasticity",
            "Ignore the residency rule"
          ],
          "answer": 0,
          "why": "Hybrid keeps sensitive data where the law demands while using public cloud for scale where it is allowed. Data residency and sovereignty requirements are hard constraints that architecture must satisfy, not risks to accept.",
          "hint": "Where must regulated data physically live?",
          "objectives": [
            "Deployment models",
            "Data sovereignty"
          ],
          "mins": 5
        },
        {
          "id": "infra-cloud-cost",
          "title": "The surprise bill",
          "situation": "The monthly cloud bill doubled. Investigation shows dozens of idle dev VMs running 24/7 and untagged resources nobody claims.",
          "prompt": "What is the systematic fix?",
          "choices": [
            "Rightsizing, mandatory tagging with ownership, and auto-shutdown schedules for non-production",
            "Pay the bill and hope next month is better",
            "Buy a bigger discount plan and change nothing",
            "Move to another cloud"
          ],
          "answer": 0,
          "why": "Cloud waste is an operational discipline problem: tagging establishes ownership for chargeback, rightsizing matches instances to actual use, and schedules kill idle dev spend. FinOps basics beat provider-hopping every time.",
          "hint": "What identifies who owns each resource?",
          "objectives": [
            "Cost optimization",
            "Tagging"
          ],
          "mins": 5
        }
      ]
    },
    {
      "id": "linux-admin",
      "name": "Linux Administration",
      "scenarios": [
        {
          "id": "infra-lx-perms",
          "title": "The unreadable web files",
          "situation": "After a restore, the web server returns 403 Forbidden on every page. The files are owned by the deploy user.",
          "prompt": "What is wrong and what is the fix?",
          "choices": [
            "Files are 600 \u2014 the web server user cannot read them; set files to 644 and directories to 755",
            "Set everything to 777 so nothing is ever blocked",
            "Change ownership to root",
            "Reinstall the web server"
          ],
          "answer": 0,
          "why": "600 gives read/write to the owner only; the web server runs as a different user and needs read on files plus read+execute on directories to traverse them. 644/755 is the standard; 777 hands write access to everyone \u2014 a vulnerability, not a fix.",
          "hint": "What does the web server user need \u2014 read, write, or both?",
          "objectives": [
            "Linux permissions",
            "chmod"
          ],
          "mins": 5,
          "evidence": [
            [
              "terminal",
              "$ ls -l /var/www/html/index.html\n-rw------- 1 deploy deploy 1832 Oct 3 09:00 index.html"
            ]
          ]
        },
        {
          "id": "infra-lx-systemd",
          "title": "The failed service",
          "situation": "After a reboot, the application service did not start. The config file was edited yesterday.",
          "prompt": "What is the correct diagnostic sequence?",
          "choices": [
            "systemctl status app.service, then journalctl -u app.service to read the failure logs",
            "Reboot again and hope",
            "Reinstall the application",
            "kill -9 the service"
          ],
          "answer": 0,
          "why": "systemctl status shows the state and the most recent log lines; journalctl -u gives the full story, usually a config syntax error from yesterday's edit. Guessing with reinstalls wastes the evidence systemd already collected.",
          "hint": "Where does systemd keep the service's last words?",
          "objectives": [
            "systemd",
            "journalctl"
          ],
          "mins": 5
        },
        {
          "id": "infra-lx-disk",
          "title": "Root filesystem full",
          "situation": "A Linux host alerts: the root filesystem is at 100%. The application data lives on a separate mounted volume with free space.",
          "prompt": "How do you find and fix it?",
          "choices": [
            "Use du to find the growth (often /var/log), then rotate, compress, or archive \u2014 never delete blindly",
            "Run rm -rf /var to clear space fast",
            "Add RAM",
            "Reboot and hope the filesystem recovers"
          ],
          "answer": 0,
          "why": "df identifies the full filesystem, du -sh /* drills into the culprit \u2014 typically unrotated logs. Deleting system directories breaks the OS; logrotate plus archival fixes the cause and prevents recurrence.",
          "hint": "Which command shows where the gigabytes actually are?",
          "objectives": [
            "Disk management",
            "du/df"
          ],
          "mins": 6
        },
        {
          "id": "infra-lx-ssh",
          "title": "The brute-force noise",
          "situation": "Auth logs show thousands of SSH password attempts per hour against your public-facing Linux server.",
          "prompt": "What is the strongest mitigation set?",
          "choices": [
            "Key-only authentication (disable PasswordAuthentication), plus fail2ban and no direct root login",
            "Just change the SSH port and call it done",
            "Allow root login for convenience",
            "Use longer passwords and keep password auth"
          ],
          "answer": 0,
          "why": "Keys cannot be guessed, so disabling password auth kills brute force entirely; fail2ban adds rate-limiting, and PermitRootLogin no stops the highest-value target. Changing ports is obscurity \u2014 it reduces log noise, not risk.",
          "hint": "What authentication method cannot be guessed?",
          "objectives": [
            "SSH hardening",
            "Key authentication"
          ],
          "mins": 6
        },
        {
          "id": "infra-lx-cron",
          "title": "The silent cron job",
          "situation": "A backup script runs perfectly by hand but never runs from cron. There are no errors anywhere obvious.",
          "prompt": "What is the most likely cause?",
          "choices": [
            "Cron's minimal environment \u2014 missing PATH or env vars the script relied on from your shell",
            "Cron is broken on this server",
            "The server needs a reboot",
            "Run it manually forever instead"
          ],
          "answer": 0,
          "why": "Cron runs with a sparse environment: no interactive PATH, no aliases, no sourced profiles. Scripts that assume your shell's environment fail silently. Fixes: absolute paths, explicit env vars in the crontab, and logging output to a file.",
          "hint": "What environment does cron NOT give your script?",
          "objectives": [
            "cron",
            "Scheduling"
          ],
          "mins": 5
        },
        {
          "id": "infra-lx-pkg",
          "title": "Installing from the wild",
          "situation": "A blog post says to install a monitoring agent with curl | sudo bash from the author's personal site.",
          "prompt": "What is the safe alternative?",
          "choices": [
            "Install from the official distro repository or the vendor's signed repo via apt/dnf, verifying signatures",
            "Pipe the script \u2014 the blog has many likes",
            "Download a random tarball and compile as root",
            "Disable GPG checking to make installs faster"
          ],
          "answer": 0,
          "why": "curl|bash executes unaudited code as root from whoever controls that server today. Official repositories provide signed, versioned, updatable packages \u2014 the supply-chain-safe path. Convenience is not a security control.",
          "hint": "Who signed that package \u2014 and who controls the download server?",
          "objectives": [
            "Package management",
            "Supply chain"
          ],
          "mins": 5
        }
      ]
    },
    {
      "id": "server-hw",
      "name": "Server Hardware",
      "scenarios": [
        {
          "id": "infra-srv-raid",
          "title": "Four disks, speed plus safety",
          "situation": "A database server has four identical disks. Requirements: good performance AND survive at least one disk failure.",
          "prompt": "Which RAID level is the best fit?",
          "choices": [
            "RAID 10",
            "RAID 0",
            "RAID 5",
            "JBOD"
          ],
          "answer": 0,
          "why": "RAID 10 is a stripe of mirrors: mirroring survives disk failures (and rebuilds fast), striping delivers performance. RAID 0 has no redundancy, and RAID 5's parity rebuilds on large disks are slow and risky \u2014 RAID 10 is the standard answer for performance + redundancy.",
          "hint": "Which level is a stripe of mirrors?",
          "objectives": [
            "RAID levels",
            "Storage design"
          ],
          "mins": 5
        },
        {
          "id": "infra-srv-ecc",
          "title": "The random crashes",
          "situation": "A server crashes randomly with no useful logs \u2014 sometimes kernel panics, sometimes application faults, never the same error twice.",
          "prompt": "What hardware cause should you suspect, and what is server-grade prevention?",
          "choices": [
            "Failing RAM / cosmic-bit flips \u2014 use ECC memory, which detects and corrects single-bit errors, and test the DIMMs",
            "The OS needs reinstalling",
            "The PSU is too big",
            "Ignore it; random crashes are normal"
          ],
          "answer": 0,
          "why": "Inconsistent, unlogged crashes are the classic signature of memory errors. ECC RAM corrects single-bit errors in hardware and logs them \u2014 which is why servers use it and desktops usually do not. Memtest plus DIMM isolation finds the bad stick.",
          "hint": "What flips bits silently with no log entry?",
          "objectives": [
            "ECC memory",
            "Hardware diagnostics"
          ],
          "mins": 6
        },
        {
          "id": "infra-srv-psu",
          "title": "The dead power supply",
          "situation": "Monitoring alerts: one of two redundant PSUs has failed, but the server is still running.",
          "prompt": "What is the correct action?",
          "choices": [
            "Hot-swap the failed PSU now \u2014 that is what redundancy is for \u2014 and verify the redundancy configuration",
            "Power the server down first to be safe",
            "Ignore it since the server is up",
            "Replace both PSUs"
          ],
          "answer": 0,
          "why": "Redundant hot-swappable PSUs exist so a failure is a maintenance event, not an outage \u2014 but redundancy is now gone, so the next failure is fatal. Replace promptly during a planned moment, and confirm the PSUs are on separate circuits.",
          "hint": "What is the second PSU for?",
          "objectives": [
            "Power redundancy",
            "Hot-swap"
          ],
          "mins": 4
        },
        {
          "id": "infra-srv-thermal",
          "title": "The hot aisle",
          "situation": "Temperature sensors show a steady climb in one rack row over two weeks. Servers there are thermal-throttling.",
          "prompt": "What do you check first?",
          "choices": [
            "Airflow and cooling: HVAC function, blanking panels, hot/cold aisle containment, blocked vents",
            "Install more servers in the row",
            "Open all the rack doors permanently",
            "Ignore it until something shuts down"
          ],
          "answer": 0,
          "why": "Heat problems are airflow problems first: missing blanking panels let hot exhaust recirculate into intakes, defeating the HVAC. Hot/cold aisle discipline plus sealed racks keeps cooling effective; adding load or opening doors makes it worse.",
          "hint": "Where does the hot exhaust air go?",
          "objectives": [
            "Data center cooling",
            "Environmental controls"
          ],
          "mins": 5
        },
        {
          "id": "infra-srv-mem",
          "title": "POST reports memory errors",
          "situation": "A server fails to boot, and POST reports memory errors on DIMM B2.",
          "prompt": "What is the correct procedure?",
          "choices": [
            "Reseat the DIMMs, then test one at a time to isolate the faulty stick and replace it",
            "Update the BIOS and hope",
            "Reinstall the OS",
            "Ignore POST errors"
          ],
          "answer": 0,
          "why": "POST memory errors localize the fault to a slot or stick. Reseating fixes contact issues; single-stick testing isolates the failure; replace only the bad DIMM. Firmware updates do not fix bad RAM, and the OS is irrelevant before boot.",
          "hint": "What is the cheapest test you can run first?",
          "objectives": [
            "Memory diagnostics",
            "POST"
          ],
          "mins": 4
        },
        {
          "id": "infra-srv-remote",
          "title": "The hung server 200 miles away",
          "situation": "A branch-office server is completely hung \u2014 no SSH, no services. Driving there takes four hours.",
          "prompt": "What capability resolves this remotely?",
          "choices": [
            "Out-of-band management (BMC / iDRAC / iLO) for console access and power control independent of the OS",
            "Wait for it to fix itself",
            "Ask a non-technical employee to pull the plug",
            "Reinstall the OS remotely"
          ],
          "answer": 0,
          "why": "Baseboard management controllers run independently of the host OS: they give KVM console, power cycle, and hardware sensors even when the OS is dead. It is the standard answer for lights-out remote sites \u2014 no BMC means a truck roll.",
          "hint": "What manages the server when the OS is dead?",
          "objectives": [
            "Out-of-band management",
            "BMC"
          ],
          "mins": 5
        }
      ]
    },
    {
      "id": "virtualization",
      "name": "Virtualization",
      "scenarios": [
        {
          "id": "infra-virt-snapshot",
          "title": "Snapshots are not backups",
          "situation": "An admin proudly reports the VMs are 'backed up' \u2014 they take a snapshot of each VM every night and keep them for a month.",
          "prompt": "What is wrong with this picture?",
          "choices": [
            "Snapshots are not backups: they live on the same storage, grow into performance problems, and die with the datastore",
            "Nothing \u2014 snapshots are a complete backup strategy",
            "They should take more snapshots",
            "They should delete old snapshots to save space and call it done"
          ],
          "answer": 0,
          "why": "A snapshot is a delta file chained to the base disk on the same storage: lose the datastore and you lose base plus snapshots. Long snapshot chains also degrade performance. Real backups are independent, restorable copies \u2014 ideally offsite and tested.",
          "hint": "What happens to the snapshots when the datastore dies?",
          "objectives": [
            "Snapshots vs backups",
            "Data protection"
          ],
          "mins": 5
        },
        {
          "id": "infra-virt-cpu",
          "title": "The sluggish VMs",
          "situation": "VMs on a host are sluggish though the host's CPU graphs look fine. The hypervisor reports high CPU ready time.",
          "prompt": "What is the cause and fix?",
          "choices": [
            "vCPU overprovisioning \u2014 VMs are waiting for physical CPU; right-size vCPUs and check contention",
            "Give every VM more vCPUs",
            "Add more RAM to the host",
            "Reboot the host weekly"
          ],
          "answer": 0,
          "why": "CPU ready time measures how long a VM waits for a physical core: over-allocated vCPUs make scheduling harder, not faster. Adding vCPUs to contended hosts worsens it. Right-sizing plus DRS-style balancing restores performance.",
          "hint": "What does CPU ready time actually measure?",
          "objectives": [
            "Resource contention",
            "vCPU sizing"
          ],
          "mins": 6
        },
        {
          "id": "infra-virt-containers",
          "title": "Fifty microservices",
          "situation": "A team needs to run fifty small microservices that scale up and down frequently. Full VMs feel heavy and slow to start.",
          "prompt": "Why are containers the better fit here?",
          "choices": [
            "Containers share the host kernel, so they start in milliseconds with far less overhead than full VMs",
            "Containers are just faster VMs with their own kernels",
            "One VM per microservice is simpler",
            "Bare metal for each service"
          ],
          "answer": 0,
          "why": "Containers package the app with its dependencies but share the host OS kernel \u2014 no guest OS per instance, no hypervisor boot. That means sub-second starts and dense packing, ideal for elastic microservices. VMs still win where strong isolation or different kernels are needed.",
          "hint": "What do containers share that VMs do not?",
          "objectives": [
            "Containers vs VMs",
            "Workload placement"
          ],
          "mins": 5
        },
        {
          "id": "infra-virt-motion",
          "title": "Patching without downtime",
          "situation": "A hypervisor host needs firmware patches, but its twenty VMs cannot have downtime.",
          "prompt": "What is the correct procedure?",
          "choices": [
            "Live-migrate (vMotion) the running VMs to another host, patch the empty host, then migrate back",
            "Shut everything down for the patch window",
            "Patch the host with VMs running on it",
            "Skip the firmware patches"
          ],
          "answer": 0,
          "why": "Live migration moves running VMs between hosts with no downtime, letting you evacuate a host for maintenance. It requires shared storage and compatible hosts \u2014 the standard enterprise maintenance workflow.",
          "hint": "What moves a running VM without stopping it?",
          "objectives": [
            "Live migration",
            "Maintenance"
          ],
          "mins": 5
        },
        {
          "id": "infra-virt-type",
          "title": "Choosing the hypervisor",
          "situation": "You are designing a new virtualization cluster for production workloads needing near-native performance and strong isolation.",
          "prompt": "Which hypervisor type fits, and why?",
          "choices": [
            "Type 1 (bare-metal) \u2014 runs directly on hardware with minimal overhead and strong isolation",
            "Type 2 (hosted) \u2014 runs on top of a desktop OS",
            "No hypervisor \u2014 containers replace everything",
            "Type 2 for production performance"
          ],
          "answer": 0,
          "why": "Type 1 hypervisors (ESXi, Hyper-V, KVM) sit directly on hardware: lower overhead, better isolation, built for data centers. Type 2 (VirtualBox, Workstation) rides on a host OS \u2014 fine for labs, wrong for production clusters.",
          "hint": "What sits directly on the hardware?",
          "objectives": [
            "Hypervisor types",
            "Architecture"
          ],
          "mins": 4
        },
        {
          "id": "infra-virt-sprawl",
          "title": "The VM graveyard",
          "situation": "The cluster has 300 VMs. Nobody can say who owns forty of them, and half have not been powered on in a year.",
          "prompt": "What is the systematic fix?",
          "choices": [
            "Tagging with ownership, lifecycle policies, and chargeback/showback so orphans get reclaimed",
            "Delete VMs at random",
            "Buy more hosts",
            "Ignore the orphans"
          ],
          "answer": 0,
          "why": "VM sprawl wastes licenses, backup windows, and attack surface. Mandatory tags (owner, purpose, expiry) plus automated reclamation workflows turn sprawl into a managed lifecycle instead of a graveyard.",
          "hint": "Who owns that VM from 2019?",
          "objectives": [
            "VM sprawl",
            "Lifecycle management"
          ],
          "mins": 4
        }
      ]
    },
    {
      "id": "data",
