          "pure virtual interfaces"
        ],
        "followups": [
          "What fits in a base-sized variable?",
          "What is the dynamic type during base construction?"
        ]
      },
      {
        "id": "stl-containers",
        "name": "STL Containers",
        "key_points": [
          "iterator invalidation",
          "map operator[] insertion",
          "erase-remove idiom",
          "custom hash + equality",
          "strict weak ordering",
          "string_view lifetime"
        ],
        "followups": [
          "Where do the elements live after reallocation?",
          "Does that algorithm see the container or just iterators?"
        ]
      },
      {
        "id": "memory-smart-pointers",
        "name": "Memory & Smart Pointers",
        "key_points": [
          "unique_ptr exclusive ownership",
          "shared_ptr cycles and weak_ptr",
          "new[]/delete[] pairing",
          "RAII lock_guard",
          "moved-from state",
          "make_unique exception safety"
        ],
        "followups": [
          "Who owns whom here?",
          "What is guaranteed about a moved-from object?"
        ]
      },
      {
        "id": "templates-lambdas",
        "name": "Templates & Lambdas",
        "key_points": [
          "deduction with reference params",
          "lambda capture lifetime",
          "constexpr evaluation",
          "concepts diagnostics",
          "template header definitions",
          "generic lambdas"
        ],
        "followups": [
          "How long does the captured variable live?",
          "When is the template actually instantiated?"
        ]
      },
      {
        "id": "build-toolchain",
        "name": "Build & Toolchain",
        "key_points": [
          "vtable key function",
          "ODR and inline",
          "target-based CMake",
          "sanitizers in CI",
          "-Werror discipline",
          "static link order"
        ],
        "followups": [
          "Which translation unit emits the vtable?",
          "What does the linker see when it meets the archive?"
        ]
      }
    ]
