  "foundations": [
    {
      "track": "programming-basics",
      "why_needed": "C++ builds on the same core ideas as every language. Learn what programs are and how they execute before tackling objects and memory."
    }
  ],
  "math": [
    "binary"
  ],
  "simulations": [
    {
      "id": "cpp-sim-1",
      "title": "Use after move",
      "kind": "troubleshoot",
      "domain_id": "memory-smart-pointers",
      "difficulty": 3,
      "brief": "A program crashes intermittently after a unique_ptr is passed to a worker function. The pointer looks valid at the call site.",
      "steps": [
        {
          "symptom": "Intermittent crash inside process() \u2014 sometimes fine, sometimes SIGSEGV.",
          "evidence": [
            [
              "app.cpp",
              "auto data = std::make_unique<Buffer>(4096);\nworker(std::move(data));\nif (data) data->fill();   // line 9: sometimes crashes"
            ]
          ],
          "options": [
            "Read the ownership transfer: std::move gives the pointer away, so data is null afterward \u2014 the if (data) check can't save the logic error",
            "Add a null check \u2014 the crash means the check is missing",
            "The heap is corrupted; run with more memory",
            "make_unique is buggy; use new instead"
          ],
          "correct": 0,
          "explain": "std::move transfers ownership: after the move, data is empty by design. The crash site is line 9's assumption that data still owns the buffer."
        },
        {
          "symptom": "Confirmed: data is empty after the move; line 9's use is logically dead.",
          "evidence": [
            [
              "worker.cpp",
              "void worker(std::unique_ptr<Buffer> b) {\n    b->process();\n}  // b destroyed here; the buffer is freed"
            ]
          ],
          "options": [
            "Decide the intended ownership: if the caller still needs the buffer, pass by reference instead of moving",
            "Keep the move and delete line 9",
            "Copy the unique_ptr",
            "Make data a raw pointer"
          ],
          "correct": 0,
          "explain": "unique_ptr can't be copied \u2014 that's the point. If two parties need the buffer, pass a reference (or shared_ptr); if ownership truly transfers, remove the use-after-move."
        },
        {
          "symptom": "Fix chosen: pass by const reference. Verify the fix is complete.",
          "evidence": [
            [
              "app.cpp",
              "auto data = std::make_unique<Buffer>(4096);\nworker(*data);\ndata->fill();"
            ]
          ],
          "options": [
            "Confirm worker takes const Buffer& and no std::move remains at the call site",
            "Confirm the program compiles",
            "Confirm data is still a unique_ptr",
            "Confirm worker is faster now"
          ],
          "correct": 0,
          "explain": "The fix is complete only when the signature borrows (const Buffer&) and the call site no longer moves \u2014 ownership never left the caller."
        }
      ],
      "debrief": "std::move is an ownership transfer, not a copy. After a move the source is empty by contract \u2014 audit every later use, or better, borrow with a reference when ownership shouldn't move.",
      "points": 15
    },
    {
      "id": "cpp-sim-2",
      "title": "From source to executable",
      "kind": "ordering",
      "domain_id": "build-toolchain",
      "difficulty": 1,
      "brief": "Restore the order of a C++ build-and-ship workflow.",
      "steps": {
        "context": "Arrange the workflow steps in execution order.",
        "items": [
          "Compile each translation unit to an object file",
          "Link objects and libraries into the binary",
          "Run the test suite against the binary",
          "Package the binary for release"
        ],
        "correct_order": [
          0,
          1,
          2,
          3
        ]
      },
      "debrief": "Compile \u2192 link \u2192 test \u2192 package. make encodes this as dependencies; the order is the reason incremental builds work.",
      "points": 10
    },
    {
      "id": "cpp-sim-3",
      "title": "The template error novel",
      "kind": "branching",
      "domain_id": "templates-lambdas",
      "difficulty": 2,
      "brief": "A template misuse produced 200 lines of diagnostics. Decide how to read them.",
      "steps": [
        {
          "id": "s1",
          "text": "The error output is 200 lines long, starting deep inside <vector> internals. Where do you look FIRST?",
          "choices": [
            {
              "label": "The FIRST error \u2014 later errors are usually cascades from the first failure",
              "next": "s2",
              "points": 2,
              "feedback": "Correct: template errors cascade. The first diagnostic names the real constraint violation."
            },
            {
              "label": "The LAST error \u2014 it's the summary",
              "next": "END",
              "points": 0,
              "feedback": "The last error is the deepest cascade, farthest from your code.",
              "outcome": "bad"
            },
            {
              "label": "The middle \u2014 it mentions your type name",
              "next": "END",
              "points": 0,
              "feedback": "Tempting, but the middle is still cascade. Start at the top.",
              "outcome": "bad"
            }
          ]
        },
        {
          "id": "s2",
          "text": "The first error says: no matching function for call to 'push_back(int)' \u2014 the vector holds std::string. What's the fix?",
          "choices": [
            {
              "label": "Push a std::string (or convert the int) \u2014 the container's element type is the contract",
              "next": "END",
              "points": 2,
              "feedback": "Right: the template was instantiated correctly; the call site violated its contract.",
              "outcome": "good"
            },
            {
              "label": "Change the vector to vector<int>",
              "next": "END",
              "points": 1,
              "feedback": "Compiles, but it changes the program's meaning to silence the compiler.",
              "outcome": "good"
            },
            {
              "label": "Add a cast at every push_back call site",
              "next": "END",
              "points": 0,
              "feedback": "Casts at every call site hide the type error instead of fixing the contract.",
              "outcome": "bad"
            }
          ]
        }
      ],
      "debrief": "Template diagnostics are novels: read the first error, ignore the cascade, and fix the contract violation at your call site \u2014 not the library's internals.",
      "points": 12
    },
    {
      "id": "cpp-sim-4",
      "title": "The CMakeLists that misfires",
      "kind": "config-check",
      "domain_id": "build-toolchain",
      "difficulty": 2,
      "brief": "A CMakeLists.txt configures but the link step fails. Find the 2 bugs in 10 lines.",
      "steps": {
        "config": "cmake_minimum_required(VERSION 3.28)\nproject(shop)\nadd_library(core core.cpp)\nadd_executable(shop main.cpp)\ntarget_link_libraries(shop PRIVATE coreutils)\nset_target_properties(shop PROPERTIES CXX_STANDARD 17)\ninstall(TARGETS shop DESTINATION bin)\n# build: cmake -S . -B build && cmake --build build\n# test: ctest --test-dir build",
        "find": 2,
        "issues": [
          {
            "line": 5,
            "description": "Links target 'coreutils' but the library defined on line 3 is named 'core' \u2014 undefined target at link time.",
            "fix": "Change coreutils to core."
          },
          {
            "line": 6,
            "description": "CXX_STANDARD 17 is set only on shop; the core library may compile under a different default standard.",
            "fix": "Set the standard on both targets, or use target_compile_features."
          }
        ]
      },
      "debrief": "CMake bugs are name bugs: a linked target must exist exactly as named, and properties must be set on every target they should govern.",
      "points": 10
    }
  ],
  "consoleSims": [
    {
      "id": "cpp-console-1",
      "title": "The missing std:: prefix",
      "console": "code-editor",
      "domain_id": "core-syntax",
      "difficulty": 1,
      "brief": "main.cpp fails because cout is used without std:: or using namespace std. Fix the qualified name in the IDE.",
      "tasks": [
        {
          "id": "t1",
          "instruction": "Open main.cpp in the code editor.",
          "validate": {
            "action": "click",
            "params": {
              "target": "explorer:main.cpp"
            }
          },
          "hint": "Find main.cpp in the file explorer."
        },
        {
          "id": "t2",
          "instruction": "Change cout to std::cout on line 5.",
          "validate": {
            "action": "set-field",
            "params": {
              "field": "editor:main.cpp:line5",
              "value": "    std::cout << \"hi\\n\";"
            }
          },
          "hint": "Qualify the name instead of pulling in the whole namespace."
        },
        {
          "id": "t3",
          "instruction": "Run the build task and confirm it succeeds.",
          "validate": {
            "action": "click",
            "params": {
              "target": "tasks:build"
            }
          },
          "hint": "Use the Run Build Task control."
        }
      ],
      "debrief": "Unqualified names from std are the most common beginner build break. Prefer std:: qualification over using namespace std in headers."
    },
    {
      "id": "cpp-console-2",
      "title": "Watch the vector grow",
      "console": "code-editor",
      "domain_id": "stl-containers",
      "difficulty": 2,
      "brief": "A loop push_backs 10,000 items and you suspect reallocations. Break, watch size/capacity, and run.",
      "tasks": [
        {
          "id": "t1",
          "instruction": "Set a breakpoint inside the push_back loop of bench.cpp.",
          "validate": {
            "action": "click",
            "params": {
              "target": "editor:bench.cpp:line14:breakpoint"
            }
          },
          "hint": "Click in the gutter next to the loop body."
        },
        {
          "id": "t2",
          "instruction": "Add a watch expression for v.capacity().",
          "validate": {
            "action": "set-field",
            "params": {
              "field": "debugger:watch",
              "value": "v.capacity()"
            }
          },
          "hint": "Capacity shows the allocation; size shows the fill."
        },
        {
          "id": "t3",
          "instruction": "Run the debugger and confirm capacity grows geometrically.",
          "validate": {
            "action": "click",
            "params": {
              "target": "debugger:run"
            }
          },
          "hint": "Continue a few times and read the watch."
        }
      ],
      "debrief": "Watching capacity() reveals the geometric growth strategy \u2014 and why reserve() up front avoids the reallocation churn."
    }
  ],
  "terminalMissions": [
    {
      "id": "cpp-mission-1",
      "title": "Compiler roll call",
      "domain_id": "core-syntax",
      "difficulty": 1,
      "brief": "Prove the C++ compiler and the build tool answer.",
      "objectives": [
        "Run g++ --version",
        "Run make --version"
      ],
      "checks": [
        {
          "command_pattern": "^g\\+\\+ --version$",
          "expect_contains": "14.2.1",
          "hint": "Type exactly: g++ --version"
        },
        {
          "command_pattern": "^make --version$",
          "expect_contains": "4.4.1",
          "hint": "Type exactly: make --version"
        }
      ],
      "success_message": "Roll call complete \u2014 compiler and build tool both present."
    },
    {
      "id": "cpp-mission-2",
      "title": "Emit the include",
      "domain_id": "build-toolchain",
      "difficulty": 1,
      "brief": "Emit the header line of every C++ program from the shell.",
      "objectives": [
        "Echo the iostream include line"
      ],
      "checks": [
        {
          "command_pattern": "^echo '#include <iostream>'$",
          "expect_contains": "#include <iostream>",
          "hint": "Type exactly: echo '#include <iostream>'"
        }
      ],
      "success_message": "Include emitted \u2014 iostream is the front door of C++ I/O."
    },
    {
      "id": "cpp-mission-3",
      "title": "Environment recon",
      "domain_id": "memory-smart-pointers",
      "difficulty": 2,
      "brief": "Map the build machine before managing memory on it.",
      "objectives": [
        "Print your username",
        "Print your uid line",
        "Print the working directory"
      ],
      "checks": [
        {
          "command_pattern": "^whoami$",
          "expect_contains": "candidate",
          "hint": "Type exactly: whoami"
        },
        {
          "command_pattern": "^id$",
          "expect_contains": "uid=1000",
          "hint": "Type exactly: id"
        },
        {
          "command_pattern": "^pwd$",
          "expect_contains": "/home/candidate",
          "hint": "Type exactly: pwd"
        }
      ],
      "success_message": "Recon complete \u2014 user, identity, and location confirmed."
    },
    {
      "id": "cpp-mission-4",
      "title": "Emit the entry point",
      "domain_id": "core-syntax",
      "difficulty": 2,
      "brief": "Emit a minimal main() and name the host.",
      "objectives": [
        "Echo a minimal main function",
        "Print the hostname"
      ],
      "checks": [
        {
          "command_pattern": "^echo 'int main\\(\\) \\{ return 0; \\}'$",
          "expect_contains": "return 0",
          "hint": "Type exactly: echo 'int main() { return 0; }'"
        },
        {
          "command_pattern": "^hostname$",
          "expect_contains": "interstitium",
          "hint": "Type exactly: hostname"
        }
      ],
      "success_message": "Entry point emitted \u2014 main() returns 0 on success, by convention."
    },
